+
+#include <linux/bitfield.h>
+#include <linux/bitops.h>
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/interrupt.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/mtd/mtd.h>
+#include <linux/mtd/spi-nor.h>
+#include <linux/of_device.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/scatterlist.h>
+
+#include <linux/spi/spi.h>
+#include <linux/spi/spi-mem.h>
+#include <linux/dmaengine.h>
+#include <linux/dma-mapping.h>
+#include <linux/math64.h>
+#include <linux/bitfield.h>
+
+/* SFC register offsets */
+#define SFC_REG_GLB						0x0000
+#define	SFC_REG_DEV_CONF				0x0004
+#define	SFC_REG_DEV_STA_EXP				0x0008
+#define	SFC_REG_DEV_STA_RT				0x000c
+#define	SFC_REG_DEV_STA_MSK				0x0010
+#define	SFC_REG_TRAN_CONF(n)			0x0014 + n * 4
+#define	SFC_REG_TRAN_CFG0(n)			0x0014 + n * 4
+#define	SFC_REG_TRAN_LEN				0x002c
+#define	SFC_REG_DEV_ADDR(n)				0x0030 + n * 4
+#define	SFC_REG_DEV_ADDR_PLUS(n)		0x0048 + n * 4
+#define	SFC_REG_MEM_ADDR				0x0060
+#define	SFC_REG_TRIG					0x0064
+#define	SFC_REG_SR						0x0068
+#define	SFC_REG_SCR						0x006c
+#define	SFC_REG_INTC					0x0070
+#define	SFC_REG_FSM						0x0074
+#define	SFC_REG_CGE						0x0078
+#define	SFC_REG_CMD_IDX					0x007c
+#define	SFC_REG_COL_ADDR				0x0080
+#define	SFC_REG_ROW_ADDR				0x0084
+#define	SFC_REG_STA_ADDR0				0x0088
+#define	SFC_REG_STA_ADDR1				0x008c
+#define	SFC_REG_DES_ADDR				0x0090
+#define	SFC_REG_GLB1					0x0094
+#define	SFC_REG_DEV1_STA_RT				0x0098
+#define SFC_REG_TRAN_CFG1(n)			0x009c + n * 4
+#define	SFC_REG_DR						0x1000
+
+/* bits within the GLB register */
+#define GLB_TRAN_DIR_MASK				GENMASK(13, 13)
+#define GLB_TRAN_DIR_WRITE				0x1
+#define GLB_TRAN_DIR_READ				0x0
+#define GLB_THRESHOLD_MASK				GENMASK(12, 7)
+#define GLB_OP_MODE_MASK				GENMASK(6, 6)
+#define GLB_OP_MODE_DMA					0x1
+#define GLB_OP_MODE_SLAVE				0x0
+#define GLB_PHASE_NUM_MASK				GENMASK(5, 3)
+#define GLB_WP_EN						BIT(2)
+#define GLB_BURST_MD_MASK				GENMASK(1, 0)
+#define GLB_BURST_MD_INCR32				0x3
+#define GLB_BURST_MD_INCR16				0x2
+#define GLB_BURST_MD_INCR8				0x1
+#define GLB_BURST_MD_INCR4				0x0
+/* Starting DMA transfers of length unaligned with active GLB_BURST_MD_INCR was observed to cause corruption at the tail
+   where the last block wasn't properly transferred. */
+#define INGENIC_SFC_DMA_GRANULE			(4 * 32)
+
+/* bits within the DEV_CONF register */
+#define DEV_CONF_SMP_DELAY_MASK			GENMASK(20, 16)
+#define	DEV_CONF_SMP_DELAY_180DEG		0x4
+#define	DEV_CONF_SMP_DELAY_HALF_CYCLE	0x1
+#define DEV_CONF_CMD_TYPE_MASK			GENMASK(15, 15)
+#define DEV_CONF_CMD_TYPE_16BIT			0x1
+#define DEV_CONF_CMD_TYPE_8BIT			0x0
+#define DEV_CONF_STA_TYPE_MASK			GENMASK(14, 13)
+#define DEV_CONF_THOLD_MASK				GENMASK(12, 11)
+#define DEV_CONF_THOLD_OFFSET			(11)
+#define DEV_CONF_TSETUP_MASK			GENMASK(10, 9)
+#define DEV_CONF_TSETUP_OFFSET			(9)
+#define DEV_CONF_TSH_MASK				GENMASK(8, 5)
+#define DEV_CONF_TSH_OFFSET				(5)
+#define DEV_CONF_CPHA					BIT(4)
+#define DEV_CONF_CPOL					BIT(3)
+#define DEV_CONF_CE_DL					BIT(2)
+#define DEV_CONF_HOLD_DL				BIT(1)
+#define DEV_CONF_WP_DL					BIT(0)
+
+/* bits within the TRAN_CONF(n) register */
+#define TRAN_CONF_TRAN_MODE_MASK		GENMASK(31, 29)
+#define	TRAN_CONF_ADDR_WIDTH_MASK		GENMASK(28, 26)
+#define TRAN_CONF_POLL_EN				BIT(25)
+#define TRAN_CONF_CMD_EN				BIT(24)
+#define TRAN_CONF_PHASE_FORMAT_MASK		GENMASK(23, 23)
+#define TRAN_CONF_DMY_BITS_MASK			GENMASK(22, 17)
+#define TRAN_CONF_DATA_EN				BIT(16)
+#define TRAN_CONF_CMD_MASK				GENMASK(15, 0)
+
+/* bits within the TRIG register */
+#define TRIG_FLUSH						BIT(2)
+#define TRIG_STOP						BIT(1)
+#define TRIG_START						BIT(0)
+
+/* bits within the SR register */
+#define SR_FIFO_NUM_MASK				GENMASK(22, 16)
+#define	SR_END							BIT(4)
+#define SR_TRAN_REQ						BIT(3)
+#define SR_RECE_REQ						BIT(2)
+#define SR_OVER							BIT(1)
+#define SR_UNDER						BIT(0)
+
+/* bits within the SCR register */
+#define	SCR_CLR_END						BIT(4)
+#define SCR_CLR_TREQ					BIT(3)
+#define SCR_CLR_RREQ					BIT(2)
+#define SCR_CLR_OVER					BIT(1)
+#define SCR_CLR_UNDER					BIT(0)
+#define SCR_CLEAR_ALL					(SCR_CLR_END | SCR_CLR_TREQ | \
+						 SCR_CLR_RREQ | SCR_CLR_OVER | \
+						 SCR_CLR_UNDER)
+
+/* bits within the INTC register */
+#define	INTC_MASK_END					BIT(4)
+#define INTC_MASK_TREQ					BIT(3)
+#define INTC_MASK_RREQ					BIT(2)
+#define INTC_MASK_OVER					BIT(1)
+#define INTC_MASK_UNDER					BIT(0)
+#define INTC_MASK_ALL					(INTC_MASK_END | INTC_MASK_TREQ | \
+						 INTC_MASK_RREQ | INTC_MASK_OVER | \
+						 INTC_MASK_UNDER)
+
+/* bits within the TRAN_CFG1(n) register */
+#define TRAN_CFG1_TRAN_MODE_MASK		GENMASK(7, 4)
+
+/* bits within the CMD_IDX register */
+#define CMD_IDX_INDEX_MASK				GENMASK(5, 0)
+#define CMD_IDX_DIR						BIT(30)
+#define CMD_IDX_DATA_EN					BIT(31)
+
+#define TRAN_MODE_STANDARD				0
+#define TRAN_MODE_DUAL_DATA				1
+#define TRAN_MODE_DUAL_IO				2
+#define TRAN_MODE_DUAL_FULL				3
+#define TRAN_MODE_QUAD_DATA				5
+#define TRAN_MODE_QUAD_IO				6
+#define TRAN_MODE_QUAD_FULL				7
+#define TRAN_MODE_OCTAL_DATA			9
+#define TRAN_MODE_OCTAL_IO				10
+#define TRAN_MODE_OCTAL_FULL			11
+
+#define SFC_TRANSFER_TIMEOUT			1000
+
+struct ingenic_soc_info {
+	const unsigned int max_bus_width;
+	const unsigned int max_fifo_words;
+	const unsigned int dma_threshold_bytes;
+
+	const int sfc_revision;
+};
+
+struct ingenic_sfc {
+	const struct ingenic_soc_info *soc_info;
+
+	void __iomem *base;
+	struct device *dev;
+	struct clk *clk;
+	int irq;
+
+	struct completion completion;
+	int cs;
+	int last_error;
+	bool active;
+	const u8 *tx_buf;
+	unsigned int tx_len;
+	unsigned int tx_pos;
+	u8 *rx_buf;
+	unsigned int rx_len;
+	unsigned int rx_pos;
+};
+
+static void ingenic_sfc_hw_init(struct ingenic_sfc *sfc);
+static void ingenic_sfc_read_rxfifo(struct ingenic_sfc *sfc, u8 *to,
+				    unsigned int len);
+static void ingenic_sfc_write_txfifo(struct ingenic_sfc *sfc, const u8 *from,
+				     unsigned int len);
+
+static void ingenic_sfc_dump_regs(struct ingenic_sfc *sfc)
+{
+	int i;
+
+	dev_err(sfc->dev, "SFC_GLB          = %08x\n", readl(sfc->base + SFC_REG_GLB));
+	dev_err(sfc->dev, "SFC_DEV_CONF     = %08x\n", readl(sfc->base + SFC_REG_DEV_CONF));
+	dev_err(sfc->dev, "SFC_DEV_STA_EXP  = %08x\n", readl(sfc->base + SFC_REG_DEV_STA_EXP));
+	dev_err(sfc->dev, "SFC_DEV_STA_RT   = %08x\n", readl(sfc->base + SFC_REG_DEV_STA_RT));
+	dev_err(sfc->dev, "SFC_DEV_STA_MSK  = %08x\n", readl(sfc->base + SFC_REG_DEV_STA_MSK));
+	for (i = 0; i < 6; i++)
+		dev_err(sfc->dev, "SFC_TRAN_CONF(%d) = %08x\n", i,
+			readl(sfc->base + SFC_REG_TRAN_CONF(i)));
+	dev_err(sfc->dev, "SFC_TRAN_LEN     = %08x\n", readl(sfc->base + SFC_REG_TRAN_LEN));
+	for (i = 0; i < 6; i++) {
+		dev_err(sfc->dev, "SFC_DEV_ADDR(%d)  = %08x\n", i,
+			readl(sfc->base + SFC_REG_DEV_ADDR(i)));
+		dev_err(sfc->dev, "SFC_DEV_ADDR_PLUS(%d) = %08x\n", i,
+			readl(sfc->base + SFC_REG_DEV_ADDR_PLUS(i)));
+	}
+	dev_err(sfc->dev, "SFC_MEM_ADDR     = %08x\n", readl(sfc->base + SFC_REG_MEM_ADDR));
+	dev_err(sfc->dev, "SFC_TRIG         = %08x\n", readl(sfc->base + SFC_REG_TRIG));
+	dev_err(sfc->dev, "SFC_SR           = %08x\n", readl(sfc->base + SFC_REG_SR));
+	dev_err(sfc->dev, "SFC_SCR          = %08x\n", readl(sfc->base + SFC_REG_SCR));
+	dev_err(sfc->dev, "SFC_INTC         = %08x\n", readl(sfc->base + SFC_REG_INTC));
+	dev_err(sfc->dev, "SFC_FSM          = %08x\n", readl(sfc->base + SFC_REG_FSM));
+	dev_err(sfc->dev, "SFC_CGE          = %08x\n", readl(sfc->base + SFC_REG_CGE));
+	dev_err(sfc->dev, "SFC_CMD_IDX      = %08x\n", readl(sfc->base + SFC_REG_CMD_IDX));
+	dev_err(sfc->dev, "SFC_COL_ADDR     = %08x\n", readl(sfc->base + SFC_REG_COL_ADDR));
+	dev_err(sfc->dev, "SFC_ROW_ADDR     = %08x\n", readl(sfc->base + SFC_REG_ROW_ADDR));
+	dev_err(sfc->dev, "SFC_STA_ADDR0    = %08x\n", readl(sfc->base + SFC_REG_STA_ADDR0));
+	dev_err(sfc->dev, "SFC_STA_ADDR1    = %08x\n", readl(sfc->base + SFC_REG_STA_ADDR1));
+	dev_err(sfc->dev, "SFC_DES_ADDR     = %08x\n", readl(sfc->base + SFC_REG_DES_ADDR));
+	dev_err(sfc->dev, "SFC_GLB1         = %08x\n", readl(sfc->base + SFC_REG_GLB1));
+	dev_err(sfc->dev, "SFC_DEV1_STA_RT  = %08x\n", readl(sfc->base + SFC_REG_DEV1_STA_RT));
+	for (i = 0; i < 6; i++)
+		dev_err(sfc->dev, "SFC_TRAN_CFG1(%d) = %08x\n", i,
+			readl(sfc->base + SFC_REG_TRAN_CFG1(i)));
+}
+
+static void ingenic_sfc_mask_and_clear(struct ingenic_sfc *sfc)
+{
+	writel(INTC_MASK_ALL, sfc->base + SFC_REG_INTC);
+	readl(sfc->base + SFC_REG_INTC);
+	writel(SCR_CLEAR_ALL, sfc->base + SFC_REG_SCR);
+	readl(sfc->base + SFC_REG_SCR);
+	readl(sfc->base + SFC_REG_SR);
+}
+
+static irqreturn_t ingenic_sfc_irq_handler(int irq, void *data)
+{
+	struct ingenic_sfc *sfc = data;
+	u32 intc;
+	u32 sr;
+	u32 sr_full;
+	bool handled = false;
+	bool terminal = false;
+
+	sr_full = readl(sfc->base + SFC_REG_SR);
+	sr = sr_full &
+		(SR_END | SR_TRAN_REQ | SR_RECE_REQ | SR_OVER | SR_UNDER);
+
+	if (!sr) {
+		dev_warn(sfc->dev, "??? IRQ_NONE");
+		ingenic_sfc_dump_regs(sfc);
+		return IRQ_NONE;
+	}
+	
+	if (!READ_ONCE(sfc->active)) {
+		writel(sr, sfc->base + SFC_REG_SCR);
+		readl(sfc->base + SFC_REG_SCR);
+		readl(sfc->base + SFC_REG_SR);
+		return IRQ_HANDLED;
+	}
+
+	if (sr & (SR_OVER | SR_UNDER)) {
+		WRITE_ONCE(sfc->last_error, -EIO);
+		terminal = true;
+	} else if (sr & SR_TRAN_REQ) {
+		unsigned int tx_len = 0;
+
+		if (sfc->tx_buf && sfc->tx_pos < sfc->tx_len) {
+			unsigned int remaining = sfc->tx_len - sfc->tx_pos;
+			unsigned int tx_words = sfc->soc_info->max_fifo_words - 1;
+
+			tx_len = min(remaining, tx_words * 4);
+			ingenic_sfc_write_txfifo(sfc, sfc->tx_buf + sfc->tx_pos,
+						 tx_len);
+			sfc->tx_pos += tx_len;
+		}
+
+		if (sfc->tx_pos == sfc->tx_len) {
+			intc = readl(sfc->base + SFC_REG_INTC);
+			intc |= INTC_MASK_TREQ;
+			writel(intc, sfc->base + SFC_REG_INTC);
+		}
+		handled = true;
+	}
+
+	if (!terminal && (sr & SR_RECE_REQ)) {
+		unsigned int rx_len = 0;
+
+		if (sfc->rx_buf && sfc->rx_pos < sfc->rx_len) {
+			unsigned int remaining = sfc->rx_len - sfc->rx_pos;
+			unsigned int fifo_words = FIELD_GET(SR_FIFO_NUM_MASK, sr_full);
+
+			rx_len = min(remaining, fifo_words * 4);
+			if (rx_len) {
+				ingenic_sfc_read_rxfifo(sfc,
+							sfc->rx_buf + sfc->rx_pos,
+							rx_len);
+				sfc->rx_pos += rx_len;
+			}
+		}
+
+		if (sfc->rx_pos == sfc->rx_len) {
+			intc = readl(sfc->base + SFC_REG_INTC);
+			intc |= INTC_MASK_RREQ;
+			writel(intc, sfc->base + SFC_REG_INTC);
+		}
+		handled = true;
+	}
+
+	if (!terminal && (sr & SR_END)) {
+		if (sfc->rx_buf && sfc->rx_pos < sfc->rx_len) {
+			unsigned int remaining = sfc->rx_len - sfc->rx_pos;
+
+			ingenic_sfc_read_rxfifo(sfc, sfc->rx_buf + sfc->rx_pos,
+						remaining);
+			sfc->rx_pos = sfc->rx_len;
+		}
+
+		WRITE_ONCE(sfc->last_error, 0);
+		terminal = true;
+		handled = true;
+	}
+
+	if (terminal) {
+		/* Mask all sources until the next transfer reprograms INTC. */
+		writel(INTC_MASK_ALL, sfc->base + SFC_REG_INTC);
+		readl(sfc->base + SFC_REG_INTC);
+	}
+
+	/* Clear request/status bits only after servicing the FIFO. */
+	writel(sr, sfc->base + SFC_REG_SCR);
+	readl(sfc->base + SFC_REG_SCR);
+	readl(sfc->base + SFC_REG_SR);
+
+	if (terminal) {
+		WRITE_ONCE(sfc->active, false);
+		complete(&sfc->completion);
+	}
+
+	if (!terminal && !handled) {
+		dev_warn(sfc->dev, "??? IRQ not terminal");
+		ingenic_sfc_dump_regs(sfc);
+
+	}
+	return IRQ_HANDLED;
+}
+
+static int ingenic_sfc_dma_eligible(struct ingenic_sfc *sfc,
+				    const struct spi_mem_op *op)
+{
+	const unsigned int dma_align = 4;
+	const void *buf;
+
+	if (op->data.dir == SPI_MEM_NO_DATA)
+		return 0;
+
+	/* Page-program payloads are small enough for PIO and DATA_OUT DMA is timing-sensitive on this controller. */
+	/*if (op->data.dir == SPI_MEM_DATA_OUT)
+		return 0;*/
+
+	if (!op->data.nbytes || !IS_ALIGNED(op->data.nbytes, INGENIC_SFC_DMA_GRANULE))
+		return 0;
+
+	if (sfc->soc_info->sfc_revision < 2 && !IS_ALIGNED(op->data.nbytes, dma_align))
+		return 0;
+
+	buf = op->data.dir == SPI_MEM_DATA_IN ? (const void *)op->data.buf.in
+					      : (const void *)op->data.buf.out;
+	if (!buf)
+		return 0;
+
+	/* PIO has less overhead on very short payloads. */
+	return op->data.nbytes > sfc->soc_info->dma_threshold_bytes;
+}
+
+static int ingenic_sfc_pio_eligible(struct ingenic_sfc *sfc,
+				    const struct spi_mem_op *op)
+{
+	const void *buf;
+
+	if (op->data.dir == SPI_MEM_NO_DATA)
+		return 1;
+
+	buf = op->data.dir == SPI_MEM_DATA_IN ? (const void *)op->data.buf.in
+					      : (const void *)op->data.buf.out;
+	if (!buf)
+		return 0;
+
+	return 1;
+}
+
+static int ingenic_sfc_adjust_op_size(struct spi_mem *mem, struct spi_mem_op *op)
+{
+	return 0;
+}
+
+static bool ingenic_sfc_supports_op(struct spi_mem *mem, const struct spi_mem_op *op)
+{
+	struct spi_device *spi = mem->spi;
+	struct ingenic_sfc *sfc = spi_controller_get_devdata(spi->controller);
+
+	/* The controller only supports Standard SPI mode, Duall mode and Quad mode. */
+	if (op->cmd.buswidth > sfc->soc_info->max_bus_width ||
+		op->addr.buswidth > sfc->soc_info->max_bus_width ||
+		op->dummy.buswidth > sfc->soc_info->max_bus_width ||
+		op->data.buswidth > sfc->soc_info->max_bus_width) {
+		return false;
+}
+
+	/* Max 32 dummy clock cycles supported */
+	if (op->dummy.nbytes && (op->dummy.nbytes * 8 / op->dummy.buswidth > 32)){
+		return false;
+	}
+
+	/* Max 6 bytes address width supported */
+	if (op->addr.nbytes > 6) {
+		return false;
+	}
+
+	return spi_mem_default_supports_op(mem, op);
+}
+
+static void ingenic_sfc_set_transfer_mode(struct ingenic_sfc *sfc, const struct spi_mem_op *op)
+{
+	u32 val, mode = TRAN_MODE_STANDARD;
+	u32 reg = sfc->soc_info->sfc_revision >= 2 ? SFC_REG_TRAN_CFG1(0) :
+						   SFC_REG_TRAN_CONF(0);
+	u32 mode_mask = sfc->soc_info->sfc_revision >= 2 ? TRAN_CFG1_TRAN_MODE_MASK :
+							 TRAN_CONF_TRAN_MODE_MASK;
+	u32 mode_shift = __ffs(mode_mask);
+
+	if (op->cmd.buswidth == 8)
+		mode = TRAN_MODE_OCTAL_FULL;
+	else if (op->cmd.buswidth == 4)
+		mode = TRAN_MODE_QUAD_FULL;
+	else if (op->cmd.buswidth == 2)
+		mode = TRAN_MODE_DUAL_FULL;
+	else if (op->addr.buswidth == 8)
+		mode = TRAN_MODE_OCTAL_IO;
+	else if (op->addr.buswidth == 4)
+		mode = TRAN_MODE_QUAD_IO;
+	else if (op->addr.buswidth == 2)
+		mode = TRAN_MODE_DUAL_IO;
+	else if (op->data.buswidth == 8)
+		mode = TRAN_MODE_OCTAL_DATA;
+	else if (op->data.buswidth == 4)
+		mode = TRAN_MODE_QUAD_DATA;
+	else if (op->data.buswidth == 2)
+		mode = TRAN_MODE_DUAL_DATA;
+
+	val = readl(sfc->base + reg);
+	val &= ~mode_mask;
+	val |= (mode << mode_shift) & mode_mask;
+	writel(val, sfc->base + reg);
+
+	#if 0
+	if (op->cmd.buswidth == 1 && op->addr.buswidth == 1 && op->data.buswidth == 1) {
+		dev_warn(sfc->dev, "SFC slow OP 1-1-1 (QSPI disabled?)");
+	}
+
+	dev_dbg(sfc->dev, "SFC OP widths %d-%d-%d", op->cmd.buswidth, op->addr.buswidth, op->data.buswidth);
+	#endif
+}
+
+static void ingenic_sfc_prepare_op(struct ingenic_sfc *sfc,
+				   const struct spi_mem_op *op,
+				   u32 conf_extra)
+{
+	u32 val = conf_extra | TRAN_CONF_CMD_EN | op->cmd.opcode;
+
+	if (op->addr.nbytes > 0) {
+		val |= FIELD_PREP(TRAN_CONF_ADDR_WIDTH_MASK, op->addr.nbytes);
+		writel(op->addr.val & 0xffffffff, sfc->base + SFC_REG_DEV_ADDR(0));
+		writel(op->addr.val >> 32, sfc->base + SFC_REG_DEV_ADDR_PLUS(0));
+	} else {
+		writel(0, sfc->base + SFC_REG_DEV_ADDR(0));
+		writel(0, sfc->base + SFC_REG_DEV_ADDR_PLUS(0));
+	}
+
+	if (op->dummy.nbytes > 0)
+		val |= FIELD_PREP(TRAN_CONF_DMY_BITS_MASK, op->dummy.nbytes * 8 / op->dummy.buswidth);
+
+	if (op->data.nbytes > 0)
+		val |= TRAN_CONF_DATA_EN;
+
+	writel(val, sfc->base + SFC_REG_TRAN_CONF(0));
+	writel(op->data.nbytes, sfc->base + SFC_REG_TRAN_LEN);
+
+	ingenic_sfc_set_transfer_mode(sfc, op);
+}
+
+/*
+ * memcpy_{to,from}io doesn't gurantee 32b accesses - which we require for the
+ * SFC_REG_DR register -so use __io{read,write}32_copy when possible. For
+ * trailing bytes, copy them byte-by-byte from the SFC_REG_DR register, as we
+ * can't clobber outside the source/dest buffer.
+ *
+ * For efficient data read/write, we try to put any start 32b unaligned data
+ * into a separate transaction in ingenic_sfc_adjust_op_size().
+ */
+static void ingenic_sfc_read_rxfifo(struct ingenic_sfc *sfc, u8 *to, unsigned int len)
+{
+	void __iomem *from;
+	int i;
+
+	from = sfc->base + SFC_REG_DR;
+
+	for (i = 0; i < DIV_ROUND_UP(len, 4); i++) {
+		u32 val = __raw_readl(from);
+		int j;
+
+		for (j = 0; j < 4 && (j + (i * 4) < len); to++, val >>= 8, j++)
+			*to = (u8)val;
+	}
+}
+
+static void ingenic_sfc_write_txfifo(struct ingenic_sfc *sfc, const u8 *from, unsigned int len)
+{
+	void __iomem *to;
+	int i;
+
+	to = sfc->base + SFC_REG_DR;
+
+	for (i = 0; i < DIV_ROUND_UP(len, 4); i++) {
+		u32 val = 0;
+		int j;
+
+		for (j = 0; j < 4 && (j + (i * 4) < len); from++, j++)
+			val |= *from << j * 8;
+		__raw_writel(val, to);
+	}
+}
+
+static int ingenic_sfc_exec_op_pio(struct ingenic_sfc *sfc, const struct spi_mem_op *op)
+{
+	int ret, val;
+	u32 intc;
+
+	if (!ingenic_sfc_pio_eligible(sfc, op))
+		return -EOPNOTSUPP;
+
+	#if 0
+	dev_warn(sfc->dev, "SFC: fallback to PIO for current OP (slow; normal during JEDEC probe)");
+	#endif
+
+	val = readl(sfc->base + SFC_REG_GLB);
+	u32p_replace_bits(&val, op->data.dir == SPI_MEM_DATA_IN ?
+			GLB_TRAN_DIR_READ : GLB_TRAN_DIR_WRITE, GLB_TRAN_DIR_MASK);
+	u32p_replace_bits(&val, GLB_OP_MODE_SLAVE, GLB_OP_MODE_MASK);
+	writel(val, sfc->base + SFC_REG_GLB);
+
+	ingenic_sfc_prepare_op(sfc, op, 0);
+
+	WRITE_ONCE(sfc->last_error, 0);
+	sfc->tx_buf = NULL;
+	sfc->tx_len = 0;
+	sfc->tx_pos = 0;
+	sfc->rx_buf = NULL;
+	sfc->rx_len = 0;
+	sfc->rx_pos = 0;
+	if (op->data.dir == SPI_MEM_DATA_OUT) {
+		sfc->tx_buf = op->data.buf.out;
+		sfc->tx_len = op->data.nbytes;
+	} else if (op->data.dir == SPI_MEM_DATA_IN) {
+		sfc->rx_buf = op->data.buf.in;
+		sfc->rx_len = op->data.nbytes;
+	}
+
+	ingenic_sfc_mask_and_clear(sfc);
+	reinit_completion(&sfc->completion);
+	intc = INTC_MASK_ALL & ~(INTC_MASK_END | INTC_MASK_OVER | INTC_MASK_UNDER);
+	if (op->data.dir == SPI_MEM_DATA_IN)
+		intc &= ~INTC_MASK_RREQ;
+	else if (op->data.dir == SPI_MEM_DATA_OUT)
+		intc &= ~INTC_MASK_TREQ;
+
+	writel(0, sfc->base + SFC_REG_MEM_ADDR);
+
+	writel(TRIG_FLUSH, sfc->base + SFC_REG_TRIG);
+	writel(TRIG_START, sfc->base + SFC_REG_TRIG);
+	readl(sfc->base + SFC_REG_TRIG);
+	WRITE_ONCE(sfc->active, true);
+	writel(intc, sfc->base + SFC_REG_INTC);
+	readl(sfc->base + SFC_REG_INTC);
+
+	if (!wait_for_completion_timeout(&sfc->completion, msecs_to_jiffies(SFC_TRANSFER_TIMEOUT))) {
+		ingenic_sfc_dump_regs(sfc);
+		dev_err(sfc->dev, "line:%d Timeout for ACK from SFC device\n", __LINE__);
+		ret = -ETIMEDOUT;
+		goto out;
+	}
+
+	ret = READ_ONCE(sfc->last_error);
+	if (ret)
+		goto out;
+
+	ret = 0;
+
+out:
+	sfc->tx_buf = NULL;
+	sfc->tx_len = 0;
+	sfc->tx_pos = 0;
+	sfc->rx_buf = NULL;
+	sfc->rx_len = 0;
+	sfc->rx_pos = 0;
+	WRITE_ONCE(sfc->active, false);
+	ingenic_sfc_mask_and_clear(sfc);
+	writel(TRIG_STOP, sfc->base + SFC_REG_TRIG);
+	readl(sfc->base + SFC_REG_TRIG);
+	return ret;
+}
+
+static int ingenic_sfc_exec_op_dma_segment(struct ingenic_sfc *sfc,
+					  const struct spi_mem_op *op,
+					  dma_addr_t dma_addr)
+{
+	int ret, val;
+
+	val = readl(sfc->base + SFC_REG_GLB);
+	u32p_replace_bits(&val,
+			op->data.dir == SPI_MEM_DATA_IN ? GLB_TRAN_DIR_READ : GLB_TRAN_DIR_WRITE,
+			GLB_TRAN_DIR_MASK);
+	u32p_replace_bits(&val, GLB_OP_MODE_DMA, GLB_OP_MODE_MASK);
+	writel(val, sfc->base + SFC_REG_GLB);
+
+	ingenic_sfc_prepare_op(sfc, op, 0);
+
+	WRITE_ONCE(sfc->last_error, 0);
+	ingenic_sfc_mask_and_clear(sfc);
+	reinit_completion(&sfc->completion);
+
+	writel(dma_addr, sfc->base + SFC_REG_MEM_ADDR);
+	writel(TRIG_FLUSH, sfc->base + SFC_REG_TRIG);
+	writel(TRIG_START, sfc->base + SFC_REG_TRIG);
+	readl(sfc->base + SFC_REG_TRIG);
+	WRITE_ONCE(sfc->active, true);
+	writel(INTC_MASK_ALL & ~(INTC_MASK_END | INTC_MASK_OVER | INTC_MASK_UNDER),
+	       sfc->base + SFC_REG_INTC);
+	readl(sfc->base + SFC_REG_INTC);
+
+	if (!wait_for_completion_timeout(&sfc->completion, msecs_to_jiffies(SFC_TRANSFER_TIMEOUT))) {
+		dev_err(sfc->dev, "line:%d Timeout for ACK from SFC device\n", __LINE__);
+		ingenic_sfc_dump_regs(sfc);
+		ret = -ETIMEDOUT;
+		goto out;
+	}
+
+	ret = READ_ONCE(sfc->last_error);
+
+out:
+	WRITE_ONCE(sfc->active, false);
+	ingenic_sfc_mask_and_clear(sfc);
+	writel(TRIG_STOP, sfc->base + SFC_REG_TRIG);
+	readl(sfc->base + SFC_REG_TRIG);
+	return ret;
+}
+
+static int ingenic_sfc_exec_op_dma(struct spi_mem *mem, struct ingenic_sfc *sfc,
+				   const struct spi_mem_op *op)
+{
+	struct spi_mem_op seg_op = *op;
+	struct sg_table sgt;
+	struct scatterlist *sg;
+	size_t data_off = 0;
+	int i, ret;
+
+	if (!ingenic_sfc_dma_eligible(sfc, op))
+		return -EAGAIN;
+
+	ret = spi_controller_dma_map_mem_op_data(mem->spi->controller, op, &sgt);
+	if (ret)
+		return -EAGAIN;
+
+	/*
+	 * A write operation cannot be split into multiple page-program commands:
+	 * the NOR write-enable latch is cleared after the first program command.
+	 */
+	if (op->data.dir == SPI_MEM_DATA_OUT && sgt.nents != 1) {
+		ret = -EAGAIN;
+		goto out_unmap;
+	}
+
+	if (!op->addr.nbytes && sgt.nents != 1) {
+		ret = -EAGAIN;
+		goto out_unmap;
+	}
+
+	for_each_sg(sgt.sgl, sg, sgt.nents, i) {
+		if (!IS_ALIGNED(sg_dma_len(sg), INGENIC_SFC_DMA_GRANULE)) {
+			ret = -EAGAIN;
+			goto out_unmap;
+		}
+	}
+
+	for_each_sg(sgt.sgl, sg, sgt.nents, i) {
+		seg_op.data.nbytes = sg_dma_len(sg);
+		if (op->addr.nbytes)
+			seg_op.addr.val = op->addr.val + data_off;
+
+		ret = ingenic_sfc_exec_op_dma_segment(sfc, &seg_op,
+						      sg_dma_address(sg));
+		if (ret)
+			goto out_unmap;
+
+		data_off += seg_op.data.nbytes;
+	}
+
+	ret = 0;
+
+out_unmap:
+	spi_controller_dma_unmap_mem_op_data(mem->spi->controller, op, &sgt);
+	return ret;
+}
+
+static int ingenic_sfc_exec_op(struct spi_mem *mem, const struct spi_mem_op *op)
+{
+	struct spi_device *spi = mem->spi;
+	struct ingenic_sfc *sfc = spi_controller_get_devdata(spi->controller);
+	const char *dir = "none";
+	int ret;
+
+	ret = clk_prepare_enable(sfc->clk);
+	if (ret)
+		return ret;
+
+	/* TODO: CS1 is unsupported; it's not implemented by any of the reference drivers either */
+	/* except for leaving a very small hint that CS0/CS1 can be controlled using SFC_GLB1 */
+	sfc->cs = spi_get_chipselect(spi, 0);
+
+	if (op->data.dir == SPI_MEM_DATA_IN)
+		dir = "in";
+	else if (op->data.dir == SPI_MEM_DATA_OUT)
+		dir = "out";
+
+	#if 0
+	dev_warn(sfc->dev,
+		 "NOR op: cs=%d cmd=0x%02x addr_n=%u addr=0x%llx dmy=%u len=%u dir=%s bw=%u-%u-%u\n",
+		 sfc->cs, op->cmd.opcode, op->addr.nbytes, op->addr.val,
+		 op->dummy.nbytes, op->data.nbytes, dir,
+		 op->cmd.buswidth, op->addr.buswidth, op->data.buswidth);
+	#endif
+
+	if (ingenic_sfc_dma_eligible(sfc, op)) {
+		ret = ingenic_sfc_exec_op_dma(mem, sfc, op);
+		if (ret != -EAGAIN)
+			goto out_disable_clk;
+	}
+
+	ret = ingenic_sfc_exec_op_pio(sfc, op);
+
+out_disable_clk:
+	synchronize_irq(sfc->irq);
+	clk_disable_unprepare(sfc->clk);
+	return ret;
+}
+
+static int ingenic_sfc_poll_status(struct spi_mem *mem, const struct spi_mem_op *op,
+			u16 mask, u16 match, unsigned long initial_delay_us,
+			unsigned long polling_delay_us, unsigned long timeout_ms)
+{
+	struct spi_device *spi = mem->spi;
+	struct ingenic_sfc *sfc = spi_controller_get_devdata(spi->controller);
+	int ret, val;
+
+	val = readl(sfc->base + SFC_REG_GLB);
+	u32p_replace_bits(&val, GLB_TRAN_DIR_READ, GLB_TRAN_DIR_MASK);
+	u32p_replace_bits(&val, GLB_OP_MODE_SLAVE, GLB_OP_MODE_MASK);
+	writel(val, sfc->base + SFC_REG_GLB);
+
+	writel(match, sfc->base + SFC_REG_DEV_STA_EXP);
+	writel(mask, sfc->base + SFC_REG_DEV_STA_MSK);
+
+	ingenic_sfc_prepare_op(sfc, op, TRAN_CONF_POLL_EN);
+
+	WRITE_ONCE(sfc->last_error, 0);
+	ingenic_sfc_mask_and_clear(sfc);
+	reinit_completion(&sfc->completion);
+
+	writel(0, sfc->base + SFC_REG_MEM_ADDR);
+
+	writel(TRIG_START, sfc->base + SFC_REG_TRIG);
+	readl(sfc->base + SFC_REG_TRIG);
+	WRITE_ONCE(sfc->active, true);
+	writel(INTC_MASK_ALL & ~(INTC_MASK_END),
+	       sfc->base + SFC_REG_INTC);
+	readl(sfc->base + SFC_REG_INTC);
+
+	if (!wait_for_completion_timeout(&sfc->completion, msecs_to_jiffies(SFC_TRANSFER_TIMEOUT))) {
+		ingenic_sfc_dump_regs(sfc);
+		dev_err(sfc->dev, "line:%d Timeout for ACK from SFC device\n", __LINE__);
+		ret = -ETIMEDOUT;
+		goto out;
+	}
+
+	ret = READ_ONCE(sfc->last_error);
+out:
+	WRITE_ONCE(sfc->active, false);
+	ingenic_sfc_mask_and_clear(sfc);
+	writel(TRIG_STOP, sfc->base + SFC_REG_TRIG);
+	readl(sfc->base + SFC_REG_TRIG);
+	return ret;
+}
+
+static const struct spi_controller_mem_ops ingenic_sfc_mem_ops = {
+	.adjust_op_size = ingenic_sfc_adjust_op_size,
+	.supports_op = ingenic_sfc_supports_op,
+	.exec_op = ingenic_sfc_exec_op,
+	// .poll_status = ingenic_sfc_poll_status,
+};
+
+static int ingenic_sfc_ns_to_devconf(unsigned long sfc_clk_hz, unsigned int ns)
+{
+	u64 cycle_ns;
+	u64 cycles;
+	u64 half_cycle_ns;
+	u32 rem_ns;
+
+	//sfc_clk_hz /= 4;
+
+	cycle_ns = div_u64(1000000000ULL, sfc_clk_hz);
+	half_cycle_ns = cycle_ns / 2;
+
+	cycles = div_u64_rem((u64)ns, cycle_ns, &rem_ns);
+	if (rem_ns > half_cycle_ns) {
+		rem_ns = 0;
+		cycles++;
+	}
+
+	if (!cycles && !rem_ns)
+		return 0;
+
+	return (2 * cycles) - 1 + !!rem_ns;
+}
+
+static void ingenic_sfc_hw_init(struct ingenic_sfc *sfc)
+{
+	#if 0
+			dev_err(sfc->dev, "--- INHERITED STATE OF SFC CONTROLLER START ---");
+			ingenic_sfc_dump_regs(sfc);
+			dev_err(sfc->dev, "--- INHERITED STATE OF SFC CONTROLLER END ---");
+	#endif
+
+	int i;
+
+	writel(TRIG_STOP, sfc->base + SFC_REG_TRIG);
+
+	writel(0, sfc->base + SFC_REG_GLB);
+	writel(0, sfc->base + SFC_REG_DEV_CONF);
+	writel(0, sfc->base + SFC_REG_DEV_STA_EXP);
+	writel(0, sfc->base + SFC_REG_DEV_STA_MSK);
+	for (i = 0; i < 6; i++) {
+		writel(0, sfc->base + SFC_REG_TRAN_CONF(i));
+	}
+	writel(0, sfc->base + SFC_REG_TRAN_LEN);
+	for (i = 0; i < 6; i++) {
+		writel(0, sfc->base + SFC_REG_DEV_ADDR(i));
+	}
+	for (i = 0; i < 6; i++) {
+		writel(0, sfc->base + SFC_REG_DEV_ADDR_PLUS(i));
+	}
+	writel(0, sfc->base + SFC_REG_MEM_ADDR);
+	writel(0, sfc->base + SFC_REG_TRIG);
+	writel(0, sfc->base + SFC_REG_SCR);
+	writel(0, sfc->base + SFC_REG_INTC);
+	writel(0, sfc->base + SFC_REG_CGE);
+	writel(0, sfc->base + SFC_REG_CMD_IDX);
+	writel(0, sfc->base + SFC_REG_COL_ADDR);
+	writel(0, sfc->base + SFC_REG_ROW_ADDR);
+	writel(0, sfc->base + SFC_REG_STA_ADDR0);
+	writel(0, sfc->base + SFC_REG_STA_ADDR1);
+	writel(0, sfc->base + SFC_REG_DES_ADDR);
+	writel(0, sfc->base + SFC_REG_GLB1);
+	for (i = 0; i < 6; i++) {
+		writel(0, sfc->base + SFC_REG_TRAN_CFG1(i));
+	}
+}
+
+static void ingenic_sfc_apply_timings(struct spi_device *spi, unsigned long rate)
+{
+	struct ingenic_sfc *sfc = spi_controller_get_devdata(spi->controller);
+	int thold, tsetup, tsh;
+	u32 val;
+
+	/* While 0-0-0 seems to work fine for SPI-NOR, use conservative values to avoid risking race conditions/data corruption. */
+	/* Use 5-5-20 which can be seen in datasheet of XT25F128B and is also a default value for many SPI-NOR chips. */ 
+	thold  = ingenic_sfc_ns_to_devconf(rate, 5);
+	tsetup = ingenic_sfc_ns_to_devconf(rate, 5);
+	tsh    = ingenic_sfc_ns_to_devconf(rate, 20);
+
+	val = readl(sfc->base + SFC_REG_DEV_CONF);
+	val &= ~(DEV_CONF_THOLD_MASK | DEV_CONF_TSETUP_MASK | DEV_CONF_TSH_MASK);
+	val |= (thold  << DEV_CONF_THOLD_OFFSET);
+	val |= (tsetup << DEV_CONF_TSETUP_OFFSET);
+	val |= (tsh    << DEV_CONF_TSH_OFFSET);
+	writel(val, sfc->base + SFC_REG_DEV_CONF);
+
+	dev_warn(&spi->dev, "applied timings: %luHz / %d-%d-%d-%d", rate,
+		 thold, tsetup, tsh, tsh);
+}
+
+static void ingenic_update_sample_delay(struct spi_device *spi, unsigned long rate)
+{
+	struct ingenic_sfc *sfc = spi_controller_get_devdata(spi->controller);
+	u32 val;
+
+	val = readl(sfc->base + SFC_REG_DEV_CONF);
+	if (sfc->soc_info->sfc_revision >= 2 && rate >= 200000000)
+		u32p_replace_bits(&val, DEV_CONF_SMP_DELAY_180DEG, DEV_CONF_SMP_DELAY_MASK);
+	else if (sfc->soc_info->sfc_revision == 1 && rate >= 100000000)
+		u32p_replace_bits(&val, DEV_CONF_SMP_DELAY_HALF_CYCLE, DEV_CONF_SMP_DELAY_MASK);
+	writel(val, sfc->base + SFC_REG_DEV_CONF);
+}
+
+static int ingenic_sfc_setup(struct spi_device *spi)
+{
+	struct ingenic_sfc *sfc = spi_controller_get_devdata(spi->controller);
+	unsigned long rate, requested_rate = spi->max_speed_hz * 4;
+	int ret, val;
+
+	if (!spi->max_speed_hz)
+		return -EINVAL;
+
+	ret = clk_prepare_enable(sfc->clk);
+	if (ret)
+		return ret;
+
+	ret = clk_set_rate(sfc->clk, requested_rate);
+	if (ret) {
+		ret = -EINVAL;
+		goto out_disable_clk;
+	}
+
+	ingenic_sfc_hw_init(sfc);
+
+	val = 0;
+	/* Trigger RREQ/TREQ interrupts every N words as provided here */
+	u32p_replace_bits(&val, sfc->soc_info->max_fifo_words - 1 /* 64 - 1 */, GLB_THRESHOLD_MASK);
+	u32p_replace_bits(&val, GLB_BURST_MD_INCR32, GLB_BURST_MD_MASK);
+	u32p_replace_bits(&val, 1, GLB_PHASE_NUM_MASK);
+	
+	writel(val, sfc->base + SFC_REG_GLB);
+
+	rate = clk_get_rate(sfc->clk);
+	dev_warn(&spi->dev, "initializing clock based on spi-max-frequency: %luHz", rate);
+
+	val = readl(sfc->base + SFC_REG_DEV_CONF);
+
+	/* cpha bit:0 , cpol bit:0 */
+	val &= ~(DEV_CONF_CPHA | DEV_CONF_CPOL);
+	val |= spi->mode & SPI_CPHA ? DEV_CONF_CPHA : 0;
+	val |= spi->mode & SPI_CPOL ? DEV_CONF_CPOL : 0;
+
+	/* ce_dl bit:1, hold bit:1, wp bit:1 */
+	val |= (DEV_CONF_CE_DL | DEV_CONF_HOLD_DL | DEV_CONF_WP_DL);
+	writel(val, sfc->base + SFC_REG_DEV_CONF);
+	ingenic_sfc_apply_timings(spi, rate);
+
+	val = readl(sfc->base + SFC_REG_GLB);
+	u32p_replace_bits(&val, GLB_OP_MODE_SLAVE, GLB_OP_MODE_MASK);
+	writel(val, sfc->base + SFC_REG_GLB);
+
+	ingenic_update_sample_delay(spi, rate);
+	ingenic_sfc_mask_and_clear(sfc);
+	ret = 0;
+
+out_disable_clk:
+	clk_disable_unprepare(sfc->clk);
+	return ret;
+}
+
+static int ingenic_sfc_probe(struct platform_device *pdev)
+{
+	struct ingenic_sfc *sfc;
+	struct spi_controller *ctlr;
+	int ret;
+
+	ctlr = __spi_alloc_controller(&pdev->dev, sizeof(*sfc), false);
+	if (!ctlr)
+		return -ENOMEM;
+
+	sfc = spi_controller_get_devdata(ctlr);
+
+	sfc->soc_info = of_device_get_match_data(&pdev->dev);
+	if (!sfc->soc_info) {
+		dev_err(&pdev->dev, "No of match data provided\n");
+		ret = -ENODEV;
+		goto err_put_master;
+	}
+
+	sfc->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(sfc->base)) {
+		ret = PTR_ERR(sfc->base);
+		goto err_put_master;
+	}
+
+	sfc->clk = devm_clk_get(&pdev->dev, "sfc");
+	if (IS_ERR(sfc->clk)) {
+		ret = PTR_ERR(sfc->clk);
+		goto err_put_master;
+	}
+
+	sfc->dev = &pdev->dev;
+
+	ret = clk_prepare_enable(sfc->clk);
+	if (ret)
+		goto err_put_master;
+	writel(TRIG_STOP, sfc->base + SFC_REG_TRIG);
+	readl(sfc->base + SFC_REG_TRIG);
+	ingenic_sfc_mask_and_clear(sfc);
+	clk_disable_unprepare(sfc->clk);
+
+	sfc->irq = platform_get_irq(pdev, 0);
+	if (sfc->irq < 0) {
+		ret = sfc->irq;
+		goto err_put_master;
+	}
+
+	sfc->cs = 0; 
+
+	platform_set_drvdata(pdev, sfc);
+
+	ret = devm_request_irq(&pdev->dev, sfc->irq, ingenic_sfc_irq_handler, 0,
+			dev_name(&pdev->dev), sfc);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to request irq%d, ret = %d\n", sfc->irq, ret);
+		goto err_put_master;
+	}
+
+	init_completion(&sfc->completion);
+
+	ctlr->bus_num = -1;
+	ctlr->num_chipselect = 2;
+	ctlr->mem_ops = &ingenic_sfc_mem_ops;
+	ctlr->dev.of_node = pdev->dev.of_node;
+	ctlr->setup = ingenic_sfc_setup;
+	ctlr->mode_bits = SPI_CPHA | SPI_CPOL |
+			SPI_RX_DUAL | SPI_RX_QUAD | SPI_TX_DUAL | SPI_TX_QUAD;
+	if (sfc->soc_info->max_bus_width >= 8)
+		ctlr->mode_bits |= SPI_RX_OCTAL | SPI_TX_OCTAL;
+
+	ret = devm_spi_register_controller(&pdev->dev, ctlr);
+	if (ret)
+		goto err_put_master;
+
+	return 0;
+
+err_put_master:
+	spi_controller_put(ctlr);
+
+	return ret;
+}
+
