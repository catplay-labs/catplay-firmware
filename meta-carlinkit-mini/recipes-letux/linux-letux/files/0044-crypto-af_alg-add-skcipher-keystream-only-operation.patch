 /**
+ * crypto_skcipher_generate_keystream() - generate cipher keystream
+ * @req: skcipher request describing destination, length, and IV
+ *
+ * Generate raw keystream into @req->dst without consuming source data.
+ * Only algorithms which explicitly implement this operation support it.
+ *
+ * Return: 0 on success; -EOPNOTSUPP when unsupported; another < 0 error
+ * otherwise.
+ */
+int crypto_skcipher_generate_keystream(struct skcipher_request *req);
+
+/**
  * crypto_skcipher_export() - export partial state
  * @req: reference to the skcipher_request handle that holds all information
  *	 needed to perform the operation
diff --git a/crypto/skcipher.c b/crypto/skcipher.c
--- a/crypto/skcipher.c
+++ b/crypto/skcipher.c
@@ -657,6 +657,20 @@
 }
 EXPORT_SYMBOL_GPL(crypto_skcipher_decrypt);

+int crypto_skcipher_generate_keystream(struct skcipher_request *req)
+{
+	struct crypto_skcipher *tfm = crypto_skcipher_reqtfm(req);
+	struct skcipher_alg *alg = crypto_skcipher_alg(tfm);
+
+	if (crypto_skcipher_get_flags(tfm) & CRYPTO_TFM_NEED_KEY)
+		return -ENOKEY;
+	if (alg->co.base.cra_type != &crypto_skcipher_type ||
+	    !alg->generate_keystream)
+		return -EOPNOTSUPP;
+	return alg->generate_keystream(req);
+}
+EXPORT_SYMBOL_GPL(crypto_skcipher_generate_keystream);
+
 static int crypto_lskcipher_export(struct skcipher_request *req, void *out)
 {
 	struct crypto_skcipher *tfm = crypto_skcipher_reqtfm(req);
