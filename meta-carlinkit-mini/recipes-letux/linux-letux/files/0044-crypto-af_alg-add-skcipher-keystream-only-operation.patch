@@ -976,14 +982,16 @@
 			goto unlock;
 		}

-		pr_info_once(
-			"%s sent an empty control message without MSG_MORE.\n",
-			current->comm);
+		if (!keystream)
+			pr_info_once(
+				"%s sent an empty control message without MSG_MORE.\n",
+				current->comm);
