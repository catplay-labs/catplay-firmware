+static int _skcipher_recvmsg_keystream(struct socket *sock,
+					struct msghdr *msg, int flags)
+{
+	struct sock *sk = sock->sk;
+	struct alg_sock *ask = alg_sk(sk);
+	struct sock *psk = ask->parent;
+	struct alg_sock *pask = alg_sk(psk);
+	struct af_alg_ctx *ctx = ask->private;
+	struct crypto_skcipher *tfm = pask->private;
+	unsigned int bs = crypto_skcipher_chunksize(tfm);
+	struct af_alg_async_req *areq;
+	size_t maxsize = msg_data_left(msg);
+	size_t len = 0;
+	int err;
+
+	if (!ctx->init || ctx->more || ctx->used || ctx->state)
+		return -EINVAL;
+	if (!maxsize)
+		return 0;
+
+	areq = af_alg_alloc_areq(sk, sizeof(struct af_alg_async_req) +
+				     crypto_skcipher_reqsize(tfm));
+	if (IS_ERR(areq))
+		return PTR_ERR(areq);
+
+	err = af_alg_get_rsgl(sk, msg, flags, areq, maxsize, &len);
+	if (err)
+		goto free;
+	if (!len || len % bs) {
+		err = -EINVAL;
+		goto free;
+	}
+
+	skcipher_request_set_tfm(&areq->cra_u.skcipher_req, tfm);
+	skcipher_request_set_crypt(&areq->cra_u.skcipher_req, NULL,
+				   areq->first_rsgl.sgl.sgt.sgl, len, ctx->iv);
+
+	if (msg->msg_iocb && !is_sync_kiocb(msg->msg_iocb)) {
+		sock_hold(sk);
+		areq->iocb = msg->msg_iocb;
+		areq->outlen = len;
+
+		skcipher_request_set_callback(&areq->cra_u.skcipher_req,
+					      CRYPTO_TFM_REQ_MAY_SLEEP,
+					      algif_skcipher_done, areq);
+		err = crypto_skcipher_generate_keystream(
+			&areq->cra_u.skcipher_req);
+		if (err == -EINPROGRESS)
+			return -EIOCBQUEUED;
+
+		sock_put(sk);
+	} else {
+		skcipher_request_set_callback(&areq->cra_u.skcipher_req,
+					      CRYPTO_TFM_REQ_MAY_SLEEP |
+					      CRYPTO_TFM_REQ_MAY_BACKLOG,
+					      crypto_req_done, &ctx->wait);
+		err = crypto_wait_req(crypto_skcipher_generate_keystream(
+					&areq->cra_u.skcipher_req),
+				      &ctx->wait);
+	}
+
+free:
+	af_alg_free_resources(areq);
+	return err ? err : len;
+}
+
