+#include <net.h>
+#include <netdev.h>
+#include <asm/gpio.h>
+#include <asm/arch/cpm.h>
+#include <asm/arch/nand.h>
+#include <asm/arch/mmc.h>
+#include <asm/arch/clk.h>
+#include <asm/arch/wdt.h>
+
+int board_early_init_f(void)
+{
+	return 0;
+}
+
+int board_early_init_r(void)
+{
+	return 0;
+}
+
+#ifdef CONFIG_USB_GADGET
+int jz_udc_probe(void);
+void board_usb_init(void)
+{
+	printf("USB_udc_probe\n");
+	jz_udc_probe();
+}
+#endif /* CONFIG_USB_GADGET */
+
+int misc_init_r(void)
+{
+	return 0;
+}
+
+#ifdef CONFIG_MMC
+int board_mmc_init(bd_t *bd)
+{
+	jz_mmc_init();
+	return 0;
+}
+#endif
+
+int board_eth_init(bd_t *bis)
+{
+	return 0;
+}
+
+#ifdef CONFIG_SYS_NAND_SELF_INIT
+void board_nand_init(void)
+{
+	return 0;
+}
+#endif
+
+/* U-Boot common routines */
+int checkboard(void)
+{
+	puts("Board: AX1800M (Ingenic XBurst X1600EN SoC)\n");
+	return 0;
+}
+
+#ifdef CONFIG_SPL_NOR_SUPPORT
+int spl_start_uboot(void)
+{
+	return 1;
+}
+#endif
+
+#ifdef CONFIG_SPL_BUILD
+
+void spl_board_init(void)
+{
+}
+
+#endif /* CONFIG_SPL_BUILD */
+
+#include <asm/errno.h>
+#include <asm/io.h>
+#include <asm/arch/cpm.h>
+
+void spl_board_unbrick(void) {
+	#ifdef CONFIG_C2A_AGGRESSIVE_UNBRICK
+		#define SLPC_SW_MAGIC           0x425753 // SWB (software boot)
+		#define SLPC_SW_USB_BOOT        (0x2 << 0)
+
+		printf("Attempting unbrick...rebooting to Ingenic USB loader\n");
+		unsigned int val = SLPC_SW_MAGIC << 8 | SLPC_SW_USB_BOOT;
+		unsigned int wdt_ticks = RTC_FREQ / WDT_DIV * RESET_DELAY_MS / 1000;
+
+		if (wdt_ticks > 65535)
+			wdt_ticks = 65535;
+
+		cpm_outl(val, CPM_SLPC);
+		writel(TSCR_WDTSC, TCU_BASE + TCU_TSCR);
+		writel(0, WDT_BASE + WDT_TCNT);
+		writel(wdt_ticks, WDT_BASE + WDT_TDR);
+		writel(TCSR_PRESCALE | TCSR_RTC_EN | TCSR_CLRZ, WDT_BASE + WDT_TCSR);
+		writel(0, WDT_BASE + WDT_TCER);
+		writel(TCER_TCEN, WDT_BASE + WDT_TCER);
+
+		for (;;) {}
+	#endif
+}
