diff --git a/include/ddr/chips-v2/AX1800_DDR2.h b/include/ddr/chips-v2/AX1800_DDR2.h
new file mode 100644
index 00000000000..1c36070b0f8
--- /dev/null
+++ b/include/ddr/chips-v2/AX1800_DDR2.h
@@ -0,0 +1,73 @@
+#ifndef __AX1800_DDR2_H
+#define	__AX1800_DDR2_H
+
+// /*
+//  * CL:3,50M ~ 200M
+//  * CL:4,200M ~ 266M
+//  * CL:5,266M ~ 400M
+//  * CL:6,
+//  * CL:7,400M ~ 533M
+//  *
+//  * */
+
+static inline void AX1800_DDR2_init(void *data)
+{
+	#define CONFIG_DDR_CL	7
+	#define CONFIG_DDR_AL	0
+
+	struct ddr_chip_info *c = (struct ddr_chip_info *)data;
+	unsigned int RL = CONFIG_DDR_CL + CONFIG_DDR_AL;
+
+	c->DDR_ROW     = 13;
+	c->DDR_ROW1    = 13;
+	c->DDR_COL     = 10;
+	c->DDR_COL1    = 10;
+
+	c->DDR_BANK8   = 0;
+	c->DDR_CL      = CONFIG_DDR_CL;
+	c->DDR_AL      = 0;
+
+	c->DDR_tRAS    = DDR__ns(45);
+	c->DDR_tRTP    = DDR__ns(8);
+	c->DDR_tRP 	   = DDR__tck(6);// DDR__ps(17143);
+	c->DDR_tRCD    = DDR__tck(6);// DDR__ps(17143);
+	c->DDR_tRC     = DDR__ps(58125);
+	c->DDR_tRRD    = DDR__ns(10);
+	c->DDR_tWR     = DDR__ns(15);
+	c->DDR_tWTR    = DDR__ps(7500);
+	c->DDR_tRFC    = DDR__ns(126);
+	c->DDR_tXP     = DDR__tck(3);
+	c->DDR_tMRD    = DDR__tck(4);
+
+	c->DDR_BL      = 8;
+	c->DDR_RL      = DDR__tck(RL);
+	c->DDR_WL      = DDR__tck((RL - 1));
+
+	c->DDR_tCCD    = DDR__tck(2);
+	c->DDR_tFAW    = DDR__ns(45);
+	c->DDR_tCKE    = DDR__tck(3) ;
+	c->DDR_tCKESR  = DDR__tck(3);
+	c->DDR_tXARD   = DDR__tck(3);
+	c->DDR_tXARDS  = DDR__tck(10 - c->DDR_AL);
+
+	c->DDR_tXSNR   = (c->DDR_tRFC + DDR__ns(10));
+	c->DDR_tXSRD   = DDR__tck(200);
+	c->DDR_tREFI   = DDR__ns(3900);
+
+	c->DDR_CLK_DIV = 1;
+}
+
+#ifndef CONFIG_AX1800_DDR2_MEM_FREQ
+#define CONFIG_AX1800_DDR2_MEM_FREQ CONFIG_SYS_MEM_FREQ
+#endif
+
+#define AX1800_DDR2 {					\
+	.name 	= "AX1800-DDR2",					\
+	.id	= DDR_CHIP_ID(0, TYPE_DDR2, MEM_64M),	\
+	.type	= DDR2,						\
+	.freq	= CONFIG_AX1800_DDR2_MEM_FREQ,			\
+	.size	= 64,						\
+	.init	= AX1800_DDR2_init,				\
+}
+
+#endif /* __AX1800_DDR2_H */
\ No newline at end of file
