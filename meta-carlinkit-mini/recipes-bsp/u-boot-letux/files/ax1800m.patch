diff --git a/arch/mips/include/asm/arch-x1600/tcu.h b/arch/mips/include/asm/arch-x1600/tcu.h
new file mode 100644
index 00000000000..e1f1cb826a2
--- /dev/null
+++ b/arch/mips/include/asm/arch-x1600/tcu.h
@@ -0,0 +1,25 @@
+/*
+ * X1600 TCU definitions (minimal set for watchdog)
+ *
+ * Copyright (c) 2013 Ingenic Semiconductor Co.,Ltd
+ *
+ * This program is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU General Public License as
+ * published by the Free Software Foundation; either version 2 of
+ * the License, or (at your option) any later version.
+ */
+
+#ifndef __TCU_H__
+#define __TCU_H__
+
+#include <asm/arch/base.h>
+
+/* TCU clock stop/set registers */
+#define TCU_TSSR		(TCU_BASE + 0x2C)
+#define TCU_TSCR		(TCU_BASE + 0x3C)
+
+/* Watchdog gate control bits in TCU stop/set registers */
+#define TCU_TSSR_WDTSS		(1 << 16)
+#define TCU_TSCR_WDTSC		(1 << 16)
+
+#endif /* __TCU_H__ */
