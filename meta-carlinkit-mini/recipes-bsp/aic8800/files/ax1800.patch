diff --git a/aic8800_bsp/aic_bsp_driver.c b/aic8800_bsp/aic_bsp_driver.c
--- a/aic8800_bsp/aic_bsp_driver.c
+++ b/aic8800_bsp/aic_bsp_driver.c
@@ -16,6 +16,12 @@
 #include <linux/delay.h>
 #include <linux/vmalloc.h>
 #include <linux/firmware.h>
+#include <linux/mmc/sdio_func.h>
+#include <linux/mmc/card.h>
+#include <linux/mmc/host.h>
+#include <linux/gpio.h>
+#include <linux/of.h>
+#include <linux/pinctrl/pinconf-generic.h>
 
 #if LINUX_VERSION_CODE < KERNEL_VERSION(3, 12, 0)
 #include <linux/hardirq.h>
@@ -1692,6 +1698,47 @@
 	struct aicbt_patch_table *p;
-	int ret = 0, i;
+	int ret = 0, i, gpio_ret, gpio_value;
+	u32 btmode_pin, btmode;
+	struct gpio_desc *gpio_desc;
+	struct device_node *np = sdiodev->dev ? sdiodev->dev->of_node : NULL;
 	uint32_t *data = NULL;
+
+	/* SDIO functions have no OF child on this platform; use the host node. */
+	if (!np && sdiodev->func && sdiodev->func->card &&
+	    sdiodev->func->card->host && sdiodev->func->card->host->parent)
+		np = sdiodev->func->card->host->parent->of_node;
+
+	if (np && !of_property_read_u32(np, "c2a,btmode_pin", &btmode_pin)) {
+		gpio_ret = gpio_request(btmode_pin, "aic-bt-mode");
+		if (!gpio_ret) {
+			gpio_desc = gpio_to_desc(btmode_pin);
+			gpio_ret = gpio_desc ? gpiod_direction_input(gpio_desc) : -EINVAL;
+			if (!gpio_ret && of_property_read_bool(np,
+						"c2a,btmode-bias-pull-down"))
+				gpio_ret = gpiod_set_config(gpio_desc,
+					pinconf_to_config_packed(PIN_CONFIG_BIAS_PULL_DOWN, 1));
+			if (!gpio_ret) {
+				gpio_value = gpiod_get_raw_value(gpio_desc);
+				if (gpio_value >= 0) {
+					pr_info("rt_gpio=%u value =%d\n", btmode_pin, gpio_value);
+					aicbt_info[sdiodev->chipid].btmode = gpio_value ?
+						AICBT_BTMODE_BT_ONLY_COANT : AICBT_BTMODE_BT_ONLY;
+				}
+			}
+			gpio_free(btmode_pin);
+		} else {
+			pr_err("aicbt: gpio_request(%u) failed: %d\\n", btmode_pin,
+			       gpio_ret);
+		}
+	} else if (np && !of_property_read_u32(np, "c2a,btmode", &btmode)) {
+		aicbt_info[sdiodev->chipid].btmode = btmode;
+	}
+	if (np) {
+		if (!of_property_read_u32(np, "c2a,uart_baud", &btmode))
+			aicbt_info[sdiodev->chipid].uart_baud = btmode;
+		if (!of_property_read_u32(np, "c2a,uart_flowctrl", &btmode))
+			aicbt_info[sdiodev->chipid].uart_flowctrl = btmode;
+	}
+
     if(head == NULL){
         return -1;
     }
