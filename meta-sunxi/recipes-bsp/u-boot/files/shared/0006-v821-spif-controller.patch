From: CatPlay V821 port
Subject: [PATCH] spi: sunxi: share Linux-derived SPIF engine between DM and SPL

Upstream-Status: Inappropriate [CatPlay V821 port]

diff --git a/drivers/spi/Kconfig b/drivers/spi/Kconfig
index cfbedd64..852dcfe8 100644
--- a/drivers/spi/Kconfig
+++ b/drivers/spi/Kconfig
@@ -563,6 +563,19 @@ config SPI_SUNXI
 
 	  Same controller driver can reuse in all Allwinner SoC variants.
 
+config SPI_SUNXI_SPIF
+	bool "Allwinner SPIF controller support"
+	depends on SOC_SUNXI || ARCH_SUNXI
+	help
+	  Enable support for the dedicated SPI flash controller found on the
+	  Allwinner V821, V853 and A523 SoCs.
+
+config SPL_SPI_SUNXI_SPIF
+	bool "Non-DM Allwinner SPIF controller"
+	depends on SPL && (SOC_SUNXI || ARCH_SUNXI)
+	help
+	  Build the shared SPI-mem engine without the DM frontend.
+
 config STM32_OSPI
 	bool "STM32MP2 OSPI driver"
 	depends on (STM32MP23X || STM32MP25X) && STM32_OMM
diff --git a/drivers/spi/Makefile b/drivers/spi/Makefile
index 13d9c5dc..c0456367 100644
--- a/drivers/spi/Makefile
+++ b/drivers/spi/Makefile
@@ -76,6 +76,11 @@ obj-$(CONFIG_SANDBOX_SPI) += sandbox_spi.o
 obj-$(CONFIG_SPI_SIFIVE) += spi-sifive.o
 obj-$(CONFIG_SPI_SN_F_OSPI) += spi-sn-f-ospi.o
 obj-$(CONFIG_SPI_SUNXI) += spi-sunxi.o
+obj-$(CONFIG_$(PHASE_)SPI_SUNXI_SPIF) += sunxi_spif_core.o
+ifeq ($(CONFIG_$(PHASE_)DM),y)
+obj-$(CONFIG_$(PHASE_)SPI_SUNXI_SPIF) += sunxi_spif.o
+endif
+
 obj-$(CONFIG_SH_QSPI) += sh_qspi.o
 obj-$(CONFIG_STM32_OSPI) += stm32_ospi.o
 obj-$(CONFIG_STM32_QSPI) += stm32_qspi.o
diff --git a/drivers/spi/spi-sunxi.c b/drivers/spi/spi-sunxi.c
index 3c96b368..1a1ac8b2 100644
--- a/drivers/spi/spi-sunxi.c
+++ b/drivers/spi/spi-sunxi.c
@@ -86,8 +86,7 @@
 #define SUN4I_SPI_DEFAULT_RATE		1000000
 #define SUN4I_SPI_TIMEOUT_MS		1000
 
-#define SPI_REG(priv, reg)		((priv)->base + \
-					(priv)->variant->regs[reg])
+#define SPI_REG(priv, reg)		sun4i_spi_reg((priv), (reg))
 #define SPI_BIT(priv, bit)		((priv)->variant->bits[bit])
 #define SPI_CS(priv, cs)		(((cs) << SPI_BIT(priv, SPI_TCR_CS_SEL)) & \
 					SPI_BIT(priv, SPI_TCR_CS_MASK))
@@ -155,6 +154,12 @@ struct sun4i_spi_priv {
 	u8 *rx_buf;
 };
 
+static inline void __iomem *
+sun4i_spi_reg(struct sun4i_spi_priv *priv, enum sun4i_spi_regs reg)
+{
+	return (void __iomem *)(priv->base + priv->variant->regs[reg]);
+}
+
 static inline void sun4i_spi_drain_fifo(struct sun4i_spi_priv *priv, int len)
 {
 	u8 byte;
diff --git a/drivers/spi/sunxi_spif.c b/drivers/spi/sunxi_spif.c
new file mode 100644
--- /dev/null
+++ b/drivers/spi/sunxi_spif.c
@@ -0,0 +1,211 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* DM SPI-mem frontend for the shared linux-sunxi SPIF v2 engine. */
+#include <clk.h>
+#include <dm.h>
+#include <dm/device_compat.h>
+#include <reset.h>
+#include <spi.h>
+#include <spi-mem.h>
+#include <sunxi_spif.h>
+#include <asm/cache.h>
+#include <asm/io.h>
+#include <linux/errno.h>
+#include <malloc.h>
+
+struct sunxi_spif_priv {
+	struct sunxi_spif core;
+	struct clk bus, mod, parent;
+	bool has_parent;
+	bool board_managed;
+	struct reset_ctl reset;
+};
+
+static int set_clock(void *opaque, unsigned long rate)
+{
+	struct sunxi_spif_priv *priv = opaque;
+	long actual = clk_set_rate(&priv->mod, rate);
+
+	return actual < 0 ? actual : 0;
+}
+
+static int set_speed(struct udevice *dev, uint speed)
+{
+	struct sunxi_spif_priv *priv = dev_get_priv(dev);
+
+	priv->core.max_frequency = speed;
+	return 0;
+}
+
+static int set_mode(struct udevice *dev, uint mode)
+{
+	struct sunxi_spif_priv *priv = dev_get_priv(dev);
+
+	if (mode & ~(SPI_CPOL | SPI_CPHA | SPI_RX_QUAD | SPI_TX_QUAD |
+		     SPI_RX_DUAL | SPI_TX_DUAL))
+		return -EOPNOTSUPP;
+	priv->core.mode = mode;
+	return 0;
+}
+
+static int adjust_op_size(struct spi_slave *slave, struct spi_mem_op *op)
+{
+	op->data.nbytes = min_t(unsigned int, op->data.nbytes, SUNXI_SPIF_MAX_DATA);
+	return 0;
+}
+
+static bool supports_op(struct spi_slave *slave, const struct spi_mem_op *op)
+{
+	struct sunxi_spif_priv *priv = dev_get_priv(slave->dev->parent);
+
+	/* DTR is exposed only where the SPI-mem framework supports it. */
+	return spi_mem_default_supports_op(slave, op) &&
+		sunxi_spif_supports_op(&priv->core, op);
+}
+
+static int exec_op(struct spi_slave *slave, const struct spi_mem_op *op)
+{
+	struct sunxi_spif_priv *priv = dev_get_priv(slave->dev->parent);
+
+	return sunxi_spif_exec_op(&priv->core, op);
+}
+
+static const struct spi_controller_mem_ops mem_ops = {
+	.adjust_op_size = adjust_op_size,
+	.supports_op = supports_op,
+	.exec_op = exec_op,
+};
+
+static const struct dm_spi_ops ops = {
+	.set_speed = set_speed,
+	.set_mode = set_mode,
+	.mem_ops = &mem_ops,
+};
+
+#ifdef CONFIG_XPL_BUILD
+__weak int board_sunxi_spif_init(struct udevice *dev, struct sunxi_spif *core)
+{
+	return -ENOSYS;
+}
+#endif
+
+static int probe(struct udevice *dev)
+{
+	struct sunxi_spif_priv *priv = dev_get_priv(dev);
+	struct sunxi_spif *core = &priv->core;
+	u32 mode, delay;
+	int ret;
+
+#ifdef CONFIG_XPL_BUILD
+	ret = board_sunxi_spif_init(dev, core);
+	if (ret != -ENOSYS) {
+		priv->board_managed = !ret;
+		return ret;
+	}
+#endif
+
+	if (!CONFIG_IS_ENABLED(CLK))
+		return -ENOSYS;
+
+	core->base = dev_read_addr_ptr(dev);
+	if (!core->base)
+		return -EINVAL;
+	ret = clk_get_by_name(dev, "bus", &priv->bus);
+	if (ret)
+		ret = clk_get_by_name(dev, "ahb", &priv->bus);
+	if (ret)
+		return ret;
+	ret = clk_get_by_name(dev, "mclk", &priv->mod);
+	if (ret)
+		ret = clk_get_by_name(dev, "mod", &priv->mod);
+	if (ret)
+		return ret;
+	ret = reset_get_by_index(dev, 0, &priv->reset);
+	if (ret)
+		return ret;
+	/* Linux bindings provide pclk/mclk/bus; retain U-Boot ahb/mod ABI. */
+	priv->has_parent = !clk_get_by_name(dev, "pclk", &priv->parent);
+	if (priv->has_parent) {
+		ret = clk_enable(&priv->parent);
+		if (ret)
+			return ret;
+		ret = clk_set_parent(&priv->mod, &priv->parent);
+		if (ret)
+			goto disable_parent;
+	}
+	ret = clk_enable(&priv->bus);
+	if (ret)
+		goto disable_parent;
+	ret = clk_enable(&priv->mod);
+	if (ret)
+		goto disable_bus;
+	ret = reset_deassert(&priv->reset);
+	if (ret)
+		goto disable_mod;
+	core->desc = memalign(ARCH_DMA_MINALIGN,
+			      ALIGN(sizeof(*core->desc), ARCH_DMA_MINALIGN));
+	core->buffer = memalign(ARCH_DMA_MINALIGN, SUNXI_SPIF_MAX_DATA);
+	if (!core->desc || !core->buffer) {
+		ret = -ENOMEM;
+		goto free_buffers;
+	}
+	mode = dev_read_u32_default(dev, "allwinner,sample-mode", 0);
+	delay = dev_read_u32_default(dev, "allwinner,sample-delay", 0);
+	if (mode > 7 || delay > 63) {
+		ret = -EINVAL;
+		goto free_buffers;
+	}
+	core->sample_mode = mode;
+	core->sample_delay = delay;
+	core->sample_configured = dev_read_bool(dev, "allwinner,sample-mode") ||
+		dev_read_bool(dev, "allwinner,sample-delay");
+	core->max_frequency = 25000000;
+	core->set_clock = set_clock;
+	core->clock_priv = priv;
+	ret = sunxi_spif_init(core);
+	if (!ret)
+		return 0;
+free_buffers:
+	free(core->desc);
+	free(core->buffer);
+	reset_assert(&priv->reset);
+disable_mod:
+	clk_disable(&priv->mod);
+disable_bus:
+	clk_disable(&priv->bus);
+disable_parent:
+	if (priv->has_parent)
+		clk_disable(&priv->parent);
+	return ret;
+}
+
+static int remove_driver(struct udevice *dev)
+{
+	struct sunxi_spif_priv *priv = dev_get_priv(dev);
+
+	if (priv->board_managed)
+		return 0;
+
+	reset_assert(&priv->reset);
+	clk_disable(&priv->mod);
+	clk_disable(&priv->bus);
+	if (priv->has_parent)
+		clk_disable(&priv->parent);
+	free(priv->core.desc);
+	free(priv->core.buffer);
+	return 0;
+}
+
+static const struct udevice_id ids[] = {
+	{ .compatible = "allwinner,sun300i-v821-spif" },
+	{ }
+};
+
+U_BOOT_DRIVER(sunxi_spif) = {
+	.name = "sunxi_spif",
+	.id = UCLASS_SPI,
+	.of_match = ids,
+	.ops = &ops,
+	.priv_auto = sizeof(struct sunxi_spif_priv),
+	.probe = probe,
+	.remove = remove_driver,
+};
diff --git a/drivers/spi/sunxi_spif_core.c b/drivers/spi/sunxi_spif_core.c
new file mode 100644
--- /dev/null
+++ b/drivers/spi/sunxi_spif_core.c
@@ -0,0 +1,489 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/* Port of linux-sunxi spi-sunxi-spif.c: SPIF v1/v2 descriptor engine.
+ * Polling replaces Linux IRQ completion; clock/reset ownership stays outside.
+ */
+#include <sunxi_spif.h>
+#include <cpu_func.h>
+#include <asm/cache.h>
+#include <asm/io.h>
+#include <linux/bitfield.h>
+#include <linux/iopoll.h>
+#include <linux/string.h>
+#include <spi.h>
+
+#define SPIF_GC_REG			0x04
+#define SPIF_VER_REG			0x00
+#define SPIF_GCA_REG			0x08
+#define SPIF_TC_REG			0x0c
+#define SPIF_INT_EN_REG			0x14
+#define SPIF_INT_STA_REG		0x18
+#define SPIF_CSD_REG			0x1c
+#define SPIF_PHC_REG			0x20
+#define SPIF_TCF_REG			0x24
+#define SPIF_TCS_REG			0x28
+#define SPIF_TNM_REG			0x2c
+#define SPIF_DMA_CTL_REG		0x40
+#define SPIF_DSC_REG			0x44
+#define SPIF_CFT_REG			0x4c
+#define SPIF_CFS_REG			0x50
+
+#define SPIF_CFT_CDC			0x64106410
+#define SPIF_CSD_V1			((5 << 16) | (6 << 8) | 6)
+#define SPIF_CSD_V2			((6 << 16) | (6 << 8) | 5)
+
+#define SPIF_TC_SCKOUT_SRC_SEL		BIT(26)
+#define SPIF_TC_SAMP_MODE_EN		BIT(20)
+#define SPIF_TC_SAMP_DL_SW_EN		BIT(6)
+#define SPIF_TC_SAMP_MODE		GENMASK(18, 16)
+#define SPIF_TC_SAMP_DELAY		GENMASK(5, 0)
+
+#define SPIF_GC_CFG_MODE		BIT(0)
+#define SPIF_GC_NMODE_EN		BIT(2)
+#define SPIF_GC_CPHA			BIT(4)
+#define SPIF_GC_CPOL			BIT(5)
+#define SPIF_GC_CS_POL			BIT(8)
+#define SPIF_GC_DQS_RX_EN		BIT(10)
+#define SPIF_GC_HOLD_EN			BIT(13)
+#define SPIF_GC_WP_EN			BIT(15)
+#define SPIF_GC_DTR_EN			BIT(16)
+#define SPIF_GC_RX_CFG_FBS		BIT(17)
+#define SPIF_GC_TX_CFG_FBS		BIT(18)
+#define SPIF_GC_MODE_MASK		GENMASK(5, 4)
+
+#define SPIF_GCA_RF_RST			BIT(0)
+#define SPIF_GCA_WF_RST			BIT(1)
+#define SPIF_GCA_RESET			BIT(3)
+#define SPIF_GCA_V1_RESET		GENMASK(3, 0)
+
+#define SPIF_INT_RF_OVF			BIT(8)
+#define SPIF_INT_RF_UDF			BIT(9)
+#define SPIF_INT_WF_OVF			BIT(10)
+#define SPIF_INT_DMA_DONE		BIT(24)
+#define SPIF_INT_PREFETCH_DONE		BIT(25)
+#define SPIF_INT_ERRORS			(SPIF_INT_RF_OVF | SPIF_INT_RF_UDF | \
+					 SPIF_INT_WF_OVF)
+
+#define SPIF_PHASE_RX			BIT(8)
+#define SPIF_PHASE_TX			BIT(12)
+#define SPIF_PHASE_DUMMY		BIT(16)
+#define SPIF_PHASE_MODE			BIT(20)
+#define SPIF_PHASE_ADDR			BIT(24)
+#define SPIF_PHASE_CMD			BIT(28)
+
+#define SPIF_TCS_DATA_WIDTH		GENMASK(1, 0)
+#define SPIF_TCS_ADDR_WIDTH		GENMASK(5, 4)
+#define SPIF_TCS_CMD_WIDTH		GENMASK(9, 8)
+#define SPIF_TCS_MODE_WIDTH_V1	GENMASK(5, 4)
+#define SPIF_TCS_ADDR_WIDTH_V1	GENMASK(9, 8)
+#define SPIF_TCS_CMD_WIDTH_V1	GENMASK(13, 12)
+#define SPIF_TCS_MODE_OPCODE		GENMASK(23, 16)
+#define SPIF_TCS_CMD_OPCODE		GENMASK(31, 24)
+
+#define SPIF_TNM_DATA_COUNT		GENMASK(15, 0)
+#define SPIF_TNM_DUMMY_COUNT		GENMASK(23, 16)
+#define SPIF_TNM_ADDR_SIZE_V1		BIT(24)
+#define SPIF_TNM_ADDR_SIZE_V2		GENMASK(25, 24)
+#define SPIF_VER_V1		0x00010000
+#define SPIF_VER_V2			0x00010002
+#define SPIF_TNM_DESC_NORMAL		BIT(28)
+
+#define SPIF_DMA_START			BIT(0)
+#define SPIF_DMA_DESC_LEN		GENMASK(11, 4)
+
+#define SPIF_DESC_LAST			BIT(0)
+#define SPIF_DESC_WRITE_TO_RAM		BIT(1)
+#define SPIF_DESC_BURST_INCR16		FIELD_PREP(GENMASK(6, 4), 7)
+#define SPIF_DESC_BLOCK_64B_V1	FIELD_PREP(GENMASK(17, 16), 3)
+#define SPIF_DESC_BLOCK_64B_V2	FIELD_PREP(GENMASK(25, 24), 3)
+#define SPIF_DESC_DATA_LEN_V1	GENMASK(15, 0)
+#define SPIF_DESC_DATA_LEN_V2	GENMASK(16, 0)
+
+#define SPIF_MAX_DATA			4096
+#define SPIF_V1_MIN_DMA_RX		8
+#define SPIF_DEFAULT_MAX_FREQUENCY	25000000
+#define SPIF_TIMEOUT_US			1000000
+
+static bool is_v2(const struct sunxi_spif *spif)
+{
+	return spif->version == SUNXI_SPIF_V2;
+}
+
+static void mask_irqs(struct sunxi_spif *spif)
+{
+	writel(0, spif->base + SPIF_INT_EN_REG);
+	readl(spif->base + SPIF_INT_EN_REG);
+	writel(SPIF_INT_DMA_DONE | SPIF_INT_PREFETCH_DONE | SPIF_INT_ERRORS,
+	       spif->base + SPIF_INT_STA_REG);
+	readl(spif->base + SPIF_INT_STA_REG);
+}
+
+int sunxi_spif_init(struct sunxi_spif *spif)
+{
+	u32 val;
+	int ret;
+
+	if (!spif->set_clock || !spif->desc || !spif->buffer ||
+	    !IS_ALIGNED((ulong)spif->desc, ARCH_DMA_MINALIGN) ||
+	    !IS_ALIGNED((ulong)spif->buffer, ARCH_DMA_MINALIGN) ||
+	    spif->sample_mode > 7 || spif->sample_delay > 63)
+		return -EINVAL;
+	if (!spif->max_frequency)
+		spif->max_frequency = SPIF_DEFAULT_MAX_FREQUENCY;
+	ret = spif->set_clock(spif->clock_priv, spif->max_frequency);
+	if (ret)
+		return ret;
+	val = readl(spif->base + SPIF_VER_REG);
+	if (val != SPIF_VER_V1 && val != SPIF_VER_V2)
+		return -ENODEV;
+	spif->version = val;
+	val = is_v2(spif) ? SPIF_GCA_RESET : SPIF_GCA_V1_RESET;
+	writel(val, spif->base + SPIF_GCA_REG);
+	ret = readl_poll_timeout(spif->base + SPIF_GCA_REG, val,
+				!(val & (is_v2(spif) ? SPIF_GCA_RESET : SPIF_GCA_V1_RESET)), SPIF_TIMEOUT_US);
+	if (ret)
+		return ret;
+	if (is_v2(spif))
+		writel(SPIF_GCA_RF_RST | SPIF_GCA_WF_RST, spif->base + SPIF_GCA_REG);
+	clrbits_le32(spif->base + SPIF_GC_REG,
+		     SPIF_GC_DQS_RX_EN | SPIF_GC_WP_EN | SPIF_GC_HOLD_EN |
+		     SPIF_GC_DTR_EN | SPIF_GC_RX_CFG_FBS | SPIF_GC_TX_CFG_FBS |
+		     SPIF_GC_MODE_MASK);
+	setbits_le32(spif->base + SPIF_GC_REG, SPIF_GC_CS_POL);
+	val = readl(spif->base + SPIF_TC_REG);
+	val &= ~(SPIF_TC_SCKOUT_SRC_SEL | SPIF_TC_SAMP_MODE_EN |
+		 SPIF_TC_SAMP_DL_SW_EN | SPIF_TC_SAMP_MODE | SPIF_TC_SAMP_DELAY);
+	if (spif->sample_configured)
+		val |= SPIF_TC_SAMP_MODE_EN | SPIF_TC_SAMP_DL_SW_EN |
+		       ((u32)spif->sample_mode << 16) | spif->sample_delay;
+	writel(val, spif->base + SPIF_TC_REG);
+	writel(is_v2(spif) ? SPIF_CSD_V2 : SPIF_CSD_V1, spif->base + SPIF_CSD_REG);
+	writel(SPIF_CFT_CDC, spif->base + SPIF_CFT_REG);
+	mask_irqs(spif);
+	return 0;
+}
+
+static int width(unsigned int lanes)
+{
+	switch (lanes) {
+	case 1: return 0;
+	case 2: return 1;
+	case 4: return 2;
+	case 8: return 3;
+	default: return -EINVAL;
+	}
+}
+
+static int sunxi_spif_prepare_v1_op(const struct spi_mem_op *op,
+				     struct spi_mem_op *hwop,
+				     bool *omit_cmd)
+{
+	const u8 *out = op->data.buf.out;
+	bool mode_write = !op->addr.nbytes && !op->dummy.nbytes &&
+			  op->data.dir == SPI_MEM_DATA_OUT &&
+			  op->data.nbytes == 1 && op->cmd.buswidth == 1 &&
+			  !op->cmd.dtr && op->data.buswidth == 1 &&
+			  !op->data.dtr;
+	bool addr8_write = op->addr.nbytes == 1 &&
+			   op->data.dir == SPI_MEM_DATA_OUT &&
+			   op->data.nbytes && !op->dummy.nbytes &&
+			   op->cmd.buswidth == 1 && !op->cmd.dtr &&
+			   op->addr.buswidth == 1 && !op->addr.dtr &&
+			   op->data.buswidth == 1 && !op->data.dtr;
+
+	*hwop = *op;
+	*omit_cmd = false;
+
+	if (mode_write) {
+		if (!out)
+			return -EOPNOTSUPP;
+		/* Vendor register writes send their sole value in MODE. */
+		hwop->addr.nbytes = 1;
+		hwop->addr.val = out[0];
+		hwop->addr.buswidth = op->data.buswidth;
+		hwop->addr.dtr = op->data.dtr;
+		hwop->data.nbytes = 0;
+		return 0;
+	}
+
+	if (addr8_write) {
+		if (!out)
+			return -EOPNOTSUPP;
+		hwop->addr.nbytes = 3;
+		if (op->data.nbytes == 1) {
+			hwop->addr.val = ((u32)op->cmd.opcode << 16) |
+					   ((u32)(u8)op->addr.val << 8) |
+					   out[0];
+			*omit_cmd = true;
+			hwop->data.nbytes = 0;
+		} else {
+			hwop->addr.val = ((u32)(u8)op->addr.val << 16) |
+					   ((u32)out[0] << 8) | out[1];
+			hwop->data.buf.out = out + 2;
+			hwop->data.nbytes -= 2;
+		}
+		return 0;
+	}
+
+	/* Hardware errata: replace DUMMY with MODE when possible because DUMMY does not properly sync to clock. */
+	if (!op->addr.nbytes && op->dummy.nbytes &&
+	    op->cmd.buswidth == 1 && !op->cmd.dtr &&
+	    op->dummy.buswidth == 1 && !op->dummy.dtr &&
+	    op->data.dir == SPI_MEM_DATA_IN &&
+	    op->data.buswidth == 1 && !op->data.dtr) {
+		hwop->addr.nbytes = 1;
+		hwop->addr.val = 0;
+		hwop->addr.buswidth = 1;
+		hwop->addr.dtr = false;
+		hwop->dummy.nbytes--;
+		return 0;
+	}
+
+	if (op->addr.nbytes != 2)
+		return op->addr.nbytes <= 4 ? 0 : -EOPNOTSUPP;
+
+	if (op->cmd.buswidth == op->addr.buswidth &&
+	    op->cmd.dtr == op->addr.dtr) {
+		/* Atmel QSPI's CMD8 + ADDR16 -> ADDR24 form. */
+		hwop->addr.val = ((u32)op->cmd.opcode << 16) |
+				   (op->addr.val & 0xffff);
+		hwop->addr.nbytes = 3;
+		*omit_cmd = true;
+		return 0;
+	}
+
+	if (op->dummy.nbytes &&
+	    op->dummy.buswidth == op->addr.buswidth &&
+	    op->dummy.dtr == op->addr.dtr) {
+		/* Atmel QSPI's ADDR16 + one dummy byte -> ADDR24. */
+		hwop->addr.val = (op->addr.val & 0xffff) << 8;
+		hwop->addr.nbytes = 3;
+		hwop->dummy.nbytes--;
+		return 0;
+	}
+
+	return -EOPNOTSUPP;
+}
+
+bool sunxi_spif_supports_op(const struct sunxi_spif *spif,
+			    const struct spi_mem_op *op)
+{
+	if (op->cmd.nbytes != 1 || op->cmd.dtr)
+		return false;
+	if (op->addr.nbytes > 4 || op->dummy.nbytes > 0xff)
+		return false;
+	if (op->cmd.buswidth != 1 ||
+	    (op->addr.nbytes && width(op->addr.buswidth) < 0) ||
+	    (op->dummy.nbytes && width(op->dummy.buswidth) < 0) ||
+	    (op->data.nbytes && width(op->data.buswidth) < 0))
+		return false;
+	if (!is_v2(spif) && op->addr.nbytes == 2 &&
+	    !(op->cmd.buswidth == op->addr.buswidth &&
+	      op->cmd.dtr == op->addr.dtr) &&
+	    !(op->dummy.nbytes &&
+	      op->dummy.buswidth == op->addr.buswidth &&
+	      op->dummy.dtr == op->addr.dtr))
+		return false;
+
+	if ((op->addr.nbytes && op->addr.buswidth != 1) ||
+	    (op->dummy.nbytes && op->dummy.buswidth != 1))
+		return op->addr.nbytes && op->addr.buswidth == 4 &&
+		       !op->cmd.dtr &&
+		       op->data.dir == SPI_MEM_DATA_IN &&
+		       op->data.buswidth == 4 &&
+		       op->data.dtr == op->addr.dtr &&
+		       (!op->dummy.nbytes ||
+			(op->dummy.buswidth == 4 &&
+			 op->dummy.dtr == op->addr.dtr));
+	return true;
+}
+
+static void sunxi_spif_build_desc(struct sunxi_spif *spif,
+				  const struct spi_mem_op *op,
+				  ulong data_dma)
+{
+	struct sunxi_spif_desc *desc = spif->desc;
+	int cmd_width = width(op->cmd.buswidth);
+	unsigned int dummy_cycles;
+	size_t data_len;
+	u32 command;
+
+	memset(desc, 0, sizeof(*desc));
+	desc->control = SPIF_DESC_LAST | SPIF_DESC_BURST_INCR16;
+	desc->data_len = is_v2(spif) ? SPIF_DESC_BLOCK_64B_V2 :
+				    SPIF_DESC_BLOCK_64B_V1;
+	desc->phase = SPIF_PHASE_CMD;
+	desc->command = FIELD_PREP(SPIF_TCS_CMD_OPCODE, op->cmd.opcode) |
+		(is_v2(spif) ? FIELD_PREP(SPIF_TCS_CMD_WIDTH, cmd_width) :
+		 FIELD_PREP(SPIF_TCS_CMD_WIDTH_V1, cmd_width));
+	desc->count = SPIF_TNM_DESC_NORMAL;
+
+	if (!is_v2(spif) && op->addr.nbytes == 1) {
+		/* V1 has no 8-bit address length; MODE is one byte after CMD. */
+		desc->phase |= SPIF_PHASE_MODE;
+		desc->command |= FIELD_PREP(SPIF_TCS_MODE_OPCODE,
+					    (u8)op->addr.val);
+		desc->command |= FIELD_PREP(SPIF_TCS_MODE_WIDTH_V1,
+					   width(op->addr.buswidth));
+	} else if (op->addr.nbytes) {
+		desc->phase |= SPIF_PHASE_ADDR;
+		desc->flash_addr = op->addr.val;
+		desc->command |= is_v2(spif) ?
+			FIELD_PREP(SPIF_TCS_ADDR_WIDTH,
+				   width(op->addr.buswidth)) :
+			FIELD_PREP(SPIF_TCS_ADDR_WIDTH_V1,
+				   width(op->addr.buswidth));
+		desc->count |= is_v2(spif) ?
+			FIELD_PREP(SPIF_TNM_ADDR_SIZE_V2,
+				   op->addr.nbytes - 1) :
+			FIELD_PREP(SPIF_TNM_ADDR_SIZE_V1,
+				   op->addr.nbytes == 4);
+	}
+	if (op->dummy.nbytes) {
+		dummy_cycles = op->dummy.nbytes * 8 / op->dummy.buswidth;
+		if (op->dummy.dtr)
+			dummy_cycles /= 2;
+
+		desc->phase |= SPIF_PHASE_DUMMY;
+		desc->count |= FIELD_PREP(SPIF_TNM_DUMMY_COUNT,
+					  dummy_cycles);
+	}
+	if (!op->data.nbytes)
+		return;
+
+	command = FIELD_PREP(SPIF_TCS_DATA_WIDTH,
+			     width(op->data.buswidth));
+	desc->command |= command;
+	/* Keep short v1 RX in the known-working eight-byte DMA path. */
+	data_len = !is_v2(spif) && op->data.dir == SPI_MEM_DATA_IN ?
+		max_t(size_t, op->data.nbytes, SPIF_V1_MIN_DMA_RX) :
+		op->data.nbytes;
+	desc->data_len |= is_v2(spif) ?
+		FIELD_PREP(SPIF_DESC_DATA_LEN_V2, data_len) :
+		FIELD_PREP(SPIF_DESC_DATA_LEN_V1, data_len);
+	desc->data_addr = is_v2(spif) ? data_dma >> 2 : data_dma;
+	desc->count |= FIELD_PREP(SPIF_TNM_DATA_COUNT, data_len);
+	if (op->data.dir == SPI_MEM_DATA_IN) {
+		desc->control |= SPIF_DESC_WRITE_TO_RAM;
+		desc->phase |= SPIF_PHASE_RX;
+	} else {
+		desc->phase |= SPIF_PHASE_TX;
+	}
+}
+
+/* A full aligned cache range belongs to the caller; bounce other buffers. */
+static void spif_cache_flush(ulong start, ulong size)
+{
+	if (!CONFIG_IS_ENABLED(SYS_DCACHE_OFF))
+		flush_dcache_range(start, ALIGN(start + size, ARCH_DMA_MINALIGN));
+}
+
+static void spif_cache_invalidate(ulong start, ulong size)
+{
+	if (!CONFIG_IS_ENABLED(SYS_DCACHE_OFF))
+		invalidate_dcache_range(start, ALIGN(start + size, ARCH_DMA_MINALIGN));
+}
+
+int sunxi_spif_exec_op(struct sunxi_spif *spif, const struct spi_mem_op *op)
+{
+	struct sunxi_spif_desc *desc = spif->desc;
+	struct spi_mem_op hwop;
+	bool omit_cmd = false;
+	bool rx = op->data.dir == SPI_MEM_DATA_IN;
+	bool dtr = op->addr.dtr || op->dummy.dtr || op->data.dtr;
+	void *buf = rx ? op->data.buf.in : (void *)op->data.buf.out;
+	void *dma = spif->buffer;
+	bool direct = op->data.nbytes >= 8 && IS_ALIGNED((ulong)buf, 4);
+	u32 val, status;
+	unsigned long rate;
+	int ret;
+
+	if (op->data.nbytes > SUNXI_SPIF_MAX_DATA ||
+	    !sunxi_spif_supports_op(spif, op))
+		return -EOPNOTSUPP;
+	if (!is_v2(spif)) {
+		ret = sunxi_spif_prepare_v1_op(op, &hwop, &omit_cmd);
+		if (ret)
+			return ret;
+		op = &hwop;
+		buf = rx ? op->data.buf.in : (void *)op->data.buf.out;
+		direct = op->data.nbytes >= 8 && IS_ALIGNED((ulong)buf, 4);
+	}
+	if (!CONFIG_IS_ENABLED(SYS_DCACHE_OFF))
+		direct &= IS_ALIGNED((ulong)buf, ARCH_DMA_MINALIGN) &&
+			  IS_ALIGNED(op->data.nbytes, ARCH_DMA_MINALIGN);
+	if (direct)
+		dma = buf;
+	rate = op->max_freq ? min(op->max_freq, spif->max_frequency) :
+		spif->max_frequency;
+	ret = spif->set_clock(spif->clock_priv, rate * (dtr ? 2 : 1));
+	if (ret)
+		return ret;
+	clrsetbits_le32(spif->base + SPIF_TC_REG, SPIF_TC_SCKOUT_SRC_SEL,
+			dtr ? SPIF_TC_SCKOUT_SRC_SEL : 0);
+	clrsetbits_le32(spif->base + SPIF_GC_REG,
+			SPIF_GC_MODE_MASK | SPIF_GC_DTR_EN,
+			(spif->mode & SPI_CPHA ? SPIF_GC_CPHA : 0) |
+			(spif->mode & SPI_CPOL ? SPIF_GC_CPOL : 0) |
+			(dtr ? SPIF_GC_DTR_EN : 0));
+	if (op->data.nbytes) {
+		if (!rx && !direct)
+			memcpy(dma, buf, op->data.nbytes);
+		spif_cache_flush((ulong)dma, !is_v2(spif) && rx ?
+				 max_t(u32, op->data.nbytes, 8) : op->data.nbytes);
+	}
+	sunxi_spif_build_desc(spif, op, (ulong)dma);
+	if (omit_cmd) {
+		desc->phase &= ~SPIF_PHASE_CMD;
+		desc->command &= ~SPIF_TCS_CMD_OPCODE;
+	}
+	setbits_le32(spif->base + SPIF_GCA_REG, SPIF_GCA_RF_RST | SPIF_GCA_WF_RST);
+	if (!is_v2(spif)) {
+		ret = readl_poll_timeout(spif->base + SPIF_GCA_REG, val,
+			!(val & (SPIF_GCA_RF_RST | SPIF_GCA_WF_RST)), SPIF_TIMEOUT_US);
+		if (ret)
+			return ret;
+	}
+	mask_irqs(spif);
+	if (!op->data.nbytes) {
+		clrbits_le32(spif->base + SPIF_GC_REG, SPIF_GC_CFG_MODE);
+		writel(desc->phase, spif->base + SPIF_PHC_REG);
+		writel(desc->flash_addr, spif->base + SPIF_TCF_REG);
+		writel(desc->command, spif->base + SPIF_TCS_REG);
+		writel(desc->count, spif->base + SPIF_TNM_REG);
+		setbits_le32(spif->base + SPIF_GC_REG, SPIF_GC_NMODE_EN);
+		ret = readl_poll_timeout(spif->base + SPIF_GC_REG, val,
+					!(val & SPIF_GC_NMODE_EN), SPIF_TIMEOUT_US);
+	} else {
+		spif_cache_flush((ulong)desc, sizeof(*desc));
+		setbits_le32(spif->base + SPIF_GC_REG, SPIF_GC_CFG_MODE);
+		/* Publish descriptor and TX data before starting the bus master. */
+		mb();
+		writel(is_v2(spif) ? (ulong)desc >> 2 : (ulong)desc, spif->base + SPIF_DSC_REG);
+		writel(sizeof(*desc) << 4 | SPIF_DMA_START, spif->base + SPIF_DMA_CTL_REG);
+		ret = readl_poll_timeout(spif->base + SPIF_INT_STA_REG, status,
+				status & (SPIF_INT_DMA_DONE | SPIF_INT_ERRORS), SPIF_TIMEOUT_US);
+		if (!ret && status & SPIF_INT_ERRORS)
+			ret = -EIO;
+		if (!ret && !rx)
+			ret = readl_poll_timeout(spif->base + SPIF_GC_REG, val,
+					!(val & SPIF_GC_NMODE_EN), SPIF_TIMEOUT_US);
+		mb();
+		if (!ret && rx) {
+			spif_cache_invalidate((ulong)dma, !is_v2(spif) ?
+					      max_t(u32, op->data.nbytes, 8) : op->data.nbytes);
+			if (!direct)
+				memcpy(buf, dma, op->data.nbytes);
+		}
+	}
+	clrbits_le32(spif->base + SPIF_GC_REG, SPIF_GC_DTR_EN);
+	clrbits_le32(spif->base + SPIF_TC_REG, SPIF_TC_SCKOUT_SRC_SEL);
+	mask_irqs(spif);
+	if (ret) {
+		/* Abort a timed-out bus master before the caller reuses its buffer. */
+		writel(0, spif->base + SPIF_DMA_CTL_REG);
+		writel(is_v2(spif) ? SPIF_GCA_RESET : SPIF_GCA_V1_RESET, spif->base + SPIF_GCA_REG);
+		readl_poll_timeout(spif->base + SPIF_GCA_REG, val,
+				   !(val & (is_v2(spif) ? SPIF_GCA_RESET : SPIF_GCA_V1_RESET)), SPIF_TIMEOUT_US);
+	}
+	return ret;
+}
diff --git a/include/sunxi_spif.h b/include/sunxi_spif.h
new file mode 100644
--- /dev/null
+++ b/include/sunxi_spif.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef __SUNXI_SPIF_H
+#define __SUNXI_SPIF_H
+
+#include <linux/types.h>
+#include <spi-mem.h>
+
+#define SUNXI_SPIF_MAX_DATA 4096
+#define SUNXI_SPIF_V1 0x00010000
+#define SUNXI_SPIF_V2 0x00010002
+
+struct sunxi_spif_desc {
+	u32 control, data_len, data_addr, next_desc;
+	u32 phase, flash_addr, command, count;
+};
+
+/* Caller owns DMA-aligned descriptor/buffer and enables clocks and reset.
+ * set_clock receives the module frequency (twice SCK for DTR).
+ * Keep clocks enabled until the operation completes. No DM dependency.
+ */
+struct sunxi_spif {
+	void __iomem *base;
+	struct sunxi_spif_desc *desc;
+	void *buffer;
+	int (*set_clock)(void *priv, unsigned long rate);
+	void *clock_priv;
+	u32 version;
+	u32 max_frequency;
+	u32 mode;
+	u8 sample_mode, sample_delay;
+	bool sample_configured;
+};
+
+int sunxi_spif_init(struct sunxi_spif *spif);
+bool sunxi_spif_supports_op(const struct sunxi_spif *spif,
+			    const struct spi_mem_op *op);
+int sunxi_spif_exec_op(struct sunxi_spif *spif, const struct spi_mem_op *op);
+struct udevice;
+
+/* Optional SPL board setup. Return -ENOSYS to use normal DM resources. */
+int board_sunxi_spif_init(struct udevice *dev, struct sunxi_spif *core);
+
+#endif
diff --git a/dts/upstream/Bindings/spi/allwinner,sun300i-v821-spif.yaml b/dts/upstream/Bindings/spi/allwinner,sun300i-v821-spif.yaml
new file mode 100644
index 00000000..abed958c
--- /dev/null
+++ b/dts/upstream/Bindings/spi/allwinner,sun300i-v821-spif.yaml
@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/spi/allwinner,sun300i-v821-spif.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Allwinner V821 Dedicated SPI Flash Controller
+
+maintainers: []
+
+allOf:
+  - $ref: spi-controller.yaml#
+
+properties:
+  compatible:
+    enum:
+      - allwinner,sun300i-v821-spif
+      - allwinner,sun55i-a523-spif
+      - allwinner,sun8i-v853-spif
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    minItems: 2
+    maxItems: 3
+
+  clock-names:
+    oneOf:
+      - items:
+          - const: ahb
+          - const: mod
+      - items:
+          - const: pclk
+          - const: mclk
+          - const: bus
+
+  allwinner,sample-mode:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 7
+    description: Sampling mode selector
+
+  allwinner,sample-delay:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    maximum: 63
+    description: Sampling delay tap
+
+  resets:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - clocks
+  - clock-names
+  - resets
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    spi@44f00000 {
+        compatible = "allwinner,sun300i-v821-spif";
+        reg = <0 0x44f00000 0 0x1000>;
+        interrupts = <0 19 4>;
+        clocks = <&ccu 11>, <&ccu 3>;
+        clock-names = "ahb", "mod";
+        resets = <&ccu 7>;
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        flash@0 {
+            compatible = "jedec,spi-nor";
+            reg = <0>;
+        };
+    };
