diff --git a/arch/mips/mach-jz47xx/include/mach/x1600.h b/arch/mips/mach-jz47xx/include/mach/x1600.h
new file mode 100644
index 00000000..2a9affda
--- /dev/null
+++ b/arch/mips/mach-jz47xx/include/mach/x1600.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef __MACH_X1600_H
+#define __MACH_X1600_H
+#include <linux/types.h>
+#define X1600_CPM_BASE ((void __iomem *)0xb0000000)
+#define X1600_GPIO_BASE ((void __iomem *)0xb0010000)
+#define X1600_SFC_BASE ((void __iomem *)0xb3440000)
+#define X1600_MPLL_RATE 1400000000UL
+#define X1600_SFC_MAX_HZ 70000000UL
+#define X1600_SFC_CLOCK_DIV 4
+
+ulong x1600_sfc_clk_set_rate(void __iomem *cpm, ulong parent, ulong rate);
+ulong x1600_sfc_clk_get_rate(void __iomem *cpm, ulong parent);
+void x1600_sfc_clk_gate(void __iomem *cpm, bool enable);
+void x1600_sfc_pinmux(void __iomem *gpio);
+#endif
diff --git a/arch/mips/mach-jz47xx/x1600/Makefile b/arch/mips/mach-jz47xx/x1600/Makefile
new file mode 100644
index 00000000..17a975d0
--- /dev/null
+++ b/arch/mips/mach-jz47xx/x1600/Makefile
@@ -0,0 +1,14 @@
