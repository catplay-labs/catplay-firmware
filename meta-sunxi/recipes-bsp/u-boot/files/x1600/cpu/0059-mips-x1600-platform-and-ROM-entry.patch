+endif
diff --git a/arch/mips/mach-jz47xx/x1600/fel-guard.c b/arch/mips/mach-jz47xx/x1600/fel-guard.c
new file mode 100644
index 00000000..665b3986
--- /dev/null
+++ b/arch/mips/mach-jz47xx/x1600/fel-guard.c
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: GPL-2.0+
+#include <x1600_boot.h>
+#include <asm/io.h>
+
+#define CPM_SLPC ((void *)0xb00000cc)
+#define X1600_FEL_REQUEST 0x42575302
+
+/* Only Linux's orderly reboot notifier may replace this request with 0x1. */
+void x1600_usb_guard_arm(void)
+{
+	writel(X1600_FEL_REQUEST, CPM_SLPC);
+	readl(CPM_SLPC);
+}
diff --git a/arch/mips/mach-jz47xx/x1600/rom-return.S b/arch/mips/mach-jz47xx/x1600/rom-return.S
new file mode 100644
index 00000000..866f8142
--- /dev/null
+++ b/arch/mips/mach-jz47xx/x1600/rom-return.S
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#include <asm/regdef.h>
+	.set noreorder
+
+/* Startup-only leaf: call with jalr t8,t9 to retain the ROM's ra. */
+	.globl x1600_stash_rom
+x1600_stash_rom:
+	la t0, x1600_rom_context
+	sw ra, 0(t0)
+	sw sp, 4(t0)
+	sw gp, 8(t0)
+	sw s0, 12(t0)
+	sw s1, 16(t0)
+	sw s2, 20(t0)
+	sw s3, 24(t0)
+	sw s4, 28(t0)
+	sw s5, 32(t0)
+	sw s6, 36(t0)
+	sw s7, 40(t0)
+	sw fp, 44(t0)
+	mfc0 t1, $12
+	sw t1, 48(t0)
+	mfc0 t1, $13
+	sw t1, 52(t0)
+	sync
+	jr t8
+	 nop
+
+/* Restore the ROM ABI, then jump to a0, or return to ROM when a0 is zero. */
+	.globl x1600_unstash_rom
+x1600_unstash_rom:
+	move t9, a0
+	la t0, x1600_rom_context
+	lw ra, 0(t0)
+	lw sp, 4(t0)
+	lw gp, 8(t0)
+	lw s0, 12(t0)
+	lw s1, 16(t0)
+	lw s2, 20(t0)
+	lw s3, 24(t0)
+	lw s4, 28(t0)
+	lw s5, 32(t0)
+	lw s6, 36(t0)
+	lw s7, 40(t0)
+	lw fp, 44(t0)
+	lw t1, 48(t0)
+	mtc0 t1, $12
+	lw t1, 52(t0)
+	mtc0 t1, $13
+	ehb
+	bnez t9, .Ljump
+	 nop
+	move t9, ra
+.Ljump:
+	jr t9
+	 move v0, zero
+
+/* TPL uses ROM cache-as-RAM; .data survives SPL BSS clearing and relocation. */
+	.section .data.x1600_rom_context, "aw", @progbits
+	.balign 32
+	.type x1600_rom_context, @object
+x1600_rom_context:
+	.space 64
+	.size x1600_rom_context, . - x1600_rom_context
diff --git a/arch/mips/mach-jz47xx/x1600/start.S b/arch/mips/mach-jz47xx/x1600/start.S
new file mode 100644
index 00000000..e70b2e56
--- /dev/null
+++ b/arch/mips/mach-jz47xx/x1600/start.S
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#include <config.h>
+#include <asm/regdef.h>
+
+	.set noreorder
+	.globl _start
+_start:
+	la t9, x1600_stash_rom
+	jalr t8, t9
+	 nop
+#ifdef CONFIG_TPL_BUILD
+	/* START1 supplies the ROM stack; reserve its O32 call argument area. */
+	addiu sp, sp, -32
+	jal x1600_tpl_main
+	 nop
+#ifdef CONFIG_X1600_TPL_FLASH
+	/* DDR is ready; use the DRAM stack for the standard TPL framework. */
+	li sp, CONFIG_CUSTOM_SYS_INIT_SP_ADDR - 32
+	move a0, zero
+	move a1, zero
+	jal board_init_r
+	 nop
+#endif
+	j x1600_fel_recover
+	 nop
+#else
+	li sp, CONFIG_CUSTOM_SYS_INIT_SP_ADDR
+	/* BootROM leaves Cause.DC set; Linux needs its CP0 Count enabled. */
+	mtc0 zero, $13
+	ehb
+	jal board_init_f
+	 nop
+	j x1600_fel_recover
+	 nop
+#endif
diff --git a/arch/mips/mach-jz47xx/x1600/usb-tpl.lds b/arch/mips/mach-jz47xx/x1600/usb-tpl.lds
new file mode 100644
index 00000000..83330ffa
--- /dev/null
+++ b/arch/mips/mach-jz47xx/x1600/usb-tpl.lds
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+OUTPUT_ARCH(mips)
+ENTRY(_start)
+SECTIONS {
+	. = CONFIG_TPL_TEXT_BASE;
+	.text : { arch/mips/mach-jz47xx/x1600/start.o(.text*) *(.text*) }
+	.rodata : { *(.rodata*) }
+	.data : { *(.data*) *(.sdata*) }
+	. = ALIGN(8);
+	__u_boot_list : { KEEP(*(SORT(__u_boot_list*))) . = ALIGN(8); }
+	__image_copy_end = .;
+	_image_binary_end = .;
+	.bss (NOLOAD) : { __bss_start = .; *(.bss*) *(.sbss*) *(COMMON) __bss_end = .; }
+	ASSERT(_image_binary_end <= CONFIG_TPL_TEXT_BASE + CONFIG_TPL_MAX_SIZE, "X1600 TPL exceeds NOR payload budget")
+	ASSERT(__bss_end <= 0x80006800, "X1600 USB TPL exceeds 20 KiB cache budget")
+	/DISCARD/ : { *(.MIPS.abiflags) *(.reginfo) *(.comment) *(.note*) *(.eh_frame*) }
+}
