Subject: [PATCH] mips: ingenic: add X1600 platform and returning ROM entry
Upstream-Status: Inappropriate [CatPlay X1600 platform support]

diff --git a/arch/mips/Makefile b/arch/mips/Makefile
index 453c7885..7c1c7576 100644
--- a/arch/mips/Makefile
+++ b/arch/mips/Makefile
@@ -5,6 +5,7 @@ head-y := arch/mips/cpu/start.o
 ifeq ($(CONFIG_XPL_BUILD),y)
 head-$(CONFIG_ARCH_JZ47XX) := arch/mips/mach-jz47xx/start.o
 head-$(CONFIG_SOC_MT7621) := arch/mips/mach-mtmips/mt7621/spl/start.o
+head-$(CONFIG_SOC_X1600) := arch/mips/mach-jz47xx/x1600/start.o
 endif
 
 ifeq ($(CONFIG_TPL_BUILD),y)
diff --git a/arch/mips/cpu/Makefile b/arch/mips/cpu/Makefile
index 6df7bb4e..462e3734 100644
--- a/arch/mips/cpu/Makefile
+++ b/arch/mips/cpu/Makefile
@@ -2,7 +2,9 @@
 
 extra-y	= start.o
 
+ifndef CONFIG_SOC_X1600
 obj-y += time.o
+endif
 obj-y += interrupts.o
 obj-y += cpu.o
 
diff --git a/arch/mips/cpu/start.S b/arch/mips/cpu/start.S
index a95c95bc..d533ef91 100644
--- a/arch/mips/cpu/start.S
+++ b/arch/mips/cpu/start.S
@@ -70,6 +70,12 @@
 	.endm
 
 ENTRY(_start)
+#if defined(CONFIG_TARGET_X1600_AX1800) && !defined(CONFIG_XPL_BUILD)
+	/* Retain the ROM caller before the generic startup resets its ABI. */
+	la t9, x1600_stash_rom
+	jalr t8, t9
+	 nop
+#endif
 	/*
 	 * U-Boot entry point.
 	 * Do not add instructions to the branch delay slot! Some SoC's
diff --git a/arch/mips/mach-jz47xx/Kconfig b/arch/mips/mach-jz47xx/Kconfig
index 858173e7..7aa247f3 100644
--- a/arch/mips/mach-jz47xx/Kconfig
+++ b/arch/mips/mach-jz47xx/Kconfig
@@ -14,6 +14,11 @@ config SOC_JZ4780
 
 choice
 	prompt "Board select"
+	default TARGET_JZ4780_CI20
+
+config TARGET_X1600_AX1800
+	bool "AX1800 X1600 USB recovery"
+	select SOC_X1600
 
 config TARGET_JZ4780_CI20
 	bool "Creator CI20 Reference Board"
@@ -22,5 +27,16 @@ config TARGET_JZ4780_CI20
 endchoice
 
 source "board/imgtec/ci20/Kconfig"
+source "board/ingenic/ax1800/Kconfig"
+
+config SOC_X1600
+	bool
+	select SPL_SPRINTF if SPL
+	select SPL_STRTO if SPL
+	select MIPS_L2_CACHE
+	select SUPPORT_LITTLE_ENDIAN
+	select SUPPORTS_CPU_MIPS32_R2
+	select SUPPORT_TPL
+	select SYS_CACHE_SHIFT_5
 
 endmenu
diff --git a/arch/mips/mach-jz47xx/Makefile b/arch/mips/mach-jz47xx/Makefile
index 5621a09b..fdae4acf 100644
--- a/arch/mips/mach-jz47xx/Makefile
+++ b/arch/mips/mach-jz47xx/Makefile
@@ -1,5 +1,8 @@
 # SPDX-License-Identifier: GPL-2.0+
 
+ifeq ($(CONFIG_SOC_JZ4780),y)
 extra-$(CONFIG_XPL_BUILD)	:= start.o
+endif
 
 obj-$(CONFIG_SOC_JZ4780)	+= jz4780/
