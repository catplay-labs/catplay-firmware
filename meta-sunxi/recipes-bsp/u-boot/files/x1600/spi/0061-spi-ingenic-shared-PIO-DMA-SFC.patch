Subject: [PATCH] spi: ingenic: share polling PIO and DMA SFC between DM and TPL
Upstream-Status: Inappropriate [CatPlay X1600 platform support]

diff --git a/arch/mips/mach-jz47xx/x1600/sfc.c b/arch/mips/mach-jz47xx/x1600/sfc.c
new file mode 100644
index 00000000..d1d0db67
--- /dev/null
+++ b/arch/mips/mach-jz47xx/x1600/sfc.c
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0+
+/* X1600 board clocks and SFC pinmux, shared by TPL and the DM frontend. */
+#include <ingenic_sfc.h>
+#include <asm/io.h>
+#include <linux/bitops.h>
+#include <linux/errno.h>
+#include <linux/iopoll.h>
+#include <linux/kernel.h>
+#include <linux/bitfield.h>
+#include <mach/x1600.h>
+
+#define CPM_CLKGR 0x20
+#define CLKGR_SFC BIT(2)
+#define CPM_SFCCDR 0x74
+#define SFCCDR_BUSY BIT(28)
+#define SFCCDR_CHANGE BIT(29)
+#define SFCCDR_STOP BIT(27)
+#define SFCCDR_MPLL BIT(30)
+#define SFCCDR_SOURCE GENMASK(31, 30)
+#define SFCCDR_DIV GENMASK(7, 0)
+#define GPIO_SHADOW_INT_CLEAR 0x718
+#define GPIO_SHADOW_MASK_CLEAR 0x728
+#define GPIO_SHADOW_PAT1_SET 0x734
+#define GPIO_SHADOW_PAT1_CLEAR 0x738
+#define GPIO_SHADOW_PAT0_CLEAR 0x748
+#define GPIO_SHADOW_LOAD 0x7f0
+#define SFC_DIV_MAX 256
+
+static int sfc_clock_wait(void __iomem *cpm)
+{
+	u32 value;
+
+	return readl_poll_timeout(cpm + CPM_SFCCDR, value,
+				 !(value & SFCCDR_BUSY), 100000);
+}
+
+static void sfc_pins(void __iomem *gpio, u32 mask, u32 bank, bool func2)
+{
+	writel(mask, gpio + GPIO_SHADOW_INT_CLEAR);
+	writel(mask, gpio + GPIO_SHADOW_MASK_CLEAR);
+	writel(mask, gpio +
+	       (func2 ? GPIO_SHADOW_PAT1_SET : GPIO_SHADOW_PAT1_CLEAR));
+	writel(mask, gpio + GPIO_SHADOW_PAT0_CLEAR);
+	writel(bank, gpio + GPIO_SHADOW_LOAD);
+}
+
+void x1600_sfc_pinmux(void __iomem *gpio)
+{
+	/* Linux's X1600 sfc group: PC17..22 function0, PB4 function2. */
+	sfc_pins(gpio, GENMASK(22, 17), 2, false);
+	sfc_pins(gpio, BIT(4), 1, true);
+}
+
+void x1600_sfc_clk_gate(void __iomem *cpm, bool enable)
+{
+	if (enable)
+		clrbits_le32(cpm + CPM_CLKGR, CLKGR_SFC);
+	else
+		setbits_le32(cpm + CPM_CLKGR, CLKGR_SFC);
+}
+
+ulong x1600_sfc_clk_get_rate(void __iomem *cpm, ulong parent)
+{
+	u32 reg = readl(cpm + CPM_SFCCDR);
+
+	if ((reg & SFCCDR_SOURCE) != SFCCDR_MPLL)
+		return -EINVAL;
+	return parent / (FIELD_GET(SFCCDR_DIV, reg) + 1);
+}
+
+ulong x1600_sfc_clk_set_rate(void __iomem *cpm, ulong parent, ulong rate)
+{
+	u32 div;
+	int ret;
+
+	if (!rate || !parent || rate > X1600_SFC_MAX_HZ * X1600_SFC_CLOCK_DIV)
+		return -EINVAL;
+	div = DIV_ROUND_UP(parent, rate);
+	if (!div || div > SFC_DIV_MAX)
+		return -EINVAL;
+	setbits_le32(cpm + CPM_SFCCDR, SFCCDR_CHANGE | SFCCDR_STOP);
+	ret = sfc_clock_wait(cpm);
+	if (ret)
+		return ret;
+	writel(SFCCDR_MPLL | SFCCDR_CHANGE | FIELD_PREP(SFCCDR_DIV, div - 1),
+	       cpm + CPM_SFCCDR);
+	ret = sfc_clock_wait(cpm);
+	if (ret)
+		return ret;
+	return x1600_sfc_clk_get_rate(cpm, parent);
+}
+
+#ifdef CONFIG_TPL_BUILD
+int x1600_sfc_setup(struct ingenic_sfc *sfc, ulong hz)
+{
+	long rate;
+
+	if (!hz || hz > X1600_SFC_MAX_HZ)
+		return -EINVAL;
+	x1600_sfc_clk_gate(X1600_CPM_BASE, true);
+	rate = x1600_sfc_clk_set_rate(X1600_CPM_BASE, X1600_MPLL_RATE,
+				       hz * X1600_SFC_CLOCK_DIV);
+	if (rate < 0)
+		return rate;
+	x1600_sfc_pinmux(X1600_GPIO_BASE);
+	ingenic_sfc_reset(sfc, rate);
+	return 0;
+}
+#endif
