Date: Sun, 18 Oct 2026 15:30:25 +0200
Subject: [PATCH] sunxi: add optional SPI NAND SPL image loader

Upstream-Status: Inappropriate [proof of concept]
---
diff --git a/arch/arm/mach-sunxi/Kconfig b/arch/arm/mach-sunxi/Kconfig
index 37907244..95e62eb2 100644
--- a/arch/arm/mach-sunxi/Kconfig
+++ b/arch/arm/mach-sunxi/Kconfig
@@ -1315,6 +1315,141 @@ config SPL_SPI_SUNXI
 	  sunxi SPI Flash. It uses the same method as the boot ROM, so does
 	  not need any extra configuration.
 
+config SPL_SUNXI_SPI_NAND
+	bool "Load U-Boot from SPI NAND with the sunxi SPL SPI0 controller"
+	depends on SPL && SUNXI_GEN_NCAT2 && !SPL_SPI_SUNXI && !SPL_DM_SPI
+	select SPL_MTD_SPI_NAND
+	help
+	  Use the small sunxi SPI0 controller path and the non-DM SPI NAND
+	  reader to load a FIT or uncompressed legacy image. The image
+	  starts at logical offset zero in a bounded region; bad physical blocks
+	  are skipped.
+	  The flash writer must use the same region and skip rule. This option
+	  replaces the SRAM FIT handoff when the boot source is SPI or NAND.
+
+if SPL_SUNXI_SPI_NAND
+
+config SPL_SUNXI_SPI_NAND_QUAD
+	bool "Use quad-output cache reads in sunxi SPI NAND SPL"
+	depends on MACH_SUN8I_V851S
+	help
+	  Enable the matched GD5F1GM7RExxG chip's QE bit and use the 0x6b
+	  (1-1-4) cache-read command. ID, feature and status commands stay
+	  on one data line. Restore the original QE setting before handoff.
+
+config SPL_SUNXI_SPI_NAND_IO_CHUNK
+	int "Maximum SPI NAND cache-read data bytes per transaction"
+	range 1 2048
+	default 60
+	help
+	  The SPI0 PIO reader drains its 64-byte RX FIFO while a transfer is
+	  active, so a transaction may cover a full NAND page. Choose a value
+	  validated at the selected SPI clock. RX FIFO overflow is fatal.
+
+config SPL_SUNXI_SPI_NAND_BENCH_RTC
+	bool "Record SPL SPI NAND load time in V851S RTC GP7"
+	depends on MACH_SUN8I_V851S
+	help
+	  Diagnostic option. Store the elapsed milliseconds from SPI0 init
+	  through image load in RTC GP7 (0x0709011c). GP3/GP4 hold total
+	  NAND-read and page-load microseconds; GP5/GP6 hold cache-read
+	  and other SPI transaction microseconds.
+	  GP2 remains reserved for FEL. Leave disabled in production images.
+
+config SPL_SUNXI_SPI_NAND_CLOCK_HZ
+	int "V851S SPL SPI NAND clock ceiling in Hz"
+	depends on MACH_SUN8I_V851S
+	range 1000000 300000000
+	default 24000000
+	help
+	  Use OSC24M by default. For another requested rate, select the
+	  fastest SPI0 parent/divider combination that does not exceed it.
+	  PLL_PERIPH0 is initialized before the SPI NAND loader runs.
+
+config SPL_SUNXI_SPI_NAND_SAMPLING
+	bool "Configure V851S SPL SPI NAND sampling"
+	depends on MACH_SUN8I_V851S
+	help
+	  Enable both sampling controls below. When disabled, leave the SPI0
+	  sampling registers at their existing settings.
+
+config SPL_SUNXI_SPI_NAND_SAMPLE_MODE
+	int "V851S SPL SPI NAND sample mode"
+	depends on SPL_SUNXI_SPI_NAND_SAMPLING
+	range 0 6
+	default 1
+	help
+	  Use the same 0..6 mode encoding as allwinner,sample-mode in the
+	  U-Boot SPI controller device tree.
+
+config SPL_SUNXI_SPI_NAND_SAMPLE_DELAY
+	int "V851S SPL SPI NAND sample delay"
+	depends on SPL_SUNXI_SPI_NAND_SAMPLING
+	range 0 63
+	default 0
+	help
+	  Use the same 0..63 delay encoding as allwinner,sample-delay in the
+	  U-Boot SPI controller device tree.
+
+config SPL_SUNXI_SPI_NAND_MFR
+	hex "SPI NAND manufacturer ID after 9f 00"
+	default 0x0
+	help
+	  Must be set to the ID returned by the target chip. Zero is rejected.
+
+config SPL_SUNXI_SPI_NAND_DEVID
+	hex "SPI NAND device ID after 9f 00"
+	default 0x0
+	help
+	  Must be set to the ID returned by the target chip. Zero is rejected.
+
+config SPL_SUNXI_SPI_NAND_PAGE_SIZE
+	int "SPI NAND data bytes per page"
+	default 2048
+
+config SPL_SUNXI_SPI_NAND_OOB_SIZE
+	int "SPI NAND OOB bytes per page"
+	default 64
+
+config SPL_SUNXI_SPI_NAND_PAGES_PER_BLOCK
+	int "SPI NAND pages per erase block"
+	default 64
+
+config SPL_SUNXI_SPI_NAND_PAGE_COUNT
+	int "SPI NAND total physical pages"
+	default 65536
+
+config SPL_SUNXI_SPI_NAND_FIRST_BLOCK
+	int "First physical erase block of the logical SPI NAND address space"
+	default 0
+	help
+	  Logical offsets are measured from the first good block at or after
+	  this block. IMAGE_OFFSET selects the payload within this space.
+
+config SPL_SUNXI_SPI_NAND_BLOCK_COUNT
+	int "Number of physical erase blocks in the logical SPI NAND address space"
+	default 0
+	help
+	  Zero is rejected at runtime. Include blocks before IMAGE_OFFSET and
+	  enough bad-block headroom for the payload without crossing its slot.
+
+config SPL_SUNXI_SPI_NAND_IMAGE_OFFSET
+	hex "Logical byte offset of the U-Boot image in the SPI NAND region"
+	default 0x0
+	help
+	  Count only good blocks from FIRST_BLOCK. The image writer must use
+	  the same bad-block mapping when placing the image.
+
+config SPL_SUNXI_SPI_NAND_ECC_MASK
+	hex "SPI NAND ECC status mask"
+	default 0x30
+
+config SPL_SUNXI_SPI_NAND_ECC_UNCORRECTABLE
+	hex "SPI NAND uncorrectable ECC status value"
+	default 0x20
+
+endif # SPL_SUNXI_SPI_NAND
+
 config PINE64_DT_SELECTION
 	bool "Enable Pine64 device tree selection code"
 	depends on MACH_SUN50I
diff --git a/arch/arm/mach-sunxi/Makefile b/arch/arm/mach-sunxi/Makefile
