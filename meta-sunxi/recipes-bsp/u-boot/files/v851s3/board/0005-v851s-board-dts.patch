Subject: [PATCH] arm: dts: add Wooboobox T2 V851S board
Upstream-Status: Inappropriate [CatPlay V851S board port]

---
diff --git a/arch/arm/dts/Makefile b/arch/arm/dts/Makefile
index 2b65cd91..41bbee7f 100644
--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -629,6 +629,8 @@ dtb-$(CONFIG_MACH_SUN8I_R40) += \
 	sun8i-r40-oka40i-c.dtb \
 	sun8i-t3-cqa3t-bv3.dtb \
 	sun8i-v40-bananapi-m2-berry.dtb
+dtb-$(CONFIG_MACH_SUN8I_V851S) += \
+	sun8i-v851s-wooboobox-t2.dtb
 dtb-$(CONFIG_MACH_SUN50I_H5) += \
 	sun50i-h5-bananapi-m2-plus.dtb \
 	sun50i-h5-emlid-neutis-n5-devboard.dtb \
