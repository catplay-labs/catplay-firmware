# FEL writes the complete eGON at 0x28000; the ARM branch in its 96-byte
# header enters the SPL at 0x28060. Keep the image inside SRAM below 0x40000.
CONFIG_SPL_TEXT_BASE=0x28060
CONFIG_SPL_MAX_SIZE=0x17fa0
CONFIG_SPL_SIZE_LIMIT=0x17fa0
CONFIG_EGON_MAX_SIZE=0x18000
CONFIG_SPL_SUNXI_FORCE_BOOT_DEVICE=y
CONFIG_SPL_SUNXI_FORCE_BOOT_DEVICE_BOARD=y
