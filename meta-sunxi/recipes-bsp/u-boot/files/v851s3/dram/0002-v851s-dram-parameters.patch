Date: Sun, 18 Oct 2026 15:04:12 +0200
Subject: [PATCH 02/15] ram: sunxi: support configurable V851S DRAM parameters
Upstream-Status: Inappropriate [CatPlay V851S board port]

---
 drivers/ram/sunxi/Kconfig          |   69 +-
 drivers/ram/sunxi/dram_sun20i_d1.c | 1479 +++++++++++++++-------------
 drivers/ram/sunxi/dram_sun20i_d1.h |  210 +++-
 3 files changed, 1010 insertions(+), 748 deletions(-)

diff --git a/drivers/ram/sunxi/Kconfig b/drivers/ram/sunxi/Kconfig
index 1775cb0d78..fcf35477f0 100644
--- a/drivers/ram/sunxi/Kconfig
+++ b/drivers/ram/sunxi/Kconfig
@@ -12,10 +12,45 @@ config DRAM_SUNXI_ODT_EN
 	help
 	  ODT EN value from vendor DRAM settings.
 
-config DRAM_SUNXI_TPR0
-	hex "DRAM TPR0 parameter"
+config DRAM_SUNXI_PARA2
+	hex "DRAM PARA2 parameter"
+	default 0
 	help
-	  TPR0 value from vendor DRAM settings.
+	  PARA2 value from vendor DRAM settings.
+
+config DRAM_SUNXI_PARA1
+	hex "DRAM PARA1 parameter"
+	help
+	  PARA1 value from vendor DRAM settings.
+
+config DRAM_SUNXI_MR0
+	hex "DRAM MR0 parameter"
+	default 0
+	help
+	  MR0 value from vendor DRAM settings.
+
+config DRAM_SUNXI_MR1
+	hex "DRAM MR1 parameter"
+	help
+	  MR1 value from vendor DRAM settings.
+
+config DRAM_SUNXI_MR2
+	hex "DRAM MR2 parameter"
+	default 0
+	help
+	  MR2 value from vendor DRAM settings.
+
+config DRAM_SUNXI_TPR4
+	hex "DRAM TPR4 parameter"
+	default 0
+	help
+	  TPR4 value from vendor DRAM settings.
+
+config DRAM_SUNXI_TPR7
+	hex "DRAM TPR7 parameter"
+	default 0
+	help
+	  TPR7 value from vendor DRAM settings.
 
 config DRAM_SUNXI_TPR11
 	hex "DRAM TPR11 parameter"
@@ -58,3 +93,31 @@ config SUNXI_DRAM_TYPE
 	default 7 if SUNXI_DRAM_TYPE_LPDDR3
 
 endif
+
+# Shared TPR fields are also used by the D1-compatible V851S controller.
+if DRAM_SUN20I_D1 || DRAM_SUN50I_H616 || DRAM_SUN50I_A133 || DRAM_SUN55I_A523
+config DRAM_SUNXI_TPR0
+	hex "DRAM TPR0 parameter"
+	default 0x0
+	help
+	  TPR0 value from vendor DRAM settings.
+
+config DRAM_SUNXI_TPR1
+	hex "DRAM TPR1 parameter"
+	default 0x0
+	help
+	  TPR1 value from vendor DRAM settings.
+
+config DRAM_SUNXI_TPR2
+	hex "DRAM TPR2 parameter"
+	default 0x0
+	help
+	  TPR2 value from vendor DRAM settings.
+
+config DRAM_SUNXI_TPR3
+	hex "DRAM TPR3 parameter"
+	default 0x0
+	help
+	  TPR3 value from vendor DRAM settings.
+
+endif
