# FEL SPL: initialize DRAM on A27, then return to BootROM.
CONFIG_SPL_SYS_MALLOC_F_LEN=0x1000
CONFIG_SPL_STACK=0x0201c000
CONFIG_SPL_TEXT_BASE=0x02008060
CONFIG_SPL_BSS_START_ADDR=0x02010000
CONFIG_SPL_BSS_MAX_SIZE=0x1000
CONFIG_SPL_MAX_SIZE=0x7fa0
CONFIG_WOOBOOBOX_V821B_SPL_FORCE_FEL=y
CONFIG_STACK_SIZE_SHIFT=12
CONFIG_SPL_PAD_TO=0x8000
CONFIG_EGON_MAX_SIZE=0x8000
# CONFIG_SPL_GZIP is not set
# CONFIG_SPL_STACK_R is not set
# CONFIG_SPL_FIT is not set
# CONFIG_SPL_LOAD_FIT is not set

# CONFIG_SPL_RAM_DEVICE is not set
CONFIG_SUNXI_FEL_STASH=y

# DRAM-only helper returns to ROM without loading from SPI.
# CONFIG_SPL_SPI is not set
# CONFIG_SPL_SPI_SUNXI_SPIF is not set
