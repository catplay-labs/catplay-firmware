Subject: [PATCH] clk: sunxi: add V821 clock and reset controller

Upstream-Status: Inappropriate [CatPlay V821 port]

diff --git a/arch/riscv/include/asm/arch-sunxi/clock.h b/arch/riscv/include/asm/arch-sunxi/clock.h
--- /dev/null
+++ b/arch/riscv/include/asm/arch-sunxi/clock.h
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef _ASM_ARCH_SUNXI_CLOCK_H
+#define _ASM_ARCH_SUNXI_CLOCK_H
+
+#include <asm/io.h>
+#include <asm/arch-sunxi/cpu.h>
+#include <linux/bitops.h>
+#include <linux/kernel.h>
+
+#define SUNXI_CCU_PLL_PERI_CTRL0	0x0010
+#define SUNXI_CCU_MMC0_CLK		0x0014
+#define SUNXI_CCU_SPI0_CLK		0x001c
+#define SUNXI_CCU_SPIF_CLK		0x0020
+#define SUNXI_CCU_BUS_GATE0		0x0080
+#define SUNXI_CCU_BUS_GATE1		0x0084
+#define SUNXI_CCU_BUS_RST0		0x0090
+#define SUNXI_CCU_BUS_RST1		0x0094
+
+#define CCM_SPIF_CTRL_ENABLE		BIT(31)
+#define CCM_SPIF_CTRL_SRC_MASK		GENMASK(25, 24)
+#define CCM_SPIF_CTRL_PLL_PERI_384M	(2U << 24)
+#define CCM_SPIF_CTRL_N_MASK		GENMASK(17, 16)
+#define CCM_SPIF_CTRL_N(x)		((x) << 16)
+#define CCM_SPIF_CTRL_M_MASK		GENMASK(3, 0)
+#define CCM_SPIF_CTRL_M(x)		((x) - 1)
+#define CCM_BUS_GATE1_SPIF		BIT(5)
+#define CCM_BUS_RST1_SPIF		BIT(5)
+
+/* Shared by the DM clock driver and SPL's board-managed SPIF setup. */
+static inline unsigned long clock_set_spif_rate(void __iomem *ccu,
+					       unsigned long rate)
+{
+	u32 best = 0;
+	unsigned long best_rate = 0;
+	unsigned int n;
+
+	if (!rate)
+		return 0;
+	for (n = 0; n < 4; n++) {
+		unsigned long parent = 384000000UL >> n;
+		u32 m = DIV_ROUND_UP(parent, rate);
+		unsigned long actual;
+
+		if (!m || m > 16)
+			continue;
+		actual = parent / m;
+		if (actual > rate)
+			continue;
+		if (!best || actual > best_rate) {
+			best = CCM_SPIF_CTRL_PLL_PERI_384M |
+			       CCM_SPIF_CTRL_N(n) | CCM_SPIF_CTRL_M(m);
+			best_rate = actual;
+		}
+	}
+	if (best_rate)
+		clrsetbits_le32(ccu + SUNXI_CCU_SPIF_CLK,
+			       CCM_SPIF_CTRL_SRC_MASK | CCM_SPIF_CTRL_N_MASK |
+			       CCM_SPIF_CTRL_M_MASK, best);
+	return best_rate;
+}
+
+#define CCM_MMC_CTRL_OSCM24		(0 << 24)
+#define CCM_MMC_CTRL_PLL6		BIT(24)
+#define CCM_MMC_CTRL_ENABLE		BIT(31)
+#define CCM_MMC_CTRL_N(x)		((x) << 16)
+#define CCM_MMC_CTRL_M(x)		((x) - 1)
+#define CCM_MMC_CTRL_OCLK_DLY(x)	((void)(x), 0)
+#define CCM_MMC_CTRL_SCLK_DLY(x)	((void)(x), 0)
+
+static inline unsigned int clock_get_pll6(void)
+{
+	u32 val = readl((void __iomem *)SUNXI_CCU_APP_BASE +
+			SUNXI_CCU_PLL_PERI_CTRL0);
+	unsigned int n = (val >> 8) & 0xff;
+	unsigned int m = val & 0x7;
+
+	return 48000000 * 2 * (n + 1) / (m + 1);
+}
+
+#endif
