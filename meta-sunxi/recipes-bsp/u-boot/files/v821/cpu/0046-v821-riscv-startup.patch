Subject: [PATCH] riscv: add V821 E907 to A27 startup and SPL layout

Upstream-Status: Inappropriate [CatPlay V821 port]

diff --git a/arch/riscv/cpu/Makefile b/arch/riscv/cpu/Makefile
--- a/arch/riscv/cpu/Makefile
+++ b/arch/riscv/cpu/Makefile
@@ -5,3 +5,4 @@
 extra-y = start.o
 
 obj-y += cpu.o mtrap.o
+obj-$(CONFIG_MACH_SUN300I_V821) += sunxi/
diff --git a/arch/riscv/cpu/start.S b/arch/riscv/cpu/start.S
--- a/arch/riscv/cpu/start.S
+++ b/arch/riscv/cpu/start.S
@@ -39,8 +39,12 @@ secondary_harts_relocation_error:
 .section .text
 .globl _start
 _start:
+#ifdef CONFIG_MACH_SUN300I_V821
+#include "sunxi/start.S"
+#else
 #if CONFIG_IS_ENABLED(RISCV_MMODE)
 	csrr	a0, CSR_MHARTID
+#endif
 #endif
 
 	/*
diff --git a/arch/riscv/cpu/sunxi/start.S b/arch/riscv/cpu/sunxi/start.S
new file mode 100644
--- /dev/null
+++ b/arch/riscv/cpu/sunxi/start.S
@@ -0,0 +1,176 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/* V821 E907-to-A27 entry, included in place by start.S. */
+
+/* Vendor CSR layouts differ between E907 and A27. */
+.set E907_CSR_MHCR, 0x7c1
+.set A27_CSR_MXSTATUS, 0x7c4
+
+/* MMIO addresses and offsets used by the E907-to-A27 handoff. */
+.set SUNXI_POWERCTRL_AON_BASE, 0x4a011000
+.set SUNXI_CPUX_POWER_OFFSET, 0x64
+.set SUNXI_CCU_AON_BASE, 0x4a010000
+.set SUNXI_A27L2_CLK_OFFSET, 0x588
+.set SUNXI_E907_CLK_OFFSET, 0x584
+.set SUNXI_CCU_APP_BASE, 0x42001000
+.set SUNXI_A27_PLMT_CLK_OFFSET, 0x10
+.set SUNXI_CPUX_AXI_CLK_OFFSET, 0x7c
+.set SUNXI_CPUX_RESET_OFFSET, 0x94
+.set SUNXI_CPUX_WDT_RESET_OFFSET, 0x98
+.set SUNXI_E907_RESET_REG, 0x4200109c
+.set SUNXI_E907_RESET_KEY, 0xa5690000
+.set SUNXI_CPUCFG_BASE, 0x49100000
+.set SUNXI_CPUX_START_ADDR_OFFSET, 0x204
+.set SUNXI_CPUX_WFI_MODE_OFFSET, 0x4
+
+/* Control bits used during the handoff. */
+.set V821_MSTATUS_MIE, 1 << 3
+.set E907_MHCR_HANDOFF_DISABLE_MASK, 0x103f
+.set A27_MXSTATUS_ISA_EXT_ENABLE, 1 << 22
+.set SUNXI_CPUX_POWER_ENABLE, 1 << 8
+.set SUNXI_CPU_CLK_ENABLE, 1 << 31
+.set SUNXI_CPUX_AXI_DIV_MASK, 3 << 8
+.set SUNXI_CPUX_AXI_DIV2, 1 << 8
+.set SUNXI_CPUX_CFG_MSGBOX_CLK_ENABLE, (1 << 7) | (1 << 6)
+.set SUNXI_CPUX_WDT_RESET_DEASSERT, 1 << 2
+.set SUNXI_CPUX_CFG_MSGBOX_RESET_DEASSERT, (1 << 28) | (1 << 27)
+.set SUNXI_CPUX_RESET_DEASSERT, 1 << 26
+
+#if defined(CONFIG_XPL_BUILD) && defined(CONFIG_SUNXI_FEL_STASH)
+	.option push
+	.option norvc
+	j save_boot_params
+.globl save_boot_params_ret
+	.option pop
+save_boot_params_ret:
+#endif
+#if CONFIG_IS_ENABLED(RISCV_MMODE)
+#ifndef CONFIG_XPL_BUILD
+	/* FEL SPL left A27 parked; assert CPU-only reset before relaunch. */
+	li t0, SUNXI_CCU_APP_BASE + SUNXI_CPUX_RESET_OFFSET
+	lw t1, 0(t0)
+	li t2, ~SUNXI_CPUX_RESET_DEASSERT
+	and t1, t1, t2
+	sw t1, 0(t0)
+	fence iorw, iorw
+#endif
+	.option push
+	.option norvc
+	.option norelax
+/* Keep the validated full-width instruction spacing on both CPUs. */
+	.macro v821_handoff_sync
+	.option push
+	.option norvc
+	.rept 8
+	nop
+	.endr
+	fence iorw, iorw
+	.option pop
+	.endm
+v821_boot_switch:
+/*
+ * Follow sun300iw1p1/e907_boot/boot0_main.c in Brandy. In particular,
+ * power and clock CPUX before accessing its configuration/mailbox domain.
+ * FEL can leave a different initial state from a BootROM NOR boot.
+ *
+ * Use PC-relative relocation instead of a fixed trampoline size. The FEL
+ * context-save jump and proper's CPU-only reset may precede this code.
+ * All instructions before a27_start use the base RV32 ISA and numeric CSRs.
+ */
+	v821_handoff_sync
+	lla a1, a27_start
+	li a2, V821_MSTATUS_MIE
+	csrc mstatus, a2
+
+	/* POWERCTRL_AON: request CPUX power. */
+	li a4, SUNXI_POWERCTRL_AON_BASE
+	lw a3, SUNXI_CPUX_POWER_OFFSET(a4)
+	ori a3, a3, SUNXI_CPUX_POWER_ENABLE
+	sw a3, SUNXI_CPUX_POWER_OFFSET(a4)
+
+	/* CPUX starts from HOSC; PLMT must run before any C timer/udelay use. */
+	li a5, SUNXI_CCU_AON_BASE
+	li a3, SUNXI_CPU_CLK_ENABLE
+	sw a3, SUNXI_A27L2_CLK_OFFSET(a5)
+	li a4, SUNXI_CCU_APP_BASE
+	/* PLMT: select 40 MHz HOSC and enable its gate, independent of UART. */
+	sw a3, SUNXI_A27_PLMT_CLK_OFFSET(a4)
+
+	/* CPUX AXI divide-by-two and msgbox/config bus clocks. */
+	lw a3, SUNXI_CPUX_AXI_CLK_OFFSET(a4)
+	andi a3, a3, ~SUNXI_CPUX_AXI_DIV_MASK
+	ori a3, a3, SUNXI_CPUX_AXI_DIV2 | SUNXI_CPUX_CFG_MSGBOX_CLK_ENABLE
+	sw a3, SUNXI_CPUX_AXI_CLK_OFFSET(a4)
+
+	/* Disable E907 caches and select HOSC, as in the vendor handoff. */
+	li a2, E907_MHCR_HANDOFF_DISABLE_MASK
+	csrc E907_CSR_MHCR, a2
+	sw zero, SUNXI_E907_CLK_OFFSET(a5)
+
+	/* Allow CPUX/AXI clocks to settle with E907 running from HOSC. */
+	fence iorw, iorw
+	li t0, 64
+.Lv821_clock_settle:
+	addi t0, t0, -1
+	bnez t0, .Lv821_clock_settle
+
+	/* Preserve the existing CPUX watchdog reset deassertion. */
+	lw a3, SUNXI_CPUX_WDT_RESET_OFFSET(a4)
+	ori a3, a3, SUNXI_CPUX_WDT_RESET_DEASSERT
+	sw a3, SUNXI_CPUX_WDT_RESET_OFFSET(a4)
+	/* Release msgbox/config reset only after their clocks are running. */
+	lw a3, SUNXI_CPUX_RESET_OFFSET(a4)
+	li a2, SUNXI_CPUX_CFG_MSGBOX_RESET_DEASSERT
+	or a3, a3, a2
+	sw a3, SUNXI_CPUX_RESET_OFFSET(a4)
+	fence iorw, iorw
+
+	/* Publish A27 entry and clear CPUX WFI mode before CPU release. */
+	li a5, SUNXI_CPUCFG_BASE
+	sw a1, SUNXI_CPUX_START_ADDR_OFFSET(a5)
+	sw zero, SUNXI_CPUX_WFI_MODE_OFFSET(a5)
+	fence iorw, iorw
+	v821_handoff_sync
+1:
+	lw a3, SUNXI_CPUX_START_ADDR_OFFSET(a5)
+	beqz a3, 1b
+	v821_handoff_sync
+	lw a3, SUNXI_CPUX_RESET_OFFSET(a4)
+	li a2, SUNXI_CPUX_RESET_DEASSERT
+	or a3, a3, a2
+	sw a3, SUNXI_CPUX_RESET_OFFSET(a4)
+	fence iorw, iorw
+	j v821_e907_park
+
+	.option pop
+.globl a27_start
+a27_start:
+	v821_handoff_sync
+	.purgem v821_handoff_sync
+	/* A27 owns execution now; E907 must not fetch reclaimed memory. */
+	li t0, SUNXI_E907_RESET_REG
+	li t1, SUNXI_E907_RESET_KEY
+	sw t1, 0(t0)
+	fence iorw, iorw
+	/* The A27 needs the vendor ISA-extension window before C code. */
+	csrw	MODE_PREFIX(ie), zero
+	li	t1, A27_MXSTATUS_ISA_EXT_ENABLE
+	csrs	A27_CSR_MXSTATUS, t1
+	fence.i
+	li	a0, 0
+	li	a1, 0
+
+/* Keep E907 clocked until A27 asserts reset; WFI can gate its clock. */
+.pushsection .text.v821_e907_park, "ax"
+.option push
+.option norvc
+.option norelax
+.balign 4
+.globl v821_e907_park
+.type v821_e907_park, @function
+v821_e907_park:
+.Lv821_e907_park:
+	j .Lv821_e907_park
+.size v821_e907_park, . - v821_e907_park
+.option pop
+.popsection
+#endif
