diff --git a/arch/riscv/cpu/sunxi/fel.S b/arch/riscv/cpu/sunxi/fel.S
new file mode 100644
--- /dev/null
+++ b/arch/riscv/cpu/sunxi/fel.S
@@ -0,0 +1,413 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#if defined(CONFIG_XPL_BUILD) && defined(CONFIG_SUNXI_FEL_STASH)
+
+/* CSR numbers and cache commands are local to their executing core. */
+.set E907_CSR_MTVT, 0x307
+.set E907_CSR_MINTSTATUS, 0x346
+.set E907_CSR_MXSTATUS, 0x7c0
+.set E907_CSR_MHCR, 0x7c1
+.set E907_CSR_MHINT, 0x7c5
+.set E907_CSR_MEXSTATUS, 0x7e1
+.set A27_CSR_MCACHE_CTL, 0x7ca
+.set A27_CSR_UCCTLCOMMAND, 0x80c
+.set A27_CCTL_L1D_WBINVAL_ALL, 6
+
+/* E907 timer and PRCM BootROM redirect registers. */
+.set SUNXI_E907_CLK_REG, 0x4a010584
+.set E907_SYSMAP_BASE, 0x3ffff000
+.set E907_SYSMAP_WORDS, 16
+.set E907_MTIMECMP_ADDR, 0x30004000
+.set SUNXI_PRCM_BOOT_MODE_REG, 0x4a0001c0
+.set SUNXI_PRCM_BOOT_ADDR_REG, 0x4a0001c4
+.set SUNXI_PRCM_BOOT_MODE_KEY, 0x429b0000
+
+/* Keep the MTIME read base page-aligned to preserve the single-LUI load. */
+.set E907_MTIME_ADDR, 0x3000bff8
+.set E907_MTIME_READ_BASE, E907_MTIME_ADDR + 8
+.set E907_MTIME_LO_OFFSET, E907_MTIME_ADDR - E907_MTIME_READ_BASE
+.set E907_MTIME_HI_OFFSET, E907_MTIME_LO_OFFSET + 4
+.set E907_CLIC_BASE, 0x30800000
+.set E907_CLIC_CFG_OFFSET, 0x0
+.set E907_CLIC_INFO_OFFSET, 0x4
+.set E907_CLIC_THRESH_OFFSET, 0x8
+.set E907_CLIC_INTIE_BASE, E907_CLIC_BASE + 0x1001
+.set E907_CLIC_INTIE_OFFSET, 0x0
+.set E907_CLIC_INTATTR_OFFSET, 0x1
+.set E907_CLIC_INTCTL_OFFSET, 0x2
+.set E907_CLIC_IRQ_STRIDE, 0x4
+.set SUNXI_E907_RESET_REG, 0x4200109c
+.set SUNXI_E907_RESET_KEY, 0xa5690000
+
+/* Interrupt, cache and ROM redirect control fields. */
+.set A27_MCACHE_CTL_ICACHE_ENABLE, 1 << 0
+.set A27_MCACHE_CTL_DCACHE_ENABLE, 1 << 1
+.set V821_MSTATUS_MIE, 1 << 3
+.set E907_MHCR_HANDOFF_DISABLE_MASK, 0x103f
+.set E907_CLIC_INFO_NUM_INTERRUPTS_MASK, (1 << 13) - 1
+.set E907_MINTSTATUS_MIL_SHIFT, 24
+.set E907_MCAUSE_MPIL_SHIFT, 16
+.set E907_MCAUSE_INTERRUPT, 1 << 31
+.set E907_MCAUSE_MPP_M, 3 << 28
+.set E907_MTIMECMP_LO_SAFE, -1
+.set SUNXI_PRCM_BOOT_MODE_KEY_SHIFT, 16
+.set SUNXI_PRCM_BOOT_MODE_MASK, 0xf
+.set SUNXI_PRCM_BOOT_MODE_RESUME, 1
+.set SUNXI_E907_RESET_DEASSERT, 1 << 0
+.set E907_INSN_DCACHE_CIALL, 0x0030000b
+.set E907_INSN_DCACHE_IALL, 0x0020000b
+.set E907_INSN_ICACHE_IALL, 0x0100000b
+.set E907_INSN_TH_SYNC, 0x0180000b
+
+/* A27 is hart0; both Andes L2 register layouts use these hart0 offsets. */
+.set A27_L2_BASE, 0x49000000
+.set A27_L2_CONTROL_OFFSET, 0x08
+.set A27_L2_COMMAND_HART0_OFFSET, 0x40
+.set A27_L2_STATUS_HART0_OFFSET, 0x80
+.set A27_L2_ENABLE, 1 << 0
+.set A27_L2_WBINVAL_ALL, 0x12
+.set A27_L2_STATUS_HART0_MASK, 0xf
+
+/* E907 state belongs to the interrupted BootROM call, not to A27. */
+.set FEL_STASH_MSTATUS, 64
+.set FEL_STASH_MIE, 68
+.set FEL_STASH_MTVEC, 72
+.set FEL_STASH_MTVT, 76
+.set FEL_STASH_MSCRATCH, 80
+.set FEL_STASH_MEPC, 84
+.set FEL_STASH_MCAUSE, 88
+.set FEL_STASH_MTVAL, 92
+.set FEL_STASH_MXSTATUS, 96
+.set FEL_STASH_MHCR, 100
+.set FEL_STASH_MHINT, 104
+.set FEL_STASH_MEXSTATUS, 108
+.set FEL_STASH_BOOT_MODE, 112
+.set FEL_STASH_BOOT_ADDR, 116
+.set FEL_STASH_CLIC_COUNT, 120
+.set FEL_STASH_CLIC_CFG, 124
+.set FEL_STASH_CLIC_THRESH, 128
+.set FEL_STASH_CLIC_IRQS, 132
+.set CLIC_MAX_IRQS, 256
+.set FEL_STASH_MINTSTATUS, FEL_STASH_CLIC_IRQS + 3 * CLIC_MAX_IRQS
+.set FEL_STASH_MTIME_LO, FEL_STASH_MINTSTATUS + 4
+.set FEL_STASH_MTIME_HI, FEL_STASH_MTIME_LO + 4
+.set FEL_STASH_MTIMECMP_LO, FEL_STASH_MTIME_HI + 4
+.set FEL_STASH_MTIMECMP_HI, FEL_STASH_MTIMECMP_LO + 4
+.set FEL_STASH_MTIME_RESUME_LO, FEL_STASH_MTIMECMP_HI + 4
+.set FEL_STASH_MTIME_RESUME_HI, FEL_STASH_MTIME_RESUME_LO + 4
+.set FEL_STASH_E907_CLK, FEL_STASH_MTIME_RESUME_HI + 4
+.set FEL_STASH_SYSMAP, FEL_STASH_E907_CLK + 4
+.set FEL_STASH_SIZE, FEL_STASH_SYSMAP + 4 * E907_SYSMAP_WORDS
+
+.macro save_csr csr, offset
+	csrr t1, \csr
+	sw t1, \offset(t0)
+.endm
+
+.macro restore_csr csr, offset
+	lw t1, \offset(t0)
+	csrw \csr, t1
+.endm
+
+.section .text.fel_stash, "ax"
+.option push
+.option norvc
+.option norelax
+.global save_boot_params
+save_boot_params:
+	/* Snapshot the caller's interrupt state before masking interrupts. */
+	csrrci t1, mstatus, V821_MSTATUS_MIE
+	lla t0, fel_stash
+	sw t1, FEL_STASH_MSTATUS(t0)
+	li t1, SUNXI_E907_CLK_REG
+	lw t1, 0(t1)
+	sw t1, FEL_STASH_E907_CLK(t0)
+	sw ra, 0(t0)
+	sw sp, 4(t0)
+	sw gp, 8(t0)
+	sw tp, 12(t0)
+	sw s0, 16(t0)
+	sw s1, 20(t0)
+	sw s2, 24(t0)
+	sw s3, 28(t0)
+	sw s4, 32(t0)
+	sw s5, 36(t0)
+	sw s6, 40(t0)
+	sw s7, 44(t0)
+	sw s8, 48(t0)
+	sw s9, 52(t0)
+	sw s10, 56(t0)
+	sw s11, 60(t0)
+	save_csr mie, FEL_STASH_MIE
+	save_csr mtvec, FEL_STASH_MTVEC
+	save_csr E907_CSR_MTVT, FEL_STASH_MTVT
+	save_csr E907_CSR_MINTSTATUS, FEL_STASH_MINTSTATUS
+	save_csr mscratch, FEL_STASH_MSCRATCH
+	save_csr mepc, FEL_STASH_MEPC
+	save_csr mcause, FEL_STASH_MCAUSE
+	save_csr mtval, FEL_STASH_MTVAL
+	/* MTIME is an external read-only counter; snapshot it without stopping it. */
+	li t2, E907_MTIME_READ_BASE
+.Lsave_mtime:
+	lw t3, E907_MTIME_HI_OFFSET(t2)
+	lw t1, E907_MTIME_LO_OFFSET(t2)
+	lw t4, E907_MTIME_HI_OFFSET(t2)
+	bne t3, t4, .Lsave_mtime
+	sw t1, FEL_STASH_MTIME_LO(t0)
+	sw t3, FEL_STASH_MTIME_HI(t0)
+	li t2, E907_MTIMECMP_ADDR
+	lw t1, 0(t2)
+	sw t1, FEL_STASH_MTIMECMP_LO(t0)
+	lw t1, 4(t2)
+	sw t1, FEL_STASH_MTIMECMP_HI(t0)
+	/* Documented E907 control CSRs; do not use the C906 CSR layout. */
+	save_csr E907_CSR_MXSTATUS, FEL_STASH_MXSTATUS
+	save_csr E907_CSR_MHCR, FEL_STASH_MHCR
+	save_csr E907_CSR_MHINT, FEL_STASH_MHINT
+	save_csr E907_CSR_MEXSTATUS, FEL_STASH_MEXSTATUS
+	/* Reset loses the BootROM's memory attributes, including ROM cacheability. */
+	li t2, E907_SYSMAP_BASE
+	addi t3, t0, FEL_STASH_SYSMAP
+	li t4, E907_SYSMAP_WORDS
+.Lsave_sysmap:
+	lw t1, 0(t2)
+	sw t1, 0(t3)
+	addi t2, t2, 4
+	addi t3, t3, 4
+	addi t4, t4, -1
+	bnez t4, .Lsave_sysmap
+	li t2, SUNXI_PRCM_BOOT_MODE_REG
+	lw t1, 0(t2)
+	sw t1, FEL_STASH_BOOT_MODE(t0)
+	lw t1, (SUNXI_PRCM_BOOT_ADDR_REG - SUNXI_PRCM_BOOT_MODE_REG)(t2)
+	sw t1, FEL_STASH_BOOT_ADDR(t0)
+	/* CLIC control registers can reset with the core. Never replay pending. */
+	li t2, E907_CLIC_BASE
+	lbu t1, E907_CLIC_CFG_OFFSET(t2)
+	sw t1, FEL_STASH_CLIC_CFG(t0)
+	lw t1, E907_CLIC_THRESH_OFFSET(t2)
+	sw t1, FEL_STASH_CLIC_THRESH(t0)
+	lw t1, E907_CLIC_INFO_OFFSET(t2)
+	li t6, E907_CLIC_INFO_NUM_INTERRUPTS_MASK
+	and t1, t1, t6
+	li t6, CLIC_MAX_IRQS
+	bgtu t1, t6, .Lclic_too_large
+	sw t1, FEL_STASH_CLIC_COUNT(t0)
+	mv t5, t1
+	addi t4, t0, FEL_STASH_CLIC_IRQS
+	li t3, E907_CLIC_INTIE_BASE
+	beqz t5, .Lclic_saved
+.Lsave_clic:
+	lbu t1, E907_CLIC_INTIE_OFFSET(t3)
+	sb t1, 0(t4)
+	lbu t1, E907_CLIC_INTATTR_OFFSET(t3)
+	sb t1, 1(t4)
+	lbu t1, E907_CLIC_INTCTL_OFFSET(t3)
+	sb t1, 2(t4)
+	addi t3, t3, E907_CLIC_IRQ_STRIDE
+	addi t4, t4, 3
+	addi t5, t5, -1
+	bnez t5, .Lsave_clic
+.Lclic_saved:
+	/* th.dcache.ciall: publish the stash before A27 resets this core. */
+	.long E907_INSN_DCACHE_CIALL
+	.long E907_INSN_TH_SYNC /* th.sync orders cache operations, unlike fence. */
+	fence iorw, iorw
+	j save_boot_params_ret
+.Lclic_too_large:
+	/* Unsupported controller: return without starting A27 or changing CLIC. */
+	lw t1, FEL_STASH_MSTATUS(t0)
+	li a0, 0
+	csrw mstatus, t1
+	ret
+
+/* A27 keeps DRAM alive while the restarted E907 resumes its ROM caller. */
+.global sunxi_unstash_fel
+sunxi_unstash_fel:
+	csrci mstatus, V821_MSTATUS_MIE
+	/* Publish L1 before disabling it, with no intervening stack writes. */
+	csrwi A27_CSR_UCCTLCOMMAND, A27_CCTL_L1D_WBINVAL_ALL
+	fence iorw, iorw
+	csrci A27_CSR_MCACHE_CTL, A27_MCACHE_CTL_ICACHE_ENABLE | A27_MCACHE_CTL_DCACHE_ENABLE
+	fence.i
+	/* L1 is off: drain L2 and leave no cache active during E907 FEL. */
+	li t0, A27_L2_BASE
+	lw t1, A27_L2_CONTROL_OFFSET(t0)
+	andi t2, t1, A27_L2_ENABLE
+	beqz t2, .Lfel_l2_disabled
+	li t2, A27_L2_WBINVAL_ALL
+	sw t2, A27_L2_COMMAND_HART0_OFFSET(t0)
+	fence iorw, iorw
+.Lfel_l2_wait:
+	lw t2, A27_L2_STATUS_HART0_OFFSET(t0)
+	andi t2, t2, A27_L2_STATUS_HART0_MASK
+	/* Only IDLE is safe; a rejected command must not resume E907. */
+	bnez t2, .Lfel_l2_wait
+	andi t1, t1, ~A27_L2_ENABLE
+	sw t1, A27_L2_CONTROL_OFFSET(t0)
+	fence iorw, iorw
+.Lfel_l2_disabled:
+	lla t0, fel_stash
+	li t2, SUNXI_PRCM_BOOT_MODE_REG
+	lla t1, fel_resume
+	sw t1, (SUNXI_PRCM_BOOT_ADDR_REG - SUNXI_PRCM_BOOT_MODE_REG)(t2)
+	lw t1, FEL_STASH_BOOT_MODE(t0)
+	slli t1, t1, SUNXI_PRCM_BOOT_MODE_KEY_SHIFT
+	srli t1, t1, SUNXI_PRCM_BOOT_MODE_KEY_SHIFT
+	li t3, SUNXI_PRCM_BOOT_MODE_KEY
+	or t1, t1, t3
+	andi t1, t1, ~SUNXI_PRCM_BOOT_MODE_MASK
+	ori t1, t1, SUNXI_PRCM_BOOT_MODE_RESUME
+	sw t1, 0(t2)
+	fence iorw, iorw
+	/* Restore the caller's clock while E907 is still held in reset. */
+	lw t1, FEL_STASH_E907_CLK(t0)
+	li t2, SUNXI_E907_CLK_REG
+	sw t1, 0(t2)
+	fence iorw, iorw
+	lw t1, 0(t2)
+	/* Keyed CPU-only reset release; ROM redirects before normal init. */
+	li t0, SUNXI_E907_RESET_REG
+	li t1, SUNXI_E907_RESET_KEY | SUNXI_E907_RESET_DEASSERT
+	sw t1, 0(t0)
+	fence iorw, iorw
+1:
+	wfi
+	j 1b
+
+/* ROM's reset prelude reaches this without touching the saved ROM stack. */
+.global fel_resume
+fel_resume:
+	csrci mstatus, V821_MSTATUS_MIE
+	li t1, E907_MHCR_HANDOFF_DISABLE_MASK
+	csrc E907_CSR_MHCR, t1
+	/* Same instruction/data invalidations as normal E907 ROM startup. */
+	.long E907_INSN_ICACHE_IALL
+	.long E907_INSN_DCACHE_IALL
+	.long E907_INSN_TH_SYNC /* th.sync */
+	fence iorw, iorw
+	lla t0, fel_stash
+	/* Restore the caller's map before re-enabling instruction caching. */
+	li t2, E907_SYSMAP_BASE
+	addi t3, t0, FEL_STASH_SYSMAP
+	li t4, E907_SYSMAP_WORDS
+.Lrestore_sysmap:
+	lw t1, 0(t3)
+	sw t1, 0(t2)
+	addi t2, t2, 4
+	addi t3, t3, 4
+	addi t4, t4, -1
+	bnez t4, .Lrestore_sysmap
+	fence iorw, iorw
+	.long E907_INSN_TH_SYNC
+	/* Consume the temporary redirect, preserving the original registers. */
+	li t2, SUNXI_PRCM_BOOT_MODE_REG
+	lw t1, FEL_STASH_BOOT_ADDR(t0)
+	sw t1, (SUNXI_PRCM_BOOT_ADDR_REG - SUNXI_PRCM_BOOT_MODE_REG)(t2)
+	lw t1, FEL_STASH_BOOT_MODE(t0)
+	slli t1, t1, SUNXI_PRCM_BOOT_MODE_KEY_SHIFT
+	srli t1, t1, SUNXI_PRCM_BOOT_MODE_KEY_SHIFT
+	li t3, SUNXI_PRCM_BOOT_MODE_KEY
+	or t1, t1, t3
+	sw t1, 0(t2)
+	fence iorw, iorw
+	/* Leave MTIME running; resetting this core must not rewind it. */
+	li t2, E907_MTIME_READ_BASE
+.Lresume_mtime:
+	lw t3, E907_MTIME_HI_OFFSET(t2)
+	lw t1, E907_MTIME_LO_OFFSET(t2)
+	lw t4, E907_MTIME_HI_OFFSET(t2)
+	bne t3, t4, .Lresume_mtime
+	sw t1, FEL_STASH_MTIME_RESUME_LO(t0)
+	sw t3, FEL_STASH_MTIME_RESUME_HI(t0)
+	/* Restore the actual compare value with the safe RV32 half-write order. */
+	li t2, E907_MTIMECMP_ADDR
+	li t1, E907_MTIMECMP_LO_SAFE
+	sw t1, 0(t2)
+	fence iorw, iorw
+	lw t1, FEL_STASH_MTIMECMP_HI(t0)
+	sw t1, 4(t2)
+	fence iorw, iorw
+	lw t1, FEL_STASH_MTIMECMP_LO(t0)
+	sw t1, 0(t2)
+	fence iorw, iorw
+	/* Restore actual interrupt routing before enabling interrupts. */
+	li t2, E907_CLIC_BASE
+	lw t1, FEL_STASH_CLIC_CFG(t0)
+	sb t1, E907_CLIC_CFG_OFFSET(t2)
+	lw t1, FEL_STASH_CLIC_THRESH(t0)
+	sw t1, E907_CLIC_THRESH_OFFSET(t2)
+	lw t5, FEL_STASH_CLIC_COUNT(t0)
+	addi t4, t0, FEL_STASH_CLIC_IRQS
+	li t3, E907_CLIC_INTIE_BASE
+	beqz t5, .Lclic_restored
+.Lrestore_clic:
+	lbu t1, 1(t4)
+	sb t1, E907_CLIC_INTATTR_OFFSET(t3)
+	lbu t1, 2(t4)
+	sb t1, E907_CLIC_INTCTL_OFFSET(t3)
+	lbu t1, 0(t4)
+	sb t1, E907_CLIC_INTIE_OFFSET(t3)
+	addi t3, t3, E907_CLIC_IRQ_STRIDE
+	addi t4, t4, 3
+	addi t5, t5, -1
+	bnez t5, .Lrestore_clic
+.Lclic_restored:
+	fence iorw, iorw
+	restore_csr E907_CSR_MXSTATUS, FEL_STASH_MXSTATUS
+	restore_csr E907_CSR_MHINT, FEL_STASH_MHINT
+	restore_csr E907_CSR_MEXSTATUS, FEL_STASH_MEXSTATUS
+	restore_csr E907_CSR_MTVT, FEL_STASH_MTVT
+	restore_csr mtvec, FEL_STASH_MTVEC
+	/* MIL is read-only. MRET restores it from MCAUSE.MPIL in CLIC mode. */
+	lw t1, FEL_STASH_MINTSTATUS(t0)
+	srli t1, t1, E907_MINTSTATUS_MIL_SHIFT
+	slli t1, t1, E907_MCAUSE_MPIL_SHIFT
+	/* Interrupt=1, MPP=M, MPIE=0: stay in M-mode with interrupts masked. */
+	li t2, E907_MCAUSE_INTERRUPT | E907_MCAUSE_MPP_M
+	or t1, t1, t2
+	csrw mcause, t1
+	lla t1, .Lmil_restored
+	csrw mepc, t1
+	mret
+.Lmil_restored:
+	restore_csr mscratch, FEL_STASH_MSCRATCH
+	restore_csr mepc, FEL_STASH_MEPC
+	restore_csr mcause, FEL_STASH_MCAUSE
+	restore_csr mtval, FEL_STASH_MTVAL
+	restore_csr mie, FEL_STASH_MIE
+	lw ra, 0(t0)
+	lw sp, 4(t0)
+	lw gp, 8(t0)
+	lw tp, 12(t0)
+	lw s0, 16(t0)
+	lw s1, 20(t0)
+	lw s2, 24(t0)
+	lw s3, 28(t0)
+	lw s4, 32(t0)
+	lw s5, 36(t0)
+	lw s6, 40(t0)
+	lw s7, 44(t0)
+	lw s8, 48(t0)
+	lw s9, 52(t0)
+	lw s10, 56(t0)
+	lw s11, 60(t0)
+	lw t2, FEL_STASH_MHCR(t0)
+	lw t1, FEL_STASH_MSTATUS(t0)
+	csrw E907_CSR_MHCR, t2
+	fence.i
+	li a0, 64
+	/* All caller state is ready before interrupts may become enabled. */
+	csrw mstatus, t1
+	ret
+.option pop
+
+/* Outside BSS: A27 clears BSS before initializing DRAM. */
+.section .data, "aw"
+.balign 16
+.global fel_stash
+.type fel_stash, @object
+fel_stash:
+	.zero FEL_STASH_SIZE
+.size fel_stash, . - fel_stash
+
+#endif
diff --git a/arch/riscv/Kconfig b/arch/riscv/Kconfig
--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -4,1 +4,10 @@
+config SUNXI_FEL_STASH
+	bool "Save the BootROM context for SPL return to FEL"
+	depends on MACH_SUN300I_V821 && SPL
+	default y
+	help
+	  Save the BootROM caller context before the E907-to-A27 handoff.
+	  This allows the SPL FEL loader to return to the original ROM caller.
+	  Disable this to save SRAM when SPL never returns directly to FEL.
+
 config SYS_ARCH
