--- a/drivers/watchdog/wdt-uclass.c
+++ b/drivers/watchdog/wdt-uclass.c
@@ -73,7 +73,7 @@
 
 	priv = dev_get_uclass_priv(dev);
 
-	if (IS_ENABLED(CONFIG_SYSRESET_WATCHDOG_AUTO)) {
+	if (CONFIG_IS_ENABLED(SYSRESET_WATCHDOG_AUTO)) {
 		ret = sysreset_register_wdt(dev);
 		if (ret)
 			printf("WDT:   Failed to register %s for sysreset\n",
@@ -164,8 +164,9 @@
 					priv->reset_period * 1000,
 					dev->name);
 
-			snprintf(svc_str, sizeof(svc_str), "every %ldms",
-				 priv->reset_period);
+			if (CONFIG_IS_ENABLED(SPRINTF))
+				snprintf(svc_str, sizeof(svc_str), "every %ldms",
+					 priv->reset_period);
 		}
 
 		priv->running = true;
@@ -179,7 +180,7 @@
 		 * Sub-second rounding is ignored to avoid noise.
 		 */
 		req_str[0] = '\0';
-		if (req_s != tout_s)
+		if (CONFIG_IS_ENABLED(SPRINTF) && req_s != tout_s)
 			snprintf(req_str, sizeof(req_str), ", requested %ds", req_s);
 
 		printf("WDT:   Started %s with%s servicing %s (%ds timeout%s)\n",
