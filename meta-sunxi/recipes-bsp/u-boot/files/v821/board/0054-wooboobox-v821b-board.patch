Subject: [PATCH] board: add Wooboobox V821B configuration and boot integration

Upstream-Status: Inappropriate [CatPlay V821 port]

diff --git a/arch/riscv/Kconfig b/arch/riscv/Kconfig
index ad75891..ffd4db6 100644
--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -61,6 +61,12 @@ config TARGET_TH1520_LPI4A
 config TARGET_XILINX_MBV
 	bool "Support AMD/Xilinx MicroBlaze V"
 
+config TARGET_WOOBOOBOX_V821B
+	bool "Support Wooboobox V821B (Allwinner V821)"
+	help
+	  Enable support for the Wooboobox V821B board. This board uses
+	  the Allwinner V821 RV32 SoC and boots from SPI NOR or SD card.
+
 config TARGET_ASPEED_AST2700_IBEX
 	bool "Support Ibex RISC-V cores on Aspeed AST2700 SoC"
 
@@ -123,6 +129,7 @@ source "board/spacemit/bananapi-f3/Kconfig"
 source "board/starfive/visionfive2/Kconfig"
 source "board/thead/th1520_lpi4a/Kconfig"
 source "board/xilinx/mbv/Kconfig"
+source "board/allwinner/wooboobox_v821b/Kconfig"
 
 # platform-specific options below
 source "arch/riscv/cpu/andes/Kconfig"
diff --git a/arch/riscv/dts/sun300i-v821-wooboobox-v821b-u-boot.dtsi b/arch/riscv/dts/sun300i-v821-wooboobox-v821b-u-boot.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/riscv/dts/sun300i-v821-wooboobox-v821b-u-boot.dtsi
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+&{/cpus} {
+	compatible = "simple-bus";
+	bootph-some-ram;
+};
+
+&cpu0 {
+	bootph-some-ram;
+};
+
+&wdt {
+	bootph-all;
+	timeout-sec = <16>;
+};
+
+&l2_cache {
+	bootph-pre-ram;
+};
+
+&dcxo {
+	bootph-some-ram;
+};
+
+&losc {
+	bootph-some-ram;
+};
+
+&pio_apb {
+	bootph-some-ram;
+};
+
+&cpu0_intc {
+	bootph-some-ram;
+};
+
+&plic {
+	bootph-some-ram;
+};
+
+&ccu {
+	bootph-some-ram;
+};
+
+&pio {
+	bootph-some-ram;
+};
+
+&r_pio {
+	bootph-some-ram;
+};
+
+&uart0_pins {
+	bootph-some-ram;
+};
+
+&mmc0_pins {
+	bootph-some-ram;
+};
+
+&spif_bus_pins {
+	bootph-some-ram;
+};
+
+&spif_control_pins {
+	bootph-some-ram;
+};
+
+&plmt0 {
+	bootph-some-ram;
+};
+
+&uart0 {
+	bootph-some-ram;
+};
+
+&mmc0 {
+	bootph-some-ram;
+};
+
+&spif {
+	bootph-pre-ram;
+	flash@0 {
+		bootph-pre-ram;
+	};
+};
diff --git a/arch/riscv/dts/sun300i-v821-wooboobox-v821b.dts b/arch/riscv/dts/sun300i-v821-wooboobox-v821b.dts
new file mode 100644
index 0000000..3481db2
--- /dev/null
+++ b/arch/riscv/dts/sun300i-v821-wooboobox-v821b.dts
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+
+/dts-v1/;
+
+#include "sun300i-v821.dtsi"
+
+/ {
+	model = "Wooboobox V821B";
+	compatible = "wooboobox,wooboobox-v821b", "allwinner,sun300i-v821",
+		     "allwinner,sun300iw1p1";
+
+	aliases {
+		mmc0 = &mmc0;
+		serial0 = &uart0;
+		spi0 = &spif;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0 0x80000000 0 0x4000000>;
+	};
+};
+
+&uart0 {
+	status = "okay";
+};
+
+&mmc0 {
+	status = "okay";
+};
+
+&spif {
+	/* CatPlay V821 tuning, matching the Linux machine DT. */
+	allwinner,sample-mode = <0>;
+	allwinner,sample-delay = <25>;
+	status = "okay";
+
+	flash@0 {
+		spi-max-frequency = <100000000>;
+		spi-rx-bus-width = <4>;
+		spi-tx-bus-width = <4>;
+	};
+};
diff --git a/board/allwinner/wooboobox_v821b/Kconfig b/board/allwinner/wooboobox_v821b/Kconfig
new file mode 100644
--- /dev/null
+++ b/board/allwinner/wooboobox_v821b/Kconfig
@@ -0,0 +1,74 @@
+if TARGET_WOOBOOBOX_V821B
+
+config SYS_BOARD
+	default "wooboobox_v821b"
+
+config SYS_VENDOR
+	default "allwinner"
+
+config SYS_SOC
+	default "sunxi"
+
+config SYS_CPU
+	default "andes"
+
+config SYS_CONFIG_NAME
+	default "wooboobox_v821b"
+
+config TEXT_BASE
+	default 0x82000000
+
+config SYS_LOAD_ADDR
+	default 0x81000000
+
+config HAS_CUSTOM_SYS_INIT_SP_ADDR
+	default y
+
+config CUSTOM_SYS_INIT_SP_ADDR
+	default 0x83000000
+
+config SPL_TEXT_BASE
+	default 0x02000060
+
+config SPL_STACK
+	default 0x02021c00
+
+config SPL_MAX_SIZE
+	default 0x13fa0
+
+config SPL_BSS_START_ADDR
+	default 0x02016000
+
+config SPL_BSS_MAX_SIZE
+	default 0xb000
+
+config BOARD_SPECIFIC_OPTIONS
+	def_bool y
+	select SOC_SUNXI
+	select MACH_SUN300I_V821
+	select OF_HAS_PRIOR_STAGE if RISCV_SMODE
+	select BINMAN if SPL
+	select RISCV_ANDES
+	select DM_GPIO
+	select SUNXI_GPIO
+	select SUNXI_NEW_PINCTRL
+	select ARCH_SUPPORTS_LTO
+	select SUPPORT_SPL
+	select SPL_IMAGE_TYPE_SUNXI_EGON
+	select DRAM_SUN20I_D1
+	select CLK_SUN300I_V821
+	select PINCTRL_SUN300I_V821
+	select SPL_DM
+
+config SPL_IMAGE
+	default "spl/sunxi-spl.bin"
+
+config WOOBOOBOX_V821B_SPL_FORCE_FEL
+	bool "Force return to FEL after Wooboobox V821B DRAM initialization"
+	depends on SPL
+	select SUNXI_FEL_STASH
+
+endif
+
+config MACH_SUN300I_V821
+	bool
diff --git a/board/allwinner/wooboobox_v821b/MAINTAINERS b/board/allwinner/wooboobox_v821b/MAINTAINERS
