diff --git a/include/configs/wooboobox_v821b.h b/include/configs/wooboobox_v821b.h
new file mode 100644
index 0000000..f63772b
--- /dev/null
+++ b/include/configs/wooboobox_v821b.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef __CONFIG_WOOBOOBOX_V821B_H
+#define __CONFIG_WOOBOOBOX_V821B_H
+
+#ifdef CONFIG_SPL_BUILD
+#define CFG_SYS_TIMER_RATE 40000000
+#define CFG_SYS_TIMER_COUNTER ((void *)0x48400000)
+#endif
+
+#define CFG_SYS_SDRAM_BASE 0x80000000UL
+
+#define RISCV_MMODE_TIMERBASE		0x48400000
+#define RISCV_MMODE_TIMER_FREQ		40000000
+#define RISCV_SMODE_TIMER_FREQ		40000000
+
+#endif
diff --git a/board/allwinner/wooboobox_v821b/Makefile b/board/allwinner/wooboobox_v821b/Makefile
new file mode 100644
--- /dev/null
+++ b/board/allwinner/wooboobox_v821b/Makefile
@@ -0,0 +1,2 @@
+obj-y += board.o
+obj-$(CONFIG_XPL_BUILD) += spl.o
diff --git a/board/allwinner/wooboobox_v821b/spl.c b/board/allwinner/wooboobox_v821b/spl.c
new file mode 100644
--- /dev/null
+++ b/board/allwinner/wooboobox_v821b/spl.c
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include <spl.h>
+#include <asm/arch-sunxi/fel.h>
+
+u32 spl_boot_device(void)
+{
+	if (IS_ENABLED(CONFIG_WOOBOOBOX_V821B_SPL_FORCE_FEL))
+		return BOOT_DEVICE_BOARD;
+
+	/* CatPlay V821 boots from NOR; boot_media's ROM encoding is unverified. */
+	return BOOT_DEVICE_SPI;
+}
diff --git a/board/allwinner/wooboobox_v821b/board.c b/board/allwinner/wooboobox_v821b/board.c
new file mode 100644
--- /dev/null
+++ b/board/allwinner/wooboobox_v821b/board.c
@@ -0,0 +1,149 @@
+// SPDX-License-Identifier: GPL-2.0+
+
+#include <init.h>
+#include <fdtdec.h>
+#include <asm/arch-sunxi/sys_proto.h>
+#include <asm/arch-sunxi/fel.h>
+#include <asm/arch-sunxi/watchdog.h>
+
+#ifdef CONFIG_XPL_BUILD
+#include <cpu_func.h>
+#include <spl.h>
+#include <wdt.h>
+#include <linux/errno.h>
+#include <linux/bitops.h>
+#include <linux/kernel.h>
+#include <sunxi_spif.h>
+#include <sunxi_image.h>
+#include <asm/arch-sunxi/bootrom.h>
+#include <asm/arch-sunxi/dram.h>
+#include <asm/arch-sunxi/clock.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+#endif
+
+#ifdef CONFIG_XPL_BUILD
+void board_init_f(ulong dummy)
+{
+	int ret;
+
+	/* A forced DRAM helper may run after a previous failed boot. */
+	if (IS_ENABLED(CONFIG_WOOBOOBOX_V821B_SPL_FORCE_FEL))
+		sunxi_fel_clear_request();
+	/* Preserve recovery from a previous failed boot, before touching DRAM. */
+	sunxi_fel_boot_guard();
+	sunxi_watchdog_init();
+	sunxi_debug_uart_init();
+	ret = spl_early_init();
+	if (ret)
+		sunxi_fel_recover();
+	initr_watchdog();
+	if (!CONFIG_IS_ENABLED(SYS_DCACHE_OFF))
+		enable_caches();
+	ret = dram_init();
+	if (ret)
+		sunxi_fel_recover();
+	sunxi_raise_cpu_clock();
+}
+
+
+#if CONFIG_IS_ENABLED(SPI_SUNXI_SPIF)
+static struct sunxi_spif_desc desc __aligned(64);
+static u8 bounce[SUNXI_SPIF_MAX_DATA] __aligned(64);
+
+static int spif_clock(void *priv, unsigned long rate)
+{
+	return clock_set_spif_rate((void __iomem *)SUNXI_CCU_APP_BASE, rate) ?
+		0 : -EINVAL;
+}
+
+int board_sunxi_spif_init(struct udevice *dev, struct sunxi_spif *core)
+{
+	int ret;
+
+	*core = (struct sunxi_spif) {
+		.base = (void __iomem *)SUNXI_SPIF_BASE,
+		.desc = &desc,
+		.buffer = bounce,
+		.set_clock = spif_clock,
+		/* Matches woo.dts: mode 0, delay 25, max 100 MHz. */
+		.max_frequency = 100000000,
+		.sample_mode = 0,
+		.sample_delay = 25,
+		.sample_configured = true,
+	};
+
+	ret = sunxi_spif_prepare(20000000);
+	if (ret)
+		return ret;
+	return sunxi_spif_init(core);
+}
+
+/* BootROM FEL leaves active USB endpoints; Linux must see reset hardware. */
+void spl_board_prepare_for_boot(void)
+{
+	if (!CONFIG_IS_ENABLED(SYS_DCACHE_OFF))
+		flush_dcache_all();
+	sunxi_reset_usb();
+}
+#endif
+#endif
+
+int dram_init(void)
+{
+#ifdef CONFIG_XPL_BUILD
+	struct boot_file_head *spl = (void *)SUNXI_SPL_EGON_ADDR;
+
+	gd->ram_size = sunxi_dram_init();
+	if (!gd->ram_size)
+		return -ENOMEM;
+	writel(gd->ram_size >> 20, &spl->dram_size);
+	return 0;
+#else
+	return fdtdec_setup_mem_size_base();
+#endif
+}
+
+int dram_init_banksize(void)
+{
+	return fdtdec_setup_memory_banksize();
+}
+
+int board_init(void)
+{
+	return 0;
+}
+
+/* Standard U-Boot debug-UART board hook. */
+void board_debug_uart_init(void)
+{
+	sunxi_debug_uart_init();
+}
+
+#ifndef CONFIG_XPL_BUILD
+int board_early_init_f(void)
+{
+	sunxi_watchdog_init();
+	sunxi_debug_uart_init();
+	sunxi_raise_cpu_clock();
+
+	return 0;
+}
+
+void board_quiesce_devices(void)
+{
+	sunxi_reset_usb();
+}
+#endif
+
+void arch_hang(void)
+{
+	sunxi_fel_recover();
+}
+
+void board_boot_failure(void)
+{
+	sunxi_fel_recover();
+}
