 #include "cedrus_engine.h"
 #include "cedrus_proc.h"
 #include "cedrus_regs.h"
+#include "cedrus_enc_h264_v2_regs.h"
 
 /* Format */
 
@@ -23,6 +26,17 @@
 	{
 		.pixelformat	= V4L2_PIX_FMT_NV12,
 		.type		= CEDRUS_FORMAT_TYPE_PICTURE,
+	},
+};
+
+static const struct cedrus_format cedrus_enc_v2_formats[] = {
+	{
+		.pixelformat = V4L2_PIX_FMT_NV12,
+		.type = CEDRUS_FORMAT_TYPE_PICTURE,
+	},
+	{
+		.pixelformat = V4L2_PIX_FMT_RGBA32,
+		.type = CEDRUS_FORMAT_TYPE_PICTURE,
 	},
 };
 
@@ -100,16 +114,23 @@
 	unsigned int height = pix_format->height;
 	unsigned int bytesperline = pix_format->bytesperline;
 	unsigned int sizeimage = 0;
+	unsigned int min_bytesperline;
 
 	/* Apply dimension and alignment constraints. */
 	v4l2_apply_frmsize_constraints(&width, &height, ctx->engine->frmsize);
 
 	/* Check minimum allowed bytesperline, maximum is to avoid overflow. */
-	if (bytesperline < width || bytesperline > (32 * width))
-		bytesperline = width;
-
-	/* Macroblock-aligned stride. */
-	bytesperline = ALIGN(bytesperline, 16);
+	min_bytesperline = width;
+	if (pix_format->pixelformat == V4L2_PIX_FMT_RGBA32)
+		min_bytesperline *= 4;
+	if (bytesperline < min_bytesperline || bytesperline > (32 * width))
+		bytesperline = min_bytesperline;
+
+	/* ISP RGB stride counts 16-pixel groups, including four bytes per pixel.
+	 * Match CedarX inputStrideMB rather than a 16-byte DMA unit.
+	 */
+	bytesperline = ALIGN(bytesperline,
+			     pix_format->pixelformat == V4L2_PIX_FMT_RGBA32 ? 64 : 16);
 
 	switch (pix_format->pixelformat) {
 	case V4L2_PIX_FMT_NV12:
@@ -118,6 +139,10 @@
 
 		/* Chroma plane size. */
 		sizeimage += bytesperline * height / 2;
+		break;
+	case V4L2_PIX_FMT_RGBA32:
+		if (check_mul_overflow(bytesperline, height, &sizeimage))
+			return -EINVAL;
 		break;
 	default:
 		return -EINVAL;
@@ -139,11 +164,19 @@
 	dma_addr_t luma_addr, chroma_addr;
 	unsigned int width_mbs, height_mbs;
 	unsigned int stride_mbs;
+	bool rgba = pix_format->pixelformat == V4L2_PIX_FMT_RGBA32;
 
 	/* Dimensions */
 
-	width_mbs = DIV_ROUND_UP(pix_format->width, 16);
-	height_mbs = DIV_ROUND_UP(pix_format->height, 16);
+	/* CedarX E230 configures the ISP dimensions in 8-pixel units. */
+	if (of_device_is_compatible(dev->dev->of_node,
+				    "allwinner,sun8i-v853-video-engine")) {
+		width_mbs = DIV_ROUND_UP(pix_format->width, 8);
+		height_mbs = DIV_ROUND_UP(pix_format->height, 8);
+	} else {
+		width_mbs = DIV_ROUND_UP(pix_format->width, 16);
+		height_mbs = DIV_ROUND_UP(pix_format->height, 16);
+	}
 
 	cedrus_write(dev, VE_ISP_PIC_INFO_REG,
 		     VE_ISP_PIC_INFO_WIDTH_MBS(width_mbs) |
@@ -158,22 +191,29 @@
 	if (WARN_ON(pix_format->bytesperline % 16))
 		return -EINVAL;
 
-	stride_mbs = pix_format->bytesperline / 16;
+	stride_mbs = pix_format->bytesperline / (rgba ? 64 : 16);
 
 	/* XXX: cedar rounds down, not up here. */
 	cedrus_write(dev, VE_ISP_PIC_STRIDE0_REG,
 		     VE_ISP_PIC_STRIDE0_INPUT_STRIDE_MBS(stride_mbs));
+	if (of_device_is_compatible(dev->dev->of_node,
+				    "allwinner,sun8i-v853-video-engine"))
+		cedrus_write(dev, CEDRUS_E230_ISP_CSI_STRIDE_1,
+			     rgba ? stride_mbs : stride_mbs * 2);
 
 	/* Format */
 
 	cedrus_write(dev, VE_ISP_CTRL_REG,
-		     VE_ISP_CTRL_FORMAT_YUV420SP |
+		     (rgba ? CEDRUS_E230_ISP_CONTROL_FORMAT_ABGR8888 :
+			     VE_ISP_CTRL_FORMAT_YUV420SP) |
 		     VE_ISP_CTRL_ROTATION_0 |
 		     VE_ISP_CTRL_COLORSPACE_BT601);
 
 	/* Address */
 
 	cedrus_job_buffer_picture_dma(ctx, &luma_addr, &chroma_addr);
+	if (rgba)
+		chroma_addr = 0;
 
 	cedrus_write(dev, VE_ISP_INPUT_LUMA_ADDR_REG, luma_addr);
 	cedrus_write(dev, VE_ISP_INPUT_CHROMA0_ADDR_REG, chroma_addr);
@@ -297,6 +337,10 @@
 	&cedrus_enc_h264,
 };
 
+static const struct cedrus_engine *cedrus_enc_v2_engines[] = {
+	&cedrus_enc_h264_v2,
+};
+
 /* Encoder */
 
 static const struct cedrus_proc_config cedrus_enc_config = {
@@ -307,6 +351,14 @@
 
 	.formats		= cedrus_enc_formats,
 	.formats_count		= ARRAY_SIZE(cedrus_enc_formats),
+};
+
+static const struct cedrus_proc_config cedrus_enc_v2_config = {
+	.role = CEDRUS_ROLE_ENCODER,
+	.engines = cedrus_enc_v2_engines,
+	.engines_count = ARRAY_SIZE(cedrus_enc_v2_engines),
+	.formats = cedrus_enc_v2_formats,
+	.formats_count = ARRAY_SIZE(cedrus_enc_v2_formats),
 };
 
 static const struct cedrus_proc_ops cedrus_enc_ops = {
@@ -322,8 +374,13 @@
 
 int cedrus_enc_setup(struct cedrus_device *dev)
 {
-	return cedrus_proc_setup(dev, &dev->enc, &cedrus_enc_ops,
-				 &cedrus_enc_config);
+	const struct cedrus_proc_config *config = &cedrus_enc_config;
+
+	if (of_device_is_compatible(dev->dev->of_node,
+				    "allwinner,sun8i-v853-video-engine"))
+		config = &cedrus_enc_v2_config;
+
+	return cedrus_proc_setup(dev, &dev->enc, &cedrus_enc_ops, config);
 }
 
 void cedrus_enc_cleanup(struct cedrus_device *dev)
