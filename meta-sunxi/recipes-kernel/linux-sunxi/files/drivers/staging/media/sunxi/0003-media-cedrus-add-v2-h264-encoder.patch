Subject: [PATCH] media: cedrus: add V2 H.264 encoder on Bootlin base
Upstream-Status: Pending
+
Keep the Bootlin H.264 engine for older IPs and select an E230/V2
backend on V853. Extend shared V4L2 handling for encoder drain,
configure the V853 ISP, and accept pixman-compatible RGBA input.
+
---
--- a/drivers/staging/media/sunxi/cedrus/Makefile
+++ b/drivers/staging/media/sunxi/cedrus/Makefile
@@ -10,5 +10,6 @@
 		 cedrus_dec_vp8.o \
 		 cedrus_enc.o \
 		 cedrus_enc_h264.o \
+		 cedrus_enc_h264_v2.o \
 		 cedrus_engine.o \
 		 cedrus_proc.o
--- a/drivers/staging/media/sunxi/cedrus/cedrus_context.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_context.c
@@ -12,6 +12,7 @@
 #include <linux/videodev2.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
+#include <media/v4l2-event.h>
 #include <media/v4l2-fh.h>
 #include <media/v4l2-mem2mem.h>
 #include <media/videobuf2-v4l2.h>
@@ -220,6 +221,16 @@
 	struct v4l2_m2m_ctx *m2m_ctx = ctx->v4l2.fh.m2m_ctx;
 
 	cedrus_engine_job_finish(ctx, state);
+	if (proc->role == CEDRUS_ROLE_ENCODER &&
+	    state == VB2_BUF_STATE_DONE &&
+	    v4l2_m2m_is_last_draining_src_buf(m2m_ctx,
+					      ctx->job.buffer_picture)) {
+		struct v4l2_event eos = { .type = V4L2_EVENT_EOS };
+
+		ctx->job.buffer_coded->flags |= V4L2_BUF_FLAG_LAST;
+		v4l2_m2m_mark_stopped(m2m_ctx);
+		v4l2_event_queue_fh(&ctx->v4l2.fh, &eos);
+	}
 	memset(&ctx->job, 0, sizeof(ctx->job));
 
 	v4l2_m2m_buf_done_and_job_finish(m2m_dev, m2m_ctx, state);
@@ -532,8 +543,12 @@
 		return -ENODEV;
 
 	/* Only start the engine from the coded queue. */
-	if (format_type != CEDRUS_FORMAT_TYPE_CODED)
+	if (format_type != CEDRUS_FORMAT_TYPE_CODED) {
+		if (ctx->proc->role == CEDRUS_ROLE_ENCODER)
+			v4l2_m2m_update_start_streaming_state(
+				ctx->v4l2.fh.m2m_ctx, queue);
 		return 0;
+	}
 
 	ret = pm_runtime_resume_and_get(dev);
 	if (ret)
@@ -559,6 +574,10 @@
 	if (ret)
 		goto error_alloc_job;
 
+	if (ctx->proc->role == CEDRUS_ROLE_ENCODER)
+		v4l2_m2m_update_start_streaming_state(
+			ctx->v4l2.fh.m2m_ctx, queue);
+
 	return 0;
 
 error_alloc_job:
@@ -592,6 +611,11 @@
 
 	if (WARN_ON(!engine))
 		return;
+
+	if (ctx->proc->role == CEDRUS_ROLE_ENCODER &&
+	    V4L2_TYPE_IS_OUTPUT(queue->type))
+		v4l2_m2m_update_stop_streaming_state(
+			ctx->v4l2.fh.m2m_ctx, queue);
 
 	/* Only stop the engine from the coded queue. */
 	if (format_type != CEDRUS_FORMAT_TYPE_CODED)
--- a/drivers/staging/media/sunxi/cedrus/cedrus_proc.c
+++ b/drivers/staging/media/sunxi/cedrus/cedrus_proc.c
@@ -630,6 +630,37 @@
 	return 0;
 }
 
+static int cedrus_proc_encoder_cmd(struct file *file, void *priv,
+				   struct v4l2_encoder_cmd *cmd)
+{
+	struct cedrus_proc *proc = video_drvdata(file);
+
+	if (proc->role != CEDRUS_ROLE_ENCODER)
+		return -ENOTTY;
+
+	return v4l2_m2m_ioctl_encoder_cmd(file, priv, cmd);
+}
+
+static int cedrus_proc_try_encoder_cmd(struct file *file, void *priv,
+				       struct v4l2_encoder_cmd *cmd)
+{
+	struct cedrus_proc *proc = video_drvdata(file);
+
+	if (proc->role != CEDRUS_ROLE_ENCODER)
+		return -ENOTTY;
+
+	return v4l2_m2m_ioctl_try_encoder_cmd(file, priv, cmd);
+}
+
+static int cedrus_proc_subscribe_event(struct v4l2_fh *fh,
+				      const struct v4l2_event_subscription *sub)
+{
+	if (sub->type == V4L2_EVENT_EOS)
+		return v4l2_event_subscribe(fh, sub, 2, NULL);
+
+	return v4l2_ctrl_subscribe_event(fh, sub);
+}
+
 static const struct v4l2_ioctl_ops cedrus_proc_ioctl_ops = {
 	.vidioc_querycap		= cedrus_proc_querycap,
 
@@ -663,10 +694,13 @@
 	.vidioc_streamon		= v4l2_m2m_ioctl_streamon,
 	.vidioc_streamoff		= v4l2_m2m_ioctl_streamoff,
 
+	.vidioc_encoder_cmd		= cedrus_proc_encoder_cmd,
+	.vidioc_try_encoder_cmd	= cedrus_proc_try_encoder_cmd,
+
 	.vidioc_decoder_cmd		= v4l2_m2m_ioctl_stateless_decoder_cmd,
 	.vidioc_try_decoder_cmd		= v4l2_m2m_ioctl_stateless_try_decoder_cmd,
 
-	.vidioc_subscribe_event		= v4l2_ctrl_subscribe_event,
+	.vidioc_subscribe_event		= cedrus_proc_subscribe_event,
 	.vidioc_unsubscribe_event	= v4l2_event_unsubscribe,
 };
 
