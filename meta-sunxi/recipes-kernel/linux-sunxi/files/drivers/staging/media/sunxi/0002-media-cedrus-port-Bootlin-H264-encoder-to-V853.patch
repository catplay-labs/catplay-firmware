Subject: [PATCH] media: cedrus: port Bootlin H.264 encoder to Linux 7.2 and V853
Upstream-Status: Pending

Experimental V851S encoding bring-up based on Bootlin commit
4e9497947c56f10351ed8c000605dbe47d4aee46 and prerequisites
cc8f8edb44e9ca5e15e1fc229b052a5c267d3141 and
11bfd77ae143c7dc97d001af28d1005802b97b21.

---
diff --git a/drivers/staging/media/sunxi/cedrus/Kconfig b/drivers/staging/media/sunxi/cedrus/Kconfig
--- a/drivers/staging/media/sunxi/cedrus/Kconfig
+++ b/drivers/staging/media/sunxi/cedrus/Kconfig
@@ -1,17 +1,15 @@
 # SPDX-License-Identifier: GPL-2.0
 config VIDEO_SUNXI_CEDRUS
-	tristate "Allwinner Cedrus VPU driver"
+	tristate "Allwinner Cedrus Video Engine Driver"
 	depends on VIDEO_DEV
-	depends on RESET_CONTROLLER
-	depends on HAS_DMA
-	depends on OF
+	depends on ARCH_SUNXI || COMPILE_TEST
+	depends on PM && COMMON_CLK && RESET_CONTROLLER && HAS_DMA
 	select MEDIA_CONTROLLER
-	select SUNXI_SRAM
 	select VIDEOBUF2_DMA_CONTIG
 	select V4L2_MEM2MEM_DEV
+	select SUNXI_SRAM
 	help
-	  Support for the VPU found in Allwinner SoCs, also known as the Cedar
-	  video engine.
+	  Support for the Allwinner Video Engine.
 
 	  To compile this driver as a module, choose M here: the module
 	  will be called sunxi-cedrus.
diff --git a/drivers/staging/media/sunxi/cedrus/Makefile b/drivers/staging/media/sunxi/cedrus/Makefile
--- a/drivers/staging/media/sunxi/cedrus/Makefile
+++ b/drivers/staging/media/sunxi/cedrus/Makefile
@@ -1,6 +1,14 @@
 # SPDX-License-Identifier: GPL-2.0
 obj-$(CONFIG_VIDEO_SUNXI_CEDRUS) += sunxi-cedrus.o
 
-sunxi-cedrus-y = cedrus.o cedrus_video.o cedrus_hw.o cedrus_dec.o \
-		 cedrus_mpeg2.o cedrus_h264.o cedrus_h265.o \
-		 cedrus_vp8.o
+sunxi-cedrus-y = cedrus.o \
+		 cedrus_context.o \
+		 cedrus_dec.o \
+		 cedrus_dec_h264.o \
+		 cedrus_dec_h265.o \
+		 cedrus_dec_mpeg2.o \
+		 cedrus_dec_vp8.o \
+		 cedrus_enc.o \
+		 cedrus_enc_h264.o \
+		 cedrus_engine.o \
+		 cedrus_proc.o
