@@ -0,0 +1,740 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Cedrus Video Engine Driver
+ *
+ * Copyright 2016 Florent Revest <florent.revest@free-electrons.com>
+ * Copyright 2018 Paul Kocialkowski <paul.kocialkowski@bootlin.com>
