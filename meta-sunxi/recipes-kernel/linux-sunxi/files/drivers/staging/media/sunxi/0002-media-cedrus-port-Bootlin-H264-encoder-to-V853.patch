+	int (*ctrl_validate)(struct cedrus_context *ctx,
+			     struct v4l2_ctrl *ctrl);
+	int (*ctrl_prepare)(struct cedrus_context *ctx, struct v4l2_ctrl *ctrl);
+
+	int (*format_prepare)(struct cedrus_context *ctx,
+			      struct v4l2_format *format);
