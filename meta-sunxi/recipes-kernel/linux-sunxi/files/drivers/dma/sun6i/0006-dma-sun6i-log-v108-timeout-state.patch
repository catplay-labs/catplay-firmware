Subject: [PATCH] dmaengine: sun6i: log V821 channel state on terminate

Upstream-Status: Inappropriate [V821 bring-up diagnostics]
---
 drivers/dma/sun6i-dma.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/drivers/dma/sun6i-dma.c b/drivers/dma/sun6i-dma.c
--- a/drivers/dma/sun6i-dma.c
+++ b/drivers/dma/sun6i-dma.c
@@ -964,6 +964,21 @@ static int sun6i_dma_terminate_all(struct dma_chan *chan)
 	vchan_get_all_descriptors(&vchan->vc, &head);
 
 	if (pchan) {
+		if (sdev->cfg->has_io_speedup && pchan->desc) {
+			struct sun6i_dma_lli *lli = pchan->desc->v_lli;
+
+			dev_err(sdev->slave.dev,
+				"V821 DMA timeout ch=%u port=%u lli=%pad cfg=%08x src=%08x dst=%08x len=%u para=%08x en=%08x pause=%08x curcfg=%08x cursrc=%08x curdst=%08x curcnt=%08x curpara=%08x irqen=%08x irqstat=%08x stat=%08x gate=%08x route=%08x/%08x\n",
+				pchan->idx, vchan->port, &pchan->desc->p_lli,
+				lli->cfg, lli->src, lli->dst, lli->len, lli->para,
+				readl(pchan->base + DMA_CHAN_ENABLE), readl(pchan->base + DMA_CHAN_PAUSE),
+				readl(pchan->base + DMA_CHAN_CUR_CFG), readl(pchan->base + DMA_CHAN_CUR_SRC),
+				readl(pchan->base + DMA_CHAN_CUR_DST), readl(pchan->base + DMA_CHAN_CUR_CNT),
+				readl(pchan->base + DMA_CHAN_CUR_PARA), readl(sdev->base + DMA_IRQ_EN(0)),
+				readl(sdev->base + DMA_IRQ_STAT(0)), readl(sdev->base + DMA_STAT),
+				readl(sdev->base + SUNXI_H3_DMA_GATE), readl(sdev->base + DMA_IRQ_CPU_EN_REG),
+				readl(sdev->base + DMA_IRQ_MCU_EN_REG));
+		}
 		writel(DMA_CHAN_ENABLE_STOP, pchan->base + DMA_CHAN_ENABLE);
 		writel(DMA_CHAN_PAUSE_RESUME, pchan->base + DMA_CHAN_PAUSE);
 
-- 
2.45.2
