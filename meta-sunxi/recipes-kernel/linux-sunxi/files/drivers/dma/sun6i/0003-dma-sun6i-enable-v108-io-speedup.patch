Subject: [PATCH] dmaengine: sun6i: enable v108 IO speedup descriptors

Upstream-Status: Inappropriate [vendor-specific hardware enablement]

The V821 vendor v108 DMA driver sets IOSPEEDUP in slave transfer
descriptors.  Keep the behaviour variant-specific.

--- a/drivers/dma/sun6i-dma.c
+++ b/drivers/dma/sun6i-dma.c
@@ -106,6 +106,7 @@
  */
 #define LLI_LAST_ITEM	0xfffff800
 #define NORMAL_WAIT	8
+#define IOSPEEDUP	0x100
 #define DRQ_SDRAM	1
 #define LINEAR_MODE     0
 #define IO_MODE         1
@@ -145,6 +146,7 @@
 	bool has_high_addr;
 	bool has_mbus_clk;
 	bool has_mbus_en_clk;
+	bool has_io_speedup;
 };
 
 /*
@@ -749,6 +751,8 @@
 
 		v_lli->len = sg_dma_len(sg);
 		v_lli->para = NORMAL_WAIT;
+		if (sdev->cfg->has_io_speedup)
+			v_lli->para |= IOSPEEDUP;
 
 		if (dir == DMA_MEM_TO_DEV) {
 			sun6i_dma_set_addr(sdev, v_lli,
@@ -1311,6 +1315,7 @@
 				     BIT(DMA_SLAVE_BUSWIDTH_8_BYTES),
 	.has_mbus_clk = true,
 	.has_mbus_en_clk = true,
+	.has_io_speedup = true,
 };
 
 static const struct of_device_id sun6i_dma_match[] = {
