Subject: [PATCH] crypto: sun8i-ce: add CE 2.3 descriptor support
Upstream-Status: Inappropriate [V851S-specific Crypto Engine 2.3 format]

Record the CE version and add the shared 40-bit CE 2.3 cipher/hash task
layouts used by the V851 CTR and TRNG paths.

---
diff --git a/drivers/crypto/allwinner/sun8i-ce/sun8i-ce.h b/drivers/crypto/allwinner/sun8i-ce/sun8i-ce.h
index 95bc32a..72714c9 100644
--- a/drivers/crypto/allwinner/sun8i-ce/sun8i-ce.h
+++ b/drivers/crypto/allwinner/sun8i-ce/sun8i-ce.h
@@ -19,6 +19,7 @@
 #include <crypto/sha2.h>
 
 /* CE Registers */
+#define CE_VER	0x90
 #define CE_TDQ	0x00
 #define CE_CTR	0x04
 #define CE_ICR	0x08
@@ -174,6 +175,47 @@ struct ce_task {
 	__le32 reserved[3];
 } __packed __aligned(8);
 
+/* CE 2.3 descriptors use 40-bit DMA addresses and byte lengths. */
+struct ce23_sg {
+	u8 source_addr[5];
+	u8 dest_addr[5];
+	u8 pad[2];
+	__le32 source_len;
+	__le32 dest_len;
+} __packed;
+
+struct ce23_hash_task {
+	__le32 ctrl;
+	__le32 cmd;
+	u8 data_total_len_addr[5];
+	u8 hmac_prng_key_addr[5];
+	u8 iv_addr[5];
+	u8 pad;
+	struct ce23_sg sg[MAX_SG];
+	u8 next_sg_addr[5];
+	u8 next_task_addr[5];
+	u8 pad2[2];
+	__le32 reserved[3];
+	u8 padding[48];
+} __packed __aligned(64);
+
+struct ce23_cipher_task {
+	__le32 t_id;
+	__le32 t_common_ctl;
+	__le32 t_sym_ctl;
+	__le32 t_asym_ctl;
+	u8 t_key[5];
+	u8 t_iv[5];
+	u8 t_ctr[5];
+	u8 pad;
+	__le32 t_dlen;
+	struct ce23_sg sg[MAX_SG];
+	u8 next_sg_addr[5];
+	u8 next_task_addr[5];
+	u8 pad2[2];
+	__le32 reserved[3];
+} __packed;
+
 /*
  * struct sun8i_ce_flow - Information used by each flow
  * @engine:	ptr to the crypto_engine for this flow
@@ -218,6 +260,7 @@ struct sun8i_ce_dev {
 	struct sun8i_ce_flow *chanlist;
 	atomic_t flow;
 	const struct ce_variant *variant;
+	u32 version;
 #ifdef CONFIG_CRYPTO_DEV_SUN8I_CE_DEBUG
 	struct dentry *dbgfs_dir;
 	struct dentry *dbgfs_stats;
@@ -231,6 +274,11 @@ struct sun8i_ce_dev {
 #endif
 };
 
+static inline bool sun8i_ce_is_v23(struct sun8i_ce_dev *ce)
+{
+	return (ce->version & 0xffff0000) == 0x00230000;
+}
+
 static inline u32 desc_addr_val(struct sun8i_ce_dev *dev, dma_addr_t addr)
 {
 	if (dev->variant->needs_word_addresses)
-- 
