 }
 
+int sun4i_ss_engine_do_one_request(struct crypto_engine *engine, void *areq)
+{
+	struct skcipher_request *req = container_of(areq,
+						    struct skcipher_request, base);
+	struct crypto_skcipher *tfm = crypto_skcipher_reqtfm(req);
+	struct sun4i_ss_alg_template *algt;
+	struct sun4i_cipher_req_ctx *rctx = skcipher_request_ctx(req);
+	int err;
+
+	algt = container_of(crypto_skcipher_alg(tfm),
+			   struct sun4i_ss_alg_template, alg.engine_crypto.base);
+	err = rctx->encrypt ? algt->encrypt(req) : algt->decrypt(req);
+	local_bh_disable();
+	crypto_finalize_skcipher_request(engine, req, err);
+	local_bh_enable();
+	return 0;
+}
 /* CBC DES */
 int sun4i_ss_cbc_des_encrypt(struct skcipher_request *areq)
 {
--- a/drivers/crypto/allwinner/sun4i-ss/sun4i-ss-core.c
+++ b/drivers/crypto/allwinner/sun4i-ss/sun4i-ss-core.c
@@ -85,6 +85,7 @@
 	}
 },
 {       .type = CRYPTO_ALG_TYPE_SKCIPHER,
+	.mode = SS_CTR,
 	.alg.crypto = {
 		.setkey         = sun4i_ss_aes_setkey,
 		.encrypt        = sun4i_ss_ctr_aes_crypt,
@@ -337,6 +338,50 @@
 	pm_runtime_disable(ss->dev);
 }
 
+static int sun4i_ss_engine_queue(struct skcipher_request *areq, bool encrypt)
+{
+	struct crypto_skcipher *tfm = crypto_skcipher_reqtfm(areq);
+	struct sun4i_tfm_ctx *op = crypto_skcipher_ctx(tfm);
+	struct sun4i_cipher_req_ctx *rctx = skcipher_request_ctx(areq);
+
+	rctx->encrypt = encrypt;
+	return crypto_transfer_skcipher_request_to_engine(op->ss->engine, areq);
+}
+
+static int sun4i_ss_engine_encrypt(struct skcipher_request *areq)
+{
+	return sun4i_ss_engine_queue(areq, true);
+}
+
+static int sun4i_ss_engine_decrypt(struct skcipher_request *areq)
+{
+	return sun4i_ss_engine_queue(areq, false);
+}
+
+static int sun4i_ss_register_alg(struct sun4i_ss_alg_template *algt)
+{
+	if (algt->type == CRYPTO_ALG_TYPE_SKCIPHER) {
+		algt->encrypt = algt->alg.crypto.encrypt;
+		algt->decrypt = algt->alg.crypto.decrypt;
+		algt->alg.engine_crypto.base.encrypt = sun4i_ss_engine_encrypt;
+		algt->alg.engine_crypto.base.decrypt = sun4i_ss_engine_decrypt;
+		algt->alg.engine_crypto.base.base.cra_flags |= CRYPTO_ALG_ASYNC;
+		algt->alg.engine_crypto.op.do_one_request =
+			sun4i_ss_engine_do_one_request;
+		return crypto_engine_register_skcipher(&algt->alg.engine_crypto);
+	}
+
+	return crypto_register_ahash(&algt->alg.hash);
+}
+
+static void sun4i_ss_unregister_alg(struct sun4i_ss_alg_template *algt)
+{
+	if (algt->type == CRYPTO_ALG_TYPE_SKCIPHER)
+		crypto_engine_unregister_skcipher(&algt->alg.engine_crypto);
+	else
+		crypto_unregister_ahash(&algt->alg.hash);
+}
+
