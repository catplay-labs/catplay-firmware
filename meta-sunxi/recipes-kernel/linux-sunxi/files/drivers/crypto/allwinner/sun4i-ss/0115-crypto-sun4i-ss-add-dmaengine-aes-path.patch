 			break;
 		case CRYPTO_ALG_TYPE_AHASH:
 			seq_printf(seq, "%s %s reqs=%lu\n",
@@ -412,6 +424,38 @@
 	if (!ss->variant) {
 		dev_err(&pdev->dev, "Missing Security System variant\n");
 		return -EINVAL;
+	}
+	ss->res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!ss->res)
+		return -ENODEV;
+
+	ss->dma_src_sg = devm_kcalloc(&pdev->dev, SS_DMA_MAX_SG,
+				      sizeof(*ss->dma_src_sg), GFP_KERNEL);
+	ss->dma_dst_sg = devm_kcalloc(&pdev->dev, SS_DMA_MAX_SG,
