+				   ss_algs[i].stat_bytes, ss_algs[i].stat_dma,
+				   ss_algs[i].stat_dma_bytes, ss_algs[i].stat_dma_burst16,
+				   ss_algs[i].stat_dma_skip_block,
+				   ss_algs[i].stat_dma_skip_block_near64k,
+				   ss_algs[i].stat_dma_last_unaligned_len,
+				   ss_algs[i].stat_dma_skip_src_word,
+				   ss_algs[i].stat_dma_skip_dst_word,
+				   ss_algs[i].stat_dma_skip_src_many,
+				   ss_algs[i].stat_dma_skip_dst_many,
+				   ss_algs[i].stat_dma_skip_src_invalid,
