 			continue;
 		switch (ss_algs[i].type) {
 		case CRYPTO_ALG_TYPE_SKCIPHER:
-			seq_printf(seq, "%s %s reqs=%lu opti=%lu fallback=%lu tsize=%lu\n",
+			seq_printf(seq, "%s %s reqs=%lu opti=%lu fallback=%lu tsize=%lu dma_reqs=%lu dma_bytes=%lu burst16=%lu skip_block=%lu skip_block_near64k=%lu last_unaligned_len=%lu skip_src_word=%lu skip_dst_word=%lu skip_src_many=%lu skip_dst_many=%lu skip_src_invalid=%lu skip_dst_invalid=%lu skip_inplace=%lu\n",
 				   ss_algs[i].alg.crypto.base.cra_driver_name,
