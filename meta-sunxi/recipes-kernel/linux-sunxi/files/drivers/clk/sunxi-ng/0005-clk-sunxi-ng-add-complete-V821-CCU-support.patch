+// SPDX-License-Identifier: GPL-2.0
+/*
+ * CCU support for Allwinner sun300i-v821.
+ *
+ * Clock gates and resets consumed by the V821 platform, including CE,
+ * SGDMA and standalone TRNG. Offsets and IDs match the vendor
+ * sun300i-v821 CCU driver and dt-bindings.
+ */
+
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+
+#include "ccu_common.h"
+#include "ccu_gate.h"
+#include "ccu_mp.h"
+#include "ccu_reset.h"
+
+#include "ccu-sun300i-v821.h"
+
+static SUNXI_CCU_GATE(usb_24m_clk, "usb-24m", "dcxo",
+		      0x007c, BIT(3), 0);
+static SUNXI_CCU_GATE(usb_12m_clk, "usb-12m", "dcxo",
+		      0x007c, BIT(2), 0);
+static SUNXI_CCU_GATE(usb_48m_clk, "usb-48m", "dcxo",
+		      0x007c, BIT(1), 0);
+
+static SUNXI_CCU_GATE(usbohci_clk, "usbohci", "dcxo",
+		      0x0080, BIT(22), 0);
+static SUNXI_CCU_GATE(usbehci_clk, "usbehci", "dcxo",
+		      0x0080, BIT(21), 0);
+static SUNXI_CCU_GATE(usbotg_clk, "usbotg", "dcxo",
+		      0x0080, BIT(20), 0);
+static SUNXI_CCU_GATE(usb_clk, "usb-hclk", "dcxo",
+		      0x0080, BIT(19), 0);
+
+static SUNXI_CCU_GATE(uart3_clk, "uart3", "apb-spc",
+		      0x0080, BIT(18), CLK_IGNORE_UNUSED);
+static SUNXI_CCU_GATE(uart2_clk, "uart2", "apb-spc",
+		      0x0080, BIT(17), CLK_IGNORE_UNUSED);
+static SUNXI_CCU_GATE(uart1_clk, "uart1", "apb-spc",
+		      0x0080, BIT(16), CLK_IGNORE_UNUSED);
+static SUNXI_CCU_GATE(uart0_clk, "uart0", "apb-spc",
+		      0x0080, BIT(15), CLK_IGNORE_UNUSED);
+static SUNXI_CCU_GATE(twi0_clk, "twi0", "apb-spc",
+		      0x0080, BIT(14), 0);
+
+static SUNXI_CCU_GATE(trng_clk, "trng", "dcxo",
+		      0x0080, BIT(11), 0);
+static SUNXI_CCU_GATE(sg_dma_clk, "sgdma", "dcxo",
+		      0x0080, BIT(9), 0);
+static SUNXI_CCU_GATE(ce_clk, "ce", "dcxo",
+		      0x0080, BIT(6), CLK_IGNORE_UNUSED);
+
+static const char * const ss_parents[] = {
+	"dcxo", "pll-peri-cko-118m"
+};
+static SUNXI_CCU_M_WITH_MUX_GATE(ss_clk, "ss", ss_parents, 0x0018,
+				 0, 5, 24, 1, BIT(31), 0);
+
+static SUNXI_CCU_GATE(hstimer_clk, "hstimer", "ahb",
+		      0x0080, BIT(5), 0);
+
+static const char * const smhc0_parents[] = {
+	"dcxo", "pll-peri-cko-192m", "pll-peri-cko-219m", "",
+	"", "",
+};
+static SUNXI_CCU_MP_WITH_MUX_GATE_NO_INDEX(smhc0_clk, "smhc0",
+						  smhc0_parents, 0x0014,
+						  0, 5, 16, 5, 24, 3,
+						  BIT(31), 0);
+
+static const char * const smhc1_parents[] = {
+	"dcxo", "pll-peri-cko-192m", "pll-peri-cko-219m", "",
+	"", "",
+};
+static SUNXI_CCU_MP_WITH_MUX_GATE_NO_INDEX(smhc1_clk, "smhc1",
+						  smhc1_parents, 0x005c,
+						  0, 5, 16, 5, 24, 3,
+						  BIT(31), 0);
+
+static SUNXI_CCU_GATE(spi_clk, "spi", "dcxo",
+		      0x001c, BIT(31), 0);
+static const char * const spif_parents[] = {
+	"dcxo", "pll-peri-cko-512m", "pll-peri-cko-384m",
+	"pll-peri-cko-307m"
+};
+static SUNXI_CCU_MP_WITH_MUX_GATE(spif_clk, "spif", spif_parents,
+				  0x0020, 0, 4, 16, 2, 24, 2,
+				  BIT(31), 0);
