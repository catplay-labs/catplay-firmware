@@ -0,0 +1,10 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _CCU_SUN300I_V821_R_H_
+#define _CCU_SUN300I_V821_R_H_
+
+#include <dt-bindings/clock/sun300i-v821-r-ccu.h>
+#include <dt-bindings/reset/sun300i-v821-r-ccu.h>
+
+#define CLK_NUMBER	CLK_AON_NUMBER
+
+#endif
diff --git a/drivers/clk/sunxi-ng/ccu-sun300i-v821.c b/drivers/clk/sunxi-ng/ccu-sun300i-v821.c
new file mode 100644
