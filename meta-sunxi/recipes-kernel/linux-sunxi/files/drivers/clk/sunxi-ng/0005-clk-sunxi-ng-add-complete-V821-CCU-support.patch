diff --git a/drivers/clk/sunxi-ng/ccu-sun300i-v821-r.c b/drivers/clk/sunxi-ng/ccu-sun300i-v821-r.c
new file mode 100644
index 000000000000..e6e5eaef5674
--- /dev/null
+++ b/drivers/clk/sunxi-ng/ccu-sun300i-v821-r.c
@@ -0,0 +1,330 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2023 Allwinner Technology Co., Ltd.
+ * Copyright (c) 2026 CatPlay project
+ *
+ * Mainline-compatible sun300i-v821 R CCU using the vendor PLL sequencing
+ * extensions backported to ccu_nm.
+ */
+
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of_address.h>
+
+#include "ccu_common.h"
+#include "ccu_reset.h"
+#include "ccu_gate.h"
+#include "ccu_mp.h"
+#include "ccu_nm.h"
+
+#include "ccu-sun300i-v821-r.h"
+
+#define SUN300I_V821_PLL_CPU_CTRL_REG	0x0000
+#define SUN300I_V821_PLL_PERI_CTRL_REG	0x0020
+#define SUN300I_V821_PLL_PERI_CTRL1_REG	0x0024
+#define SUN300I_V821_PLL_DDR_CTRL_REG	0x0080
+#define SUN300I_V821_DCXO_STATUS_REG	0x0404
+#define SUN300I_V821_AHB_CFG_REG		0x0500
+#define SUN300I_V821_APB_CFG_REG		0x0504
+#define SUN300I_V821_A27L2_CFG_REG		0x0588
+
+static struct ccu_nm pll_cpu_clk = {
+	.output		= BIT(27),
+	.enable		= BIT(31),
+	.lock		= BIT(28),
+	.lock_enable	= BIT(29),
+	.ldo_en		= BIT(30),
+	.n		= _SUNXI_CCU_MULT_OFFSET_MIN_MAX(8, 8, 1, 16, 60),
+	.min_rate	= 640000000,
+	.max_rate	= 2400000000U,
+	.fixed_post_div = 2,
+	.common		= {
+		.reg		= SUN300I_V821_PLL_CPU_CTRL_REG,
+		.features	= CCU_FEATURE_FIXED_POSTDIV,
+		.hw.init	= CLK_HW_INIT("pll-cpu", "dcxo",
+					      &ccu_nm_ops,
+					      CLK_SET_RATE_UNGATE |
+					      CLK_IS_CRITICAL),
+	},
+};
+
+static struct ccu_nm pll_peri_parent_clk = {
+	.output		= BIT(27),
+	.enable		= BIT(31),
+	.lock		= BIT(28),
+	.lock_enable	= BIT(29),
+	.ldo_en		= BIT(30),
+	.n		= _SUNXI_CCU_MULT_OFFSET_MIN_MAX(8, 8, 1, 84, 134),
+	.min_rate	= 2016000000U,
+	.max_rate	= 3216000000U,
+	.fixed_post_div = 5,
+	.fixed_pre_div = 2,
+	.common		= {
+		.reg		= SUN300I_V821_PLL_PERI_CTRL_REG,
+		.features	= CCU_FEATURE_FIXED_POSTDIV |
+				  CCU_FEATURE_FIXED_PREDIV,
+		.hw.init	= CLK_HW_INIT("pll-peri-parent", "dcxo",
+					      &ccu_nm_ops,
+					      CLK_SET_RATE_UNGATE | CLK_IGNORE_UNUSED),
+	},
+};
+
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_1536_clk, "pll-peri-cko-1536m",
+			   &pll_peri_parent_clk.common.hw, 2, 1, 0);
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_1024_clk, "pll-peri-cko-1024m",
+			   &pll_peri_parent_clk.common.hw, 3, 1, 0);
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_768_clk, "pll-peri-cko-768m",
+			   &pll_peri_parent_clk.common.hw, 4, 1, 0);
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_614_clk, "pll-peri-cko-614m",
+			   &pll_peri_parent_clk.common.hw, 5, 1, 0);
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_512_clk, "pll-peri-cko-512m",
+			   &pll_peri_parent_clk.common.hw, 6, 1, 0);
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_384_clk, "pll-peri-cko-384m",
+			   &pll_peri_parent_clk.common.hw, 8, 1, 0);
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_341_clk, "pll-peri-cko-341m",
+			   &pll_peri_parent_clk.common.hw, 9, 1, 0);
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_307_clk, "pll-peri-cko-307m",
+			   &pll_peri_parent_clk.common.hw, 10, 1, 0);
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_236_clk, "pll-peri-cko-236m",
+			   &pll_peri_parent_clk.common.hw, 13, 1, 0);
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_219_clk, "pll-peri-cko-219m",
+			   &pll_peri_parent_clk.common.hw, 14, 1, 0);
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_192_clk, "pll-peri-cko-192m",
+			   &pll_peri_parent_clk.common.hw, 16, 1, 0);
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_118_clk, "pll-peri-cko-118m",
+			   &pll_peri_parent_clk.common.hw, 26, 1, 0);
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_96_clk, "pll-peri-cko-96m",
+			   &pll_peri_parent_clk.common.hw, 32, 1, 0);
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_48_clk, "pll-peri-cko-48m",
+			   &pll_peri_parent_clk.common.hw, 64, 1, 0);
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_24_clk, "pll-peri-cko-24m",
+			   &pll_peri_parent_clk.common.hw, 128, 1, 0);
+static CLK_FIXED_FACTOR_HW(pll_peri_cko_12_clk, "pll-peri-cko-12m",
+			   &pll_peri_parent_clk.common.hw, 256, 1, 0);
+
+/*
+ * Register PLL-DDR for visibility, but keep it critical and do not request
+ * rate propagation from consumers.  Generic ccu_nm cannot model vendor SDM,
+ * so this clock must not be changed while Linux is running from DRAM.
+ */
+static struct ccu_nm pll_ddr_clk = {
+	.enable		= BIT(31),
+	.lock		= BIT(28),
+	.n		= _SUNXI_CCU_MULT_OFFSET_MIN_MAX(8, 8, 1, 12, 71),
+	.m		= _SUNXI_CCU_DIV(0, 1),
+	.min_rate	= 312000000,
+	.max_rate	= 2000000000U,
+	.common		= {
+		.reg		= SUN300I_V821_PLL_DDR_CTRL_REG,
+		.hw.init	= CLK_HW_INIT("pll-ddr", "dcxo",
+					      &ccu_nm_ops,
+					      CLK_IS_CRITICAL),
+	},
+};
+
+static const char * const dcxo_parents[] = {
+	"dcxo40M", "dcxo24M"
+};
+
+static SUNXI_CCU_MUX(dcxo_clk, "dcxo", dcxo_parents,
+		     SUN300I_V821_DCXO_STATUS_REG, 31, 1,
+		     CLK_IS_CRITICAL);
+
+static const char * const ahb_parents[] = {
+	"dcxo", "pll-peri-cko-768m", "rc-1m"
+};
+
+static SUNXI_CCU_M_WITH_MUX(ahb_clk, "ahb", ahb_parents,
+			    SUN300I_V821_AHB_CFG_REG,
+			    0, 5, 24, 2,
+			    CLK_SET_RATE_PARENT | CLK_IS_CRITICAL);
+
+static const char * const apb_parents[] = {
+	"dcxo", "pll-peri-cko-384m", "rc-1m"
+};
+
+static SUNXI_CCU_M_WITH_MUX(apb_clk, "apb", apb_parents,
+			    SUN300I_V821_APB_CFG_REG,
+			    0, 5, 24, 2,
+			    CLK_SET_RATE_PARENT | CLK_IS_CRITICAL);
+
+static const char * const rtc_apb_parents[] = {
+	"rc-1m", "pll-peri-cko-96m", "dcxo"
+};
+
+static SUNXI_CCU_M_WITH_MUX(rtc_apb_clk, "rtc-apb", rtc_apb_parents,
+			    0x0508, 0, 5, 24, 2,
+			    CLK_SET_RATE_PARENT);
+
+static SUNXI_CCU_GATE(pwrctrl_bus_clk, "pwrctrl", "dcxo",
+		      0x0550, BIT(6), CLK_IGNORE_UNUSED);
+static SUNXI_CCU_GATE(tccal_bus_clk, "tccal", "dcxo",
+		      0x0550, BIT(2), 0);
+
+static const char * const apb_spc_parents[] = {
+	"dcxo", "", "rc-1m", "pll-peri-cko-192m"
+};
+
+static SUNXI_CCU_M_WITH_MUX(apb_spc_clk, "apb-spc", apb_spc_parents,
+			    0x0580, 0, 5, 24, 2,
+			    CLK_SET_RATE_PARENT);
+
+static const char * const e907_parents[] = {
+	"dcxo", "pll-peri-cko-614m", "rc-1m", "rc-1m",
+	"pll-cpu", "pll-peri-cko-1024m",
+	"pll-peri-cko-614m", "pll-peri-cko-614m"
+};
+
+static SUNXI_CCU_M_WITH_MUX(e907_clk, "e907", e907_parents,
+			    0x0584, 0, 5, 24, 3,
+			    CLK_SET_RATE_NO_REPARENT);
+
+static const char * const a27l2_parents[] = {
+	"dcxo", "", "rc-1m", "rc-1m", "pll-cpu",
+	"pll-peri-cko-1024m", "pll-peri-cko-768m",
+	"pll-peri-cko-768m"
+};
+
+static SUNXI_CCU_M_WITH_MUX_GATE(a27l2_clk, "a27l2", a27l2_parents,
+				 SUN300I_V821_A27L2_CFG_REG,
+				 0, 5, 24, 3, BIT(31),
+				 CLK_IGNORE_UNUSED |
+				 CLK_SET_RATE_PARENT |
+				 CLK_SET_RATE_NO_REPARENT);
+
+static struct ccu_reset_map sun300i_v821_r_ccu_resets[] = {
+	[RST_BUS_WLAN] = { 0x0518, BIT(0) },
+};
+
+static struct clk_hw_onecell_data sun300i_v821_r_hw_clks = {
+	.hws = {
+		[CLK_PLL_CPU]			= &pll_cpu_clk.common.hw,
+		[CLK_PLL_DDR]			= &pll_ddr_clk.common.hw,
+		[CLK_PLL_PERI_PARENT]		= &pll_peri_parent_clk.common.hw,
+		[CLK_PLL_PERI_CKO_1536M]	= &pll_peri_cko_1536_clk.hw,
+		[CLK_PLL_PERI_CKO_1024M]	= &pll_peri_cko_1024_clk.hw,
+		[CLK_PLL_PERI_CKO_768M]		= &pll_peri_cko_768_clk.hw,
+		[CLK_PLL_PERI_CKO_614M]		= &pll_peri_cko_614_clk.hw,
+		[CLK_PLL_PERI_CKO_512M]		= &pll_peri_cko_512_clk.hw,
+		[CLK_PLL_PERI_CKO_384M]		= &pll_peri_cko_384_clk.hw,
+		[CLK_PLL_PERI_CKO_341M]		= &pll_peri_cko_341_clk.hw,
+		[CLK_PLL_PERI_CKO_307M]		= &pll_peri_cko_307_clk.hw,
+		[CLK_PLL_PERI_CKO_236M]		= &pll_peri_cko_236_clk.hw,
+		[CLK_PLL_PERI_CKO_219M]		= &pll_peri_cko_219_clk.hw,
+		[CLK_PLL_PERI_CKO_192M]		= &pll_peri_cko_192_clk.hw,
+		[CLK_PLL_PERI_CKO_118M]		= &pll_peri_cko_118_clk.hw,
+		[CLK_PLL_PERI_CKO_96M]		= &pll_peri_cko_96_clk.hw,
+		[CLK_PLL_PERI_CKO_48M]		= &pll_peri_cko_48_clk.hw,
+		[CLK_PLL_PERI_CKO_24M]		= &pll_peri_cko_24_clk.hw,
+		[CLK_PLL_PERI_CKO_12M]		= &pll_peri_cko_12_clk.hw,
+		[CLK_DCXO]			= &dcxo_clk.common.hw,
+		[CLK_AHB]			= &ahb_clk.common.hw,
+		[CLK_APB0]			= &apb_clk.common.hw,
+		[CLK_RTC_APB]			= &rtc_apb_clk.common.hw,
+		[CLK_PWRCTRL]			= &pwrctrl_bus_clk.common.hw,
+		[CLK_TCCAL]			= &tccal_bus_clk.common.hw,
+		[CLK_APB_SPC]			= &apb_spc_clk.common.hw,
+		[CLK_E907]			= &e907_clk.common.hw,
+		[CLK_A27L2]			= &a27l2_clk.common.hw,
+	},
+	.num = CLK_NUMBER,
+};
+
+static struct ccu_common *sun300i_v821_r_ccu_clks[] = {
+	&pll_cpu_clk.common,
+	&pll_peri_parent_clk.common,
+	&pll_ddr_clk.common,
+	&dcxo_clk.common,
+	&ahb_clk.common,
+	&apb_clk.common,
+	&rtc_apb_clk.common,
+	&pwrctrl_bus_clk.common,
+	&tccal_bus_clk.common,
+	&apb_spc_clk.common,
+	&e907_clk.common,
+	&a27l2_clk.common,
+};
+
+static const struct sunxi_ccu_desc sun300i_v821_r_ccu_desc = {
+	.ccu_clks	= sun300i_v821_r_ccu_clks,
+	.num_ccu_clks	= ARRAY_SIZE(sun300i_v821_r_ccu_clks),
+	.hw_clks	= &sun300i_v821_r_hw_clks,
+	.resets		= sun300i_v821_r_ccu_resets,
+	.num_resets	= ARRAY_SIZE(sun300i_v821_r_ccu_resets),
+};
+
+/*
+ * Match the vendor post-rate reset: toggle the PLL output at BIT(27), not the
+ * master enable at BIT(31).  ccu_nm separately gates BIT(27) while factors are
+ * being programmed and waits for lock before restoring it.
+ */
+static struct ccu_pll_nb sun300i_v821_pll_cpu_nb = {
+	.common	= &pll_cpu_clk.common,
+	.enable	= BIT(27),
+	.lock	= BIT(28),
+};
+
+static struct ccu_mux_nb sun300i_v821_a27_cpu_nb = {
+	.common		= &a27l2_clk.common,
+	.cm		= &a27l2_clk.mux,
+	.delay_us	= 1,
+	.bypass_index	= 6,
+};
+
+static void __init sun300i_v821_init_pll_limits(bool v821b, bool dcxo24m)
+{
+	if (dcxo24m) {
+		pll_cpu_clk.fixed_post_div = 1;
+		pll_peri_parent_clk.fixed_post_div = 3;
+		pll_cpu_clk.n.min = v821b ? 20 : 14;
+		pll_cpu_clk.n.max = v821b ? 54 : 50;
+		pll_cpu_clk.min_rate = v821b ? 480000000 : 336000000;
+		pll_cpu_clk.max_rate = v821b ? 1296000000 : 1200000000;
+	} else {
+		pll_cpu_clk.fixed_post_div = 2;
+		pll_peri_parent_clk.fixed_post_div = 5;
+		pll_cpu_clk.n.min = v821b ? 24 : 16;
+		pll_cpu_clk.n.max = v821b ? 64 : 60;
+		pll_cpu_clk.min_rate = v821b ? 960000000 : 640000000;
+		pll_cpu_clk.max_rate = v821b ? 2560000000U : 2400000000U;
+	}
+}
+
+static void __init sun300i_v821_r_ccu_setup(struct device_node *node)
+{
+	void __iomem *reg;
+	u32 dcxo_status;
+	u32 val;
+	bool v821b;
+
+	reg = of_io_request_and_map(node, 0, of_node_full_name(node));
+	if (IS_ERR(reg)) {
+		pr_err("%pOF: could not map R CCU registers\n", node);
+		return;
+	}
+
+	dcxo_status = readl(reg + SUN300I_V821_DCXO_STATUS_REG);
+	v821b = of_device_is_compatible(node,
+					"allwinner,sun300i-v821b-r-ccu");
+	sun300i_v821_init_pll_limits(v821b, dcxo_status & BIT(31));
+
+	/* Keep all CKO gates enabled until they are modeled individually. */
+	val = readl(reg + SUN300I_V821_PLL_PERI_CTRL1_REG);
+	val |= GENMASK(15, 0);
+	writel(val, reg + SUN300I_V821_PLL_PERI_CTRL1_REG);
+
+	of_sunxi_ccu_probe(node, reg, &sun300i_v821_r_ccu_desc);
+
+	ccu_pll_notifier_register(&sun300i_v821_pll_cpu_nb);
+	ccu_mux_notifier_register(pll_cpu_clk.common.hw.clk,
+				  &sun300i_v821_a27_cpu_nb);
+}
+
+CLK_OF_DECLARE(sun300i_v821_r_ccu, "allwinner,sun300i-v821-r-ccu",
+	       sun300i_v821_r_ccu_setup);
+CLK_OF_DECLARE(sun300i_v821b_r_ccu, "allwinner,sun300i-v821b-r-ccu",
+	       sun300i_v821_r_ccu_setup);
+
+MODULE_DESCRIPTION("Allwinner sun300i-v821 R clock driver");
+MODULE_LICENSE("GPL");
