+static const struct ccu_reset_map sun300i_v821_ccu_resets[] = {
+	[RST_BUS_USBPHY]	= { 0x0090, BIT(23) },
+	[RST_BUS_USBOHCI]	= { 0x0090, BIT(22) },
+	[RST_BUS_USBEHCI]	= { 0x0090, BIT(21) },
+	[RST_BUS_USBOTG]	= { 0x0090, BIT(20) },
+	[RST_BUS_USB]		= { 0x0090, BIT(19) },
+	[RST_BUS_UART3]		= { 0x0090, BIT(18) },
+	[RST_BUS_UART2]		= { 0x0090, BIT(17) },
+	[RST_BUS_UART1]		= { 0x0090, BIT(16) },
+	[RST_BUS_UART0]		= { 0x0090, BIT(15) },
+	[RST_BUS_TWI0]		= { 0x0090, BIT(14) },
+	[RST_BUS_TRNG]		= { 0x0090, BIT(11) },
+	[RST_BUS_SGDMA]	= { 0x0090, BIT(9) },
+	[RST_BUS_CE]		= { 0x0090, BIT(6) },
+	[RST_BUS_HSTIMER]	= { 0x0090, BIT(5) },
+	[RST_BUS_SPI]		= { 0x0094, BIT(4) },
+	[RST_BUS_SPIF]		= { 0x0094, BIT(5) },
+	[RST_BUS_TWI2]		= { 0x0094, BIT(25) },
+	[RST_BUS_TWI1]		= { 0x0094, BIT(24) },
+	[RST_BUS_SMHC1]		= { 0x0094, BIT(21) },
+	[RST_BUS_SMHC0]		= { 0x0094, BIT(20) },
+};
+
+static const struct sunxi_ccu_desc sun300i_v821_ccu_desc = {
+	.ccu_clks	= sun300i_v821_ccu_clks,
+	.num_ccu_clks	= ARRAY_SIZE(sun300i_v821_ccu_clks),
+
+	.hw_clks	= &sun300i_v821_hw_clks,
+
+	.resets		= sun300i_v821_ccu_resets,
+	.num_resets	= ARRAY_SIZE(sun300i_v821_ccu_resets),
+};
+
+static void __init sun300i_v821_ccu_setup(struct device_node *node)
+{
+	void __iomem *reg;
+
+	reg = of_io_request_and_map(node, 0, of_node_full_name(node));
+	if (IS_ERR(reg)) {
+		pr_err("%pOF: Could not map the clock registers\n", node);
+		return;
+	}
+
+	of_sunxi_ccu_probe(node, reg, &sun300i_v821_ccu_desc);
+}
+CLK_OF_DECLARE(sun300i_v821_ccu, "allwinner,sun300i-v821-ccu",
+	       sun300i_v821_ccu_setup);
+
+MODULE_IMPORT_NS("SUNXI_CCU");
+MODULE_DESCRIPTION("Support for the Allwinner sun300i-v821 CCU");
+MODULE_LICENSE("GPL");
