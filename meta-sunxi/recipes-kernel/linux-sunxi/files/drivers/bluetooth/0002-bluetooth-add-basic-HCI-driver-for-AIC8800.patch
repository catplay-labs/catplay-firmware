Subject: [PATCH] bluetooth: add basic HCI driver for AIC8800
Upstream-Status: Pending


It's similar in functionality to legacy `hciattach`-based userspace variant.
Note that the module currently **HAS TO** be loaded after AIC8800 Wi-Fi driver is loaded
which initializes Wi-Fi+Bluetooth firmware as a single process
(unlike most radio chips where Bluetooth firmware patching takes place over Bluetooth's HCI UART).

If you load it earlier, the kernel Bluetooth subsystem will try sending HCI reset, observe a timeout and silently
remove the device forever (WTF?).

diff --git a/drivers/bluetooth/Kconfig b/drivers/bluetooth/Kconfig
index 18767b54d..fb8a55719 100644
--- a/drivers/bluetooth/Kconfig
+++ b/drivers/bluetooth/Kconfig
@@ -286,6 +286,20 @@ config BT_HCIUART_AML
 
 	  Say Y here to compile support for HCI AML protocol.
 
+config BT_HCIUART_AIC
+	bool "AIC protocol support"
+	depends on BT_HCIUART
+	depends on BT_HCIUART_SERDEV
+	select BT_HCIUART_H4
+	help
+	  AIC protocol support enables Bluetooth HCI over serial port
+	  interface for AIC Bluetooth controllers.
+
+	  This is a minimal H4-like implementation intended to behave
+	  similarly to hciattach, without ACPI/platform specific setup.
+
+	  Say Y here to compile support for HCI AIC protocol.
+
 config BT_HCIBCM203X
 	tristate "HCI BCM203x USB driver"
 	depends on USB
diff --git a/drivers/bluetooth/Makefile b/drivers/bluetooth/Makefile
index 81856512d..b0a065220 100644
--- a/drivers/bluetooth/Makefile
+++ b/drivers/bluetooth/Makefile
@@ -52,4 +52,5 @@ hci_uart-$(CONFIG_BT_HCIUART_QCA)	+= hci_qca.o
 hci_uart-$(CONFIG_BT_HCIUART_AG6XX)	+= hci_ag6xx.o
 hci_uart-$(CONFIG_BT_HCIUART_MRVL)	+= hci_mrvl.o
 hci_uart-$(CONFIG_BT_HCIUART_AML)	+= hci_aml.o
+hci_uart-$(CONFIG_BT_HCIUART_AIC)	+= hci_aic.o
 hci_uart-objs				:= $(hci_uart-y)
diff --git a/drivers/bluetooth/hci_aic.c b/drivers/bluetooth/hci_aic.c
new file mode 100644
index 000000000..6393d5d9a
--- /dev/null
+++ b/drivers/bluetooth/hci_aic.c
@@ -0,0 +1,228 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Bluetooth HCI UART AIC driver
+ *
+ * Minimal H4-like transport meant to behave like hciattach:
+ * no ACPI/platform power management and no vendor-specific HCI setup.
+ */
+
+#include <linux/module.h>
+
+#include <linux/errno.h>
+#include <linux/of.h>
+#include <linux/serdev.h>
+#include <linux/skbuff.h>
+#include <linux/slab.h>
+
+#include <net/bluetooth/bluetooth.h>
+#include <net/bluetooth/hci_core.h>
+
+#include "hci_uart.h"
+
+struct aic_device {
+	struct hci_uart hu;
+	bool flow_control;
+};
+
+struct aic_data {
+	struct sk_buff *rx_skb;
+	struct sk_buff_head txq;
+};
+
+static int aic_open(struct hci_uart *hu)
+{
+	struct aic_data *aic;
+
+	BT_DBG("hu %p", hu);
+
+	aic = kzalloc(sizeof(*aic), GFP_KERNEL);
+	if (!aic)
+		return -ENOMEM;
+
+	skb_queue_head_init(&aic->txq);
+	hu->priv = aic;
+
+	return 0;
+}
+
+static int aic_close(struct hci_uart *hu)
+{
+	struct aic_data *aic = hu->priv;
+
+	BT_DBG("hu %p", hu);
+
+	skb_queue_purge(&aic->txq);
+	kfree_skb(aic->rx_skb);
+
+	hu->priv = NULL;
+	kfree(aic);
+
+	return 0;
+}
+
+static int aic_flush(struct hci_uart *hu)
+{
+	struct aic_data *aic = hu->priv;
+
+	BT_DBG("hu %p", hu);
+	skb_queue_purge(&aic->txq);
+
+	return 0;
+}
+
+static int aic_setup(struct hci_uart *hu)
+{
+	struct aic_device *aicdev;
+
+	if (!hu->serdev)
+		return 0;
+
+	aicdev = serdev_device_get_drvdata(hu->serdev);
+	serdev_device_set_flow_control(hu->serdev, aicdev->flow_control);
+
+	return 0;
+}
+
+static int aic_enqueue(struct hci_uart *hu, struct sk_buff *skb)
+{
+	struct aic_data *aic = hu->priv;
+
+	BT_DBG("hu %p skb %p", hu, skb);
+
+	memcpy(skb_push(skb, 1), &hci_skb_pkt_type(skb), 1);
+	skb_queue_tail(&aic->txq, skb);
+
+	return 0;
+}
+
+static struct sk_buff *aic_dequeue(struct hci_uart *hu)
+{
+	struct aic_data *aic = hu->priv;
+
+	return skb_dequeue(&aic->txq);
+}
+
+static const struct h4_recv_pkt aic_recv_pkts[] = {
+	{ H4_RECV_ACL,   .recv = hci_recv_frame },
+	{ H4_RECV_SCO,   .recv = hci_recv_frame },
+	{ H4_RECV_EVENT, .recv = hci_recv_frame },
+	{ H4_RECV_ISO,   .recv = hci_recv_frame },
+};
+
+static int aic_recv(struct hci_uart *hu, const void *data, int count)
+{
+	struct aic_data *aic = hu->priv;
+
+	if (!test_bit(HCI_UART_REGISTERED, &hu->flags))
+		return -EUNATCH;
+
+	aic->rx_skb = h4_recv_buf(hu, aic->rx_skb, data, count,
+				  aic_recv_pkts, ARRAY_SIZE(aic_recv_pkts));
+	if (IS_ERR(aic->rx_skb)) {
+		int err = PTR_ERR(aic->rx_skb);
+
+		bt_dev_err(hu->hdev, "Frame reassembly failed (%d)", err);
+		aic->rx_skb = NULL;
+		return err;
+	}
+
+	return count;
+}
+
+static const struct hci_uart_proto aic_proto = {
+	.id         = HCI_UART_AIC,
+	.name       = "AIC",
+	.setup      = aic_setup,
+	.open       = aic_open,
+	.close      = aic_close,
+	.flush      = aic_flush,
+	.recv       = aic_recv,
+	.enqueue    = aic_enqueue,
+	.dequeue    = aic_dequeue,
+};
+
+#if IS_ENABLED(CONFIG_SERIAL_DEV_BUS)
+static int aic_serdev_probe(struct serdev_device *serdev)
+{
+	struct aic_device *aicdev;
+	struct hci_uart *hu;
+	struct device_node *np = serdev->dev.of_node;
+	struct device_node *parent_np = NULL;
+	u32 speed = 1500000;
+
+	aicdev = devm_kzalloc(&serdev->dev, sizeof(*aicdev), GFP_KERNEL);
+	if (!aicdev)
+		return -ENOMEM;
+
+	hu = &aicdev->hu;
+	hu->serdev = serdev;
+	serdev_device_set_drvdata(serdev, aicdev);
+
+	if (serdev->ctrl && serdev->ctrl->dev.of_node)
+		parent_np = serdev->ctrl->dev.of_node;
+	else if (serdev->dev.parent)
+		parent_np = serdev->dev.parent->of_node;
+
+	aicdev->flow_control = of_property_read_bool(np, "flow-control") ||
+			       of_property_read_bool(np, "uart-has-rtscts") ||
+			       of_property_read_bool(parent_np, "uart-has-rtscts");
+	dev_info(&serdev->dev, "AIC UART flow control: %s\n",
+		 aicdev->flow_control ? "on" : "off");
+
+	of_property_read_u32(np, "max-speed", &speed);
+	of_property_read_u32(np, "speed", &speed);
+	hci_uart_set_speeds(hu, speed, speed);
+	dev_info(&serdev->dev, "AIC UART speed: %u\n", speed);
+
+	return hci_uart_register_device(hu, &aic_proto);
+}
+
+static void aic_serdev_remove(struct serdev_device *serdev)
+{
+	struct aic_device *aicdev = serdev_device_get_drvdata(serdev);
+
+	hci_uart_unregister_device(&aicdev->hu);
+}
+
+static const struct of_device_id aic_bluetooth_of_match[] = {
+	{ .compatible = "aic,aic-bt" },
+	{},
+};
+MODULE_DEVICE_TABLE(of, aic_bluetooth_of_match);
+
+static struct serdev_device_driver aic_serdev_driver = {
+	.probe = aic_serdev_probe,
+	.remove = aic_serdev_remove,
+	.driver = {
+		.name = "hci_uart_aic",
+		.of_match_table = of_match_ptr(aic_bluetooth_of_match),
+	},
+};
+#else
+static struct serdev_device_driver aic_serdev_driver;
+#endif
+
+int __init aic_init(void)
+{
+	int err;
+
+	err = serdev_device_driver_register(&aic_serdev_driver);
+	if (err)
+		return err;
+
+	err = hci_uart_register_proto(&aic_proto);
+	if (err)
+		serdev_device_driver_unregister(&aic_serdev_driver);
+
+	return err;
+}
+
+int __exit aic_deinit(void)
+{
+	serdev_device_driver_unregister(&aic_serdev_driver);
+
+	return hci_uart_unregister_proto(&aic_proto);
+}
+
+MODULE_DESCRIPTION("Bluetooth HCI UART AIC driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/bluetooth/hci_ldisc.c b/drivers/bluetooth/hci_ldisc.c
index 2f322f890..62c4ff7a2 100644
--- a/drivers/bluetooth/hci_ldisc.c
+++ b/drivers/bluetooth/hci_ldisc.c
@@ -884,6 +884,9 @@ static int __init hci_uart_init(void)
 #endif
 #ifdef CONFIG_BT_HCIUART_AML
 	aml_init();
+#endif
+#ifdef CONFIG_BT_HCIUART_AIC
+	aic_init();
 #endif
 	return 0;
 }
@@ -922,6 +925,9 @@ static void __exit hci_uart_exit(void)
 #endif
 #ifdef CONFIG_BT_HCIUART_AML
 	aml_deinit();
+#endif
+#ifdef CONFIG_BT_HCIUART_AIC
+	aic_deinit();
 #endif
 	tty_unregister_ldisc(&hci_uart_ldisc);
 }
diff --git a/drivers/bluetooth/hci_uart.h b/drivers/bluetooth/hci_uart.h
index 5ea5dd80e..7a8970b22 100644
--- a/drivers/bluetooth/hci_uart.h
+++ b/drivers/bluetooth/hci_uart.h
@@ -20,7 +20,7 @@
 #define HCIUARTGETFLAGS		_IOR('U', 204, int)
 
 /* UART protocols */
-#define HCI_UART_MAX_PROTO	13
+#define HCI_UART_MAX_PROTO	14
 
 #define HCI_UART_H4	0
 #define HCI_UART_BCSP	1
@@ -35,6 +35,7 @@
 #define HCI_UART_NOKIA	10
 #define HCI_UART_MRVL	11
 #define HCI_UART_AML	12
+#define HCI_UART_AIC	13
 
 #define HCI_UART_RAW_DEVICE	0
 #define HCI_UART_RESET_ON_INIT	1
@@ -216,3 +217,8 @@ int mrvl_deinit(void);
 int aml_init(void);
 int aml_deinit(void);
 #endif
+
+#ifdef CONFIG_BT_HCIUART_AIC
+int aic_init(void);
+int aic_deinit(void);
+#endif
