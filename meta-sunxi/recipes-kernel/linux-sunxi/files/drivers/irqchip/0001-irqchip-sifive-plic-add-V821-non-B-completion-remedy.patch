Subject: [PATCH] irqchip/sifive-plic: scope Allwinner completion remedy to V821 non-B

Upstream-Status: Pending

Port the vendor's enabled-and-not-pending completion retry to the current
PLIC driver. Detect the actual PRCM silicon revision instead of relying on
the board name, and keep V821B and other platforms unchanged.

Use per-context pinned hard timers, a bounded source scan, enable locking
and active-IRQ tracking so that the remedy cannot prematurely complete a
normal or threaded interrupt. Start after timer initialization and cancel
on CPU offline. Keep the independent SBI clockevent preferred on non-B;
otherwise a lost HSTIMER interrupt could also stop the remedy itself.

diff --git a/include/linux/soc/sunxi/v821.h b/include/linux/soc/sunxi/v821.h
new file mode 100644
--- /dev/null
+++ b/include/linux/soc/sunxi/v821.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_SOC_SUNXI_V821_H
+#define _LINUX_SOC_SUNXI_V821_H
+
+#include <linux/errno.h>
+#include <linux/io.h>
+#include <linux/of_address.h>
+
+#define SUNXI_V821_CHIP_VERSION_REG	0x40
+#define SUNXI_V821_CHIP_VERSION_NON_B	0x2
+
+/* Brandy classifies PRCM ROM version 2 as V821, all other values as V821B. */
+static inline int sunxi_v821_is_non_b(void)
+{
+	struct device_node *np;
+	void __iomem *prcm;
+	u32 version;
+
+	if (!IS_ENABLED(CONFIG_ARCH_SUNXI_SUN300I))
+		return 0;
+
+	np = of_find_compatible_node(NULL, NULL, "allwinner,sun300i-v821-prcm");
+	if (!np)
+		return 0;
+	prcm = of_iomap(np, 0);
+	of_node_put(np);
+	if (!prcm)
+		return -ENOMEM;
+
+	version = readl(prcm + SUNXI_V821_CHIP_VERSION_REG);
+	iounmap(prcm);
+	return version == SUNXI_V821_CHIP_VERSION_NON_B;
+}
+
+#endif
