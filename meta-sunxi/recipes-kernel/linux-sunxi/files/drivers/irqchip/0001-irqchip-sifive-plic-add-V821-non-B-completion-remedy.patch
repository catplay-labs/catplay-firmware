@@ -104,6 +113,101 @@
 static DEFINE_PER_CPU(struct plic_handler, plic_handlers);
 
 static int plic_irq_set_type(struct irq_data *d, unsigned int type);
+
+static void plic_v821_active(struct plic_handler *handler, unsigned int hwirq, bool active)
+{
+#ifdef CONFIG_ARCH_SUNXI_SUN300I
+	if (!test_bit(PLIC_QUIRK_V821_COMPLETION, &handler->priv->plic_quirks) ||
+	    hwirq > MAX_DEVICES)
+		return;
+
+	if (active)
+		set_bit(hwirq, handler->active_irqs);
+	else
+		clear_bit(hwirq, handler->active_irqs);
+#endif
+}
+
+#ifdef CONFIG_ARCH_SUNXI_SUN300I
+/* Allwinner's non-B remedy: retry completion for enabled, non-pending IRQs. */
+static enum hrtimer_restart plic_v821_remedy(struct hrtimer *timer)
+{
+	struct plic_handler *handler = container_of(timer, struct plic_handler, remedy_timer);
+	struct plic_priv *priv = handler->priv;
+	unsigned long flags;
+	unsigned int group;
+
+	/* Serialize against enable changes; local external IRQs cannot nest here. */
+	raw_spin_lock_irqsave(&handler->enable_lock, flags);
+	for (group = 0; group < priv->irq_groups; group++) {
+		u32 mask = readl(handler->enable_base + group * sizeof(u32)) &
+			   ~readl(priv->regs + PENDING_BASE + group * sizeof(u32));
+
+		while (mask) {
+			unsigned int hwirq = group * 32 + __ffs(mask);
+
+			mask &= mask - 1;
+			/* Never complete an IRQ still owned by a normal/threaded handler. */
+			if (hwirq && hwirq < ACCESS_PRIVATE(priv, total_irqs) &&
+			    !test_bit(hwirq, handler->active_irqs))
+				writel(hwirq, handler->hart_base + CONTEXT_CLAIM);
+		}
+	}
+	raw_spin_unlock_irqrestore(&handler->enable_lock, flags);
+
+	hrtimer_forward_now(timer, ns_to_ktime(V821_REMEDY_INTERVAL_NS));
+	return HRTIMER_RESTART;
+}
+
+static int plic_v821_remedy_online(unsigned int cpu)
+{
+	struct plic_handler *handler = per_cpu_ptr(&plic_handlers, cpu);
+
+	if (!handler->present ||
+	    !test_bit(PLIC_QUIRK_V821_COMPLETION, &handler->priv->plic_quirks))
+		return 0;
+
+	hrtimer_setup(&handler->remedy_timer, plic_v821_remedy, CLOCK_MONOTONIC,
+		      HRTIMER_MODE_REL_HARD);
+	hrtimer_start(&handler->remedy_timer, ns_to_ktime(V821_REMEDY_INTERVAL_NS),
+		      HRTIMER_MODE_REL_PINNED_HARD);
+	return 0;
+}
+
+static int plic_v821_remedy_offline(unsigned int cpu)
+{
+	struct plic_handler *handler = per_cpu_ptr(&plic_handlers, cpu);
+
+	if (handler->present &&
+	    test_bit(PLIC_QUIRK_V821_COMPLETION, &handler->priv->plic_quirks))
+		hrtimer_cancel(&handler->remedy_timer);
+	return 0;
+}
+
+static int __init plic_v821_remedy_init(void)
+{
+	int cpu, ret;
+
+	/* Timers are ready here; do not start one from early irqchip setup. */
+	for_each_possible_cpu(cpu) {
+		struct plic_handler *handler = per_cpu_ptr(&plic_handlers, cpu);
+
+		if (!handler->present ||
+		    !test_bit(PLIC_QUIRK_V821_COMPLETION, &handler->priv->plic_quirks))
+			continue;
+
+		ret = cpuhp_setup_state(CPUHP_AP_ONLINE_DYN, "irqchip/v821:remedy",
+					plic_v821_remedy_online, plic_v821_remedy_offline);
+		if (ret < 0)
+			return ret;
+		pr_info("V821 non-B: enabled 1 ms PLIC completion remedy\n");
+		break;
+	}
+	return 0;
+}
+late_initcall(plic_v821_remedy_init);
+#endif
+
 
