Subject: [PATCH] pinctrl: ingenic: use X1600 hardware edge interrupt handling
Upstream-Status: Pending

Program PAT1 for edge-triggered X1600 GPIO interrupts and update the EDG
bit when loading shadow registers. Use hardware both-edge support on
X1600 rather than emulating it by toggling polarity after each interrupt.

diff --git a/drivers/pinctrl/pinctrl-ingenic.c b/drivers/pinctrl/pinctrl-ingenic.c
index 1aa6a6dc12095e0c99827a6b4792188bfddecdde..1ed293e9f3c89759240f9a27b7ec748e0c899bca 100644
--- a/drivers/pinctrl/pinctrl-ingenic.c
+++ b/drivers/pinctrl/pinctrl-ingenic.c
@@ -2458,6 +2458,8 @@ static int x1600_mac_pins[] = {
 
 static int x1600_sfc_funcs[] = { 0, 0, 0, 0, 0, 0, 2, };
 
+// static int x1600_otg_pins[] = { 0x8a, };
+
 static const struct group_desc x1600_groups[] = {
 	INGENIC_PIN_GROUP("uart0-data", x1600_uart0_data, 0),
 	INGENIC_PIN_GROUP("uart0-hwflow", x1600_uart0_hwflow, 0),
@@ -3616,6 +3618,13 @@ static void irq_set_type(struct ingenic_gpio_chip *jzgc,
 		break;
 	}
 
+	if (is_soc_or_above(jzgc->jzpc, ID_X2000) ||
+	    ((is_soc_or_above(jzgc->jzpc, ID_X1600) && !is_soc_or_above(jzgc->jzpc, ID_X1830)))) {
+		if (type == IRQ_TYPE_EDGE_BOTH || type == IRQ_TYPE_EDGE_RISING || type == IRQ_TYPE_EDGE_FALLING)
+			val2 = true; /* PAT1 must be 1 for all edge-triggered interrupts */
+		val3 = true;     /* EDG must be 1 for all interrupt types on these SoCs */
+	}
+
 	if (is_soc_or_above(jzgc->jzpc, ID_JZ4770)) {
 		reg1 = JZ4770_GPIO_PAT1;
 		reg2 = JZ4770_GPIO_PAT0;
@@ -3638,6 +3647,9 @@ static void irq_set_type(struct ingenic_gpio_chip *jzgc,
 		ingenic_gpio_shadow_set_bit(jzgc, reg2, offset, val1);
 		ingenic_gpio_shadow_set_bit(jzgc, reg1, offset, val2);
 		ingenic_gpio_shadow_set_bit_load(jzgc);
+
+		if (is_soc_or_above(jzgc->jzpc, ID_X1600) && !is_soc_or_above(jzgc->jzpc, ID_X1830))
+			ingenic_gpio_set_bit(jzgc, X2000_GPIO_EDG, offset, val3);
 	} else {
 		ingenic_gpio_set_bit(jzgc, reg2, offset, val1);
 		ingenic_gpio_set_bit(jzgc, reg1, offset, val2);
@@ -3712,7 +3724,8 @@ static void ingenic_gpio_irq_ack(struct irq_data *irqd)
 	bool high;
 
 	if ((irqd_get_trigger_type(irqd) == IRQ_TYPE_EDGE_BOTH) &&
-	    !is_soc_or_above(jzgc->jzpc, ID_X2000)) {
+	    (!is_soc_or_above(jzgc->jzpc, ID_X1600) ||
+	    (is_soc_or_above(jzgc->jzpc, ID_X1830) && !is_soc_or_above(jzgc->jzpc, ID_X2000)))) {
 		/*
 		 * Switch to an interrupt for the opposite edge to the one that
 		 * triggered the interrupt being ACKed.
@@ -3752,7 +3765,9 @@ static int ingenic_gpio_irq_set_type(struct irq_data *irqd, unsigned int type)
 		irq_set_handler_locked(irqd, handle_bad_irq);
 	}
 
-	if ((type == IRQ_TYPE_EDGE_BOTH) && !is_soc_or_above(jzgc->jzpc, ID_X2000)) {
+	if ((type == IRQ_TYPE_EDGE_BOTH) &&
+	    (!is_soc_or_above(jzgc->jzpc, ID_X1600) ||
+	    (is_soc_or_above(jzgc->jzpc, ID_X1830) && !is_soc_or_above(jzgc->jzpc, ID_X2000)))) {
 		/*
 		 * The hardware does not support interrupts on both edges. The
 		 * best we can do is to set up a single-edge interrupt and then
