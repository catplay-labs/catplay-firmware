+struct ingenic_intc *ingenic_intc;
+
+asmlinkage void plat_irq_dispatch(void)
 {
-	struct ingenic_intc_data *intc = irq_get_handler_data(irq);
-	struct irq_domain *domain = intc->domain;
-	struct irq_chip_generic *gc;
+	unsigned long pending = read_c0_cause() & read_c0_status() & ST0_IM;
+
+	if (!pending) {
+		spurious_interrupt();
+		return;
+	}
+
+	if (pending & CAUSEF_IP3)
+		do_IRQ(MIPS_CPU_IRQ_BASE + 3);
+	else if (pending & CAUSEF_IP4)
+		do_IRQ(MIPS_CPU_IRQ_BASE + 4);
+	else if (pending & CAUSEF_IP2)
+		do_IRQ(MIPS_CPU_IRQ_BASE + 2);
+	else
+		do_IRQ(MIPS_CPU_IRQ_BASE + __ffs(pending));
+}
+
+static irqreturn_t ingenic_intc_cascade(int irq, void *data)
+{
+	struct ingenic_intc *intc = ingenic_intc;
+	struct ingenic_intc_irqchip *irqchip = data;
 	uint32_t pending;
 	unsigned i;
 
-	for (i = 0; i < intc->num_chips; i++) {
-		gc = irq_get_domain_generic_chip(domain, i * 32);
-
-		pending = irq_reg_readl(gc, JZ_REG_INTC_PENDING);
+	for (i = 0; i < irqchip->num_chips; i++) {
+		pending = irq_reg_readl(irqchip->gc[i], JZ_REG_INTC_PENDING);
 		if (!pending)
 			continue;
 
 		while (pending) {
 			int bit = __fls(pending);
 
-			generic_handle_domain_irq(domain, bit + (i * 32));
+			irq = irq_find_mapping(intc->domain, bit + (i * 32));
+			generic_handle_irq(irq);
 			pending &= ~BIT(bit);
 		}
 	}
 
+	if (intc->version == ID_JZ4780)
+		IF_ENABLED(CONFIG_SMP, jz4780_smp_switch_irqcpu(smp_processor_id()));
+
 	return IRQ_HANDLED;
 }
 
