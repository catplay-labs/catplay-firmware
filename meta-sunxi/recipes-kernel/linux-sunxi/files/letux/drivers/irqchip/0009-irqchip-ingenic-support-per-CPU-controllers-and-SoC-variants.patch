-#define CHIP_SIZE		0x20
+struct ingenic_intc {
+	enum ingenic_intc_version version;
+	struct irq_domain *domain;
+	struct ingenic_intc_irqchip __percpu *irqchips;
 
-static irqreturn_t intc_cascade(int irq, void *data)
+	int irq;
