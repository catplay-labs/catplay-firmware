+/* #define INGENIC_DMA_REQ_I2S_RX       0x7 */
+/* #define INGENIC_DMA_REQ_SADC_RX      0x9 */
+
+/* #define INGENIC_DMA_REQ_MSC1_TX      0x1c */
+/* #define INGENIC_DMA_REQ_MSC1_RX      0x1d */
+/* #define INGENIC_DMA_REQ_MSC2_TX      0x1e */
