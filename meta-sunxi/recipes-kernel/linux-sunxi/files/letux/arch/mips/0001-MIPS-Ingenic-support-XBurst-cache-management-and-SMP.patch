+
+#define smp_clr_pending(mask) do {		\
+		unsigned int stat;				\
+		stat = read_c0_corestatus();	\
+		stat &= ~((mask) & 0xff);		\
+		write_c0_corestatus(stat);		\
+	} while (0)
+
