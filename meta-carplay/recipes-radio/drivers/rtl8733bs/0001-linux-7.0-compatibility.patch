Date: Mon, 3 Aug 2026 00:00:00 +0200
Subject: [PATCH] rtl8733bs: add Linux 7.x compatibility and bring-up logs

Adapt the vendor driver to interfaces and Kbuild changes present in Linux
7.x. Handle cfg80211 callback signature changes introduced from Linux 6.14
through 7.1. Add a guard and diagnostics for the zero-sized scan buffer
seen during V821 bring-up.

Upstream-Status: Inappropriate [vendor driver compatibility]
---
 Makefile                      |   7 ++
 core/crypto/sha256.c          |   6 +-
 core/crypto/sha256.h          |   4 +-
 core/rtw_br_ext.c             |  22 ++++---
 core/rtw_mlme.c               |   9 ++-
 include/osdep_service_linux.h |  19 ++++++
 os_dep/linux/ioctl_cfg80211.c | 116 +++++++++++++++++++++++++++++++---
 os_dep/linux/ioctl_linux.c    |   2 +-
 os_dep/linux/os_intfs.c       |   4 +-
 os_dep/linux/wifi_regd.c      |  26 ++++++--
 os_dep/osdep_service.c        |   4 +-
 11 files changed, 186 insertions(+), 33 deletions(-)

diff --git a/Makefile b/Makefile
index 361ec67..6e4c199 100644
--- a/Makefile
+++ b/Makefile
@@ -2726,6 +2726,13 @@ endif
 
 
 ############ ANDROID COMMON KERNEL ############
+# Kbuild 7.x no longer consumes this driver's legacy EXTRA_CFLAGS reliably.
+# Keep the generated driver defines and include paths in the supported flag
+# variable used by external modules.
+ccflags-y += $(EXTRA_CFLAGS)
+ccflags-y += -I$(src)/include -I$(src)/platform -I$(src)/core/crypto
+ccflags-y += -Wno-error=incompatible-pointer-types
+
 # Convert to absolute path
 ifneq ($(srctree),)
 _EXTRA_CFLAGS :=
diff --git a/core/crypto/sha256.c b/core/crypto/sha256.c
index ea5d9e3..d03b731 100755
--- a/core/crypto/sha256.c
+++ b/core/crypto/sha256.c
@@ -89,7 +89,7 @@ int hmac_sha256_vector(const u8 *key, size_t key_len, size_t num_elem,
 
 
 /**
- * hmac_sha256 - HMAC-SHA256 over data buffer (RFC 2104)
+ * rtw_hmac_sha256 - HMAC-SHA256 over data buffer (RFC 2104)
  * @key: Key for HMAC operations
  * @key_len: Length of the key in bytes
  * @data: Pointers to the data area
@@ -97,8 +97,8 @@ int hmac_sha256_vector(const u8 *key, size_t key_len, size_t num_elem,
  * @mac: Buffer for the hash (32 bytes)
  * Returns: 0 on success, -1 on failure
  */
-int hmac_sha256(const u8 *key, size_t key_len, const u8 *data,
-		size_t data_len, u8 *mac)
+int rtw_hmac_sha256(const u8 *key, size_t key_len, const u8 *data,
+			 size_t data_len, u8 *mac)
 {
 	return hmac_sha256_vector(key, key_len, 1, &data, &data_len, mac);
 }
